    <Item class="ModuleScript" referent="RBX50CC2AAE1758AB8FF6236BBB03174D92">
      <Properties>
        <string name="Name">OfflineEngine</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Offline engine: answers /chat requests inside Studio with no server.
--
-- It matches the request to one of the embedded, pre-verified tool responses
-- (OfflineData) by keyword and returns it in the same shape as the server's
-- /chat reply, so ActionPreview / ActionApplier work unchanged. It is a
-- keyword matcher over fixed outputs, not a neural model, and says so.

local HttpService = game:GetService("HttpService")

local OfflineData = require(script.Parent.OfflineData)

local OfflineEngine = {}

local ANIMATION_WORDS = { "animation", "animate", "anim", "emote", "keyframe" }

local function countMatches(text: string, words: { string }): number
	local n = 0
	for _, word in words do
		if string.find(text, word, 1, true) then
			n += 1
		end
	end
	return n
end

local function capabilities(): string
	local tools, anims = {}, {}
	for _, entry in OfflineData do
		if entry.animation then
			table.insert(anims, (string.gsub(entry.key, "^anim_", "")))
		else
			table.insert(tools, entry.key)
		end
	end
	return "**Offline mode** (no server needed) can build: " .. table.concat(tools, ", ")
		.. ".\n\nAnimations (R15): " .. table.concat(anims, ", ")
		.. ".\n\nTry: *build an obby*, *make a sprint animation*, *save player data*, *make an aw shucks emote*."
		.. "\n\nQuestions, code search and GODMODE's own neural model need the optional local server "
		.. "(type `/server on` after starting `python -m godmode.server`)."
end

export type Ranked = { entry: OfflineData.Entry, score: number }

-- Score every entry the same way `match` does (keywords x2, +1 when the
-- animation intent agrees), highest first; ties keep OfflineData order.
function OfflineEngine.rank(message: string): ({ Ranked }, boolean)
	local text = string.lower(message)
	local wantsAnimation = countMatches(text, ANIMATION_WORDS) > 0
	local ranked: { Ranked } = {}
	for index, entry in OfflineData do
		local score = countMatches(text, entry.keywords) * 2
		if score > 0 and entry.animation == wantsAnimation then
			score += 1
		end
		if score > 0 then
			table.insert(ranked, { entry = entry, score = score, index = index } :: any)
		end
	end
	table.sort(ranked, function(a: any, b: any): boolean
		if a.score ~= b.score then
			return a.score > b.score
		end
		return a.index < b.index
	end)
	return ranked, wantsAnimation
end

function OfflineEngine.match(message: string): OfflineData.Entry?
	local text = string.lower(message)
	local wantsAnimation = countMatches(text, ANIMATION_WORDS) > 0
	local best: OfflineData.Entry? = nil
	local bestScore = 0
	for _, entry in OfflineData do
		local score = countMatches(text, entry.keywords) * 2
		if score > 0 and entry.animation == wantsAnimation then
			score += 1
		end
		if score > bestScore then
			best, bestScore = entry, score
		end
	end
	return best
end

export type ThinkingStep = { label: string, detail: string, ms: number }

-- An honest trace of what the offline matcher actually did. The requested
-- thinking level is echoed back but changes nothing offline.
local function newTrace(level: string?)
	local started = os.clock()
	local last = started
	local steps: { ThinkingStep } = {}
	local function step(label: string, detail: string)
		local now = os.clock()
		table.insert(steps, { label = label, detail = detail, ms = math.floor((now - last) * 1000 + 0.5) })
		last = now
	end
	local function finish(): { [string]: any }
		return {
			level = level or "medium",
			summary = "Offline: thinking level has no effect without the server",
			elapsed_ms = math.floor((os.clock() - started) * 1000 + 0.5),
			steps = steps,
		}
	end
	return step, finish
end

local function topScores(ranked: { Ranked }): string
	if #ranked == 0 then
		return "no keyword matched"
	end
	local parts: { string } = {}
	for i = 1, math.min(3, #ranked) do
		table.insert(parts, ranked[i].entry.key .. "=" .. tostring(ranked[i].score))
	end
	return table.concat(parts, ", ")
end

function OfflineEngine.chat(request: { message: string, autonomy: number, thinking: string? }): { [string]: any }
	local step, finish = newTrace(request.thinking)
	step("Read request", tostring(#request.message) .. " characters")
	local ranked, wantsAnimation = OfflineEngine.rank(request.message)
	step("Detected intent", if wantsAnimation then "animation" else "build / script")
	step("Matched keywords", "top scores: " .. topScores(ranked))
	local entry = OfflineEngine.match(request.message)
	if entry == nil then
		step("No offline build matched", "listing what offline mode can build")
		return {
			reply_markdown = "I couldn't match that to an offline tool.\n\n" .. capabilities(),
			source = "offline:none",
			actions = {},
			verification = {},
			warnings = {},
			thinking = finish(),
		}
	end
	step("Picked offline build " .. entry.key, "highest keyword score")
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(entry.json)
	end)
	if not ok or typeof(decoded) ~= "table" then
		step("Decode failed", "embedded data for " .. entry.key .. " is invalid")
		return {
			reply_markdown = "Internal error: offline data for '" .. entry.key .. "' could not be decoded.",
			source = "offline:error",
			actions = {},
			verification = {},
			warnings = {},
			thinking = finish(),
		}
	end
	local response = decoded :: { [string]: any }
	local passed, total = 0, 0
	if typeof(response.verification) == "table" then
		for _, check in ipairs(response.verification) do
			if typeof(check) == "table" then
				total += 1
				if check.ok == true then
					passed += 1
				end
			end
		end
	end
	step(
		"Loaded pre-verified result (" .. tostring(passed) .. " checks passed)",
		tostring(passed) .. "/" .. tostring(total) .. " checks passed when the plugin was built"
	)
	if request.autonomy <= 1 then
		-- Assistant level: explain only, never propose changes.
		response.actions = {}
		response.reply_markdown = tostring(response.reply_markdown)
			.. "\n\n_Autonomy level 1 (Assistant): no changes proposed. Raise the level to get Apply buttons._"
		step("Applied autonomy 1", "removed proposed actions")
	end
	response.thinking = finish()
	return response
end

return OfflineEngine
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX710BB6D02EFDA1639BBF63882057C66D">
      <Properties>
        <string name="Name">PathResolver</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- PathResolver: converts protocol dot paths ("Workspace.Map.Door") to instances and back.
--
-- Security: only services on ALLOWED_SERVICES can be addressed. Anything else
-- (CoreGui, CorePackages, PluginGuiService, RobloxReplicatedStorage, ...) is refused,
-- so a server can never make the plugin touch Studio internals or other plugins.
-- Per docs/PLUGIN_PROTOCOL.md the first segment is resolved with game:GetService and
-- every following segment with FindFirstChild. Generated names never contain dots.

local PathResolver = {}

PathResolver.ALLOWED_SERVICES = {
	Workspace = true,
	ReplicatedStorage = true,
	ReplicatedFirst = true,
	ServerScriptService = true,
	ServerStorage = true,
	StarterGui = true,
	StarterPack = true,
	StarterPlayer = true,
	Lighting = true,
	SoundService = true,
	Teams = true,
	TextChatService = true,
	MaterialService = true,
} :: { [string]: boolean }

local MAX_SEGMENTS = 64
local MAX_NAME_LENGTH = 100

-- Split and validate a path. Returns the segments or an error message.
function PathResolver.split(path: any): ({ string }?, string?)
	if typeof(path) ~= "string" or path == "" then
		return nil, "path must be a non-empty string"
	end
	local text = path :: string
	if text:sub(1, 5) == "game." then
		text = text:sub(6)
	end
	local segments = string.split(text, ".")
	if #segments > MAX_SEGMENTS then
		return nil, "path is too deep: " .. path
	end
	for _, segment in ipairs(segments) do
		if segment == "" then
			return nil, "path has an empty segment: " .. path
		end
	end
	if not PathResolver.ALLOWED_SERVICES[segments[1]] then
		return nil, "refusing path outside the allowed game services: " .. path
	end
	return segments, nil
end

-- Validate a single instance name supplied by the server.
function PathResolver.validName(name: any): (boolean, string?)
	if typeof(name) ~= "string" or name == "" then
		return false, "name must be a non-empty string"
	end
	if #(name :: string) > MAX_NAME_LENGTH then
		return false, "name is longer than " .. tostring(MAX_NAME_LENGTH) .. " characters"
	end
	if (name :: string):find(".", 1, true) then
		return false, "name must not contain '.': " .. (name :: string)
	end
	return true, nil
end

local function getService(name: string): Instance?
	local ok, service = pcall(function()
		return game:GetService(name)
	end)
	if ok then
		return service
	end
	return nil
end

-- Resolve an existing instance. Never creates anything.
function PathResolver.resolve(path: any): (Instance?, string?)
	local segments, err = PathResolver.split(path)
	if segments == nil then
		return nil, err
	end
	local current = getService(segments[1])
	if current == nil then
		return nil, "unknown service: " .. segments[1]
	end
	for i = 2, #segments do
		local child = (current :: Instance):FindFirstChild(segments[i])
		if child == nil then
			return nil, "not found: '" .. segments[i] .. "' in " .. table.concat(segments, ".", 1, i - 1)
		end
		current = child
	end
	return current, nil
end

-- Resolve a path, creating missing Folders after the service. Used only for
-- create_animation, which the protocol explicitly allows to create its folders.
function PathResolver.resolveOrCreateFolders(path: any): (Instance?, string?, { Instance })
	local created: { Instance } = {}
	local segments, err = PathResolver.split(path)
	if segments == nil then
		return nil, err, created
	end
	local current = getService(segments[1])
	if current == nil then
		return nil, "unknown service: " .. segments[1], created
	end
	for i = 2, #segments do
		local okName, nameErr = PathResolver.validName(segments[i])
		if not okName then
			return nil, nameErr, created
		end
		local child = (current :: Instance):FindFirstChild(segments[i])
		if child == nil then
			local folder = Instance.new("Folder")
			folder.Name = segments[i]
			folder.Parent = current
			table.insert(created, folder)
			child = folder
		end
		current = child
	end
	return current, nil, created
end

-- Build the protocol path of an instance (service name first), or nil when the
-- instance is not inside the DataModel.
function PathResolver.pathOf(instance: Instance): string?
	local parts: { string } = {}
	local current: Instance? = instance
	while current ~= nil and current ~= game do
		local parent: Instance? = current.Parent
		if parent == game then
			table.insert(parts, 1, current.ClassName)
		else
			table.insert(parts, 1, current.Name)
		end
		current = parent
	end
	if current ~= game or #parts == 0 then
		return nil
	end
	return table.concat(parts, ".")
end

-- True when `path` names a service itself (deleting or replacing it is refused).
function PathResolver.isServiceRoot(path: string): boolean
	local segments = PathResolver.split(path)
	return segments ~= nil and #segments == 1
end

-- Pick a name that is free under `parent` by appending _2, _3, ...
function PathResolver.uniqueName(parent: Instance, name: string): string
	if parent:FindFirstChild(name) == nil then
		return name
	end
	local index = 2
	while parent:FindFirstChild(name .. "_" .. tostring(index)) ~= nil do
		index += 1
	end
	return name .. "_" .. tostring(index)
end

return PathResolver
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBXF1448AA54ED5B1793E207D926C98D31C">
      <Properties>
        <string name="Name">PropertyDecoder</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- PropertyDecoder: turns the JSON property encoding from docs/PLUGIN_PROTOCOL.md into
-- Roblox values. Only the value types below are accepted; anything else is refused.
-- Nothing here evaluates code: every value is built by a fixed constructor.
--
-- Supported encodings (type tags):
--   number / string / boolean   raw JSON value
--   Vector3     {"$type": "Vector3", "value": [x, y, z]}
--   Vector2     {"$type": "Vector2", "value": [x, y]}
--   CFrame      {"$type": "CFrame", "position": [x, y, z], "rotation": [rx, ry, rz]}  degrees,
--               CFrame.new(x, y, z) * CFrame.fromOrientation(rad rx, rad ry, rad rz)
--   Color3      {"$type": "Color3", "rgb": [r, g, b]}  0-255
--   UDim2       {"$type": "UDim2", "value": [xScale, xOffset, yScale, yOffset]}
--   UDim        {"$type": "UDim", "value": [scale, offset]}
--   Enum        {"$enum": "Material.Neon"}
--   BrickColor  {"$type": "BrickColor", "name": "Bright red"}
--   NumberRange {"$type": "NumberRange", "value": [min, max]}

local PropertyDecoder = {}

local MAX_STRING = 200000
local MAX_MAGNITUDE = 1e7

PropertyDecoder.SUPPORTED_TYPES = {
	"number",
	"string",
	"boolean",
	"Vector3",
	"Vector2",
	"CFrame",
	"Color3",
	"UDim2",
	"UDim",
	"Enum",
	"BrickColor",
	"NumberRange",
}

-- Properties the decoder never sets: Parent is assigned by the applier (last),
-- Name comes from the node's `name` field.
PropertyDecoder.BLOCKED_PROPERTIES = {
	Parent = true,
	Name = true,
} :: { [string]: boolean }

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and math.abs(value) <= MAX_MAGNITUDE
end

-- Read a fixed-length array of finite numbers.
local function numbers(value: any, count: number, label: string): ({ number }?, string?)
	if typeof(value) ~= "table" then
		return nil, label .. " must be an array of " .. tostring(count) .. " numbers"
	end
	if #value ~= count then
		return nil, label .. " must have exactly " .. tostring(count) .. " numbers"
	end
	local out: { number } = {}
	for i = 1, count do
		if not isFiniteNumber(value[i]) then
			return nil, label .. "[" .. tostring(i) .. "] is not a finite number"
		end
		out[i] = value[i]
	end
	return out, nil
end

local function decodeEnum(spec: any): (any, string?)
	if typeof(spec) ~= "string" then
		return nil, "$enum must be a string like 'Material.Neon'"
	end
	local enumName, itemName = (spec :: string):match("^([%a][%w]*)%.([%a][%w]*)$")
	if enumName == nil or itemName == nil then
		return nil, "malformed $enum: " .. spec
	end
	local ok, item = pcall(function()
		return (Enum :: any)[enumName][itemName]
	end)
	if not ok or typeof(item) ~= "EnumItem" then
		return nil, "unknown enum item: Enum." .. spec
	end
	return item, nil
end

-- Decode one encoded value. Returns (value, nil) or (nil, error message).
function PropertyDecoder.decode(encoded: any): (any, string?)
	local kind = typeof(encoded)
	if kind == "number" then
		if encoded ~= encoded then
			return nil, "NaN is not allowed"
		end
		return encoded, nil
	elseif kind == "boolean" then
		return encoded, nil
	elseif kind == "string" then
		if #encoded > MAX_STRING then
			return nil, "string value too long"
		end
		return encoded, nil
	elseif kind ~= "table" then
		return nil, "unsupported value of type " .. kind
	end

	if encoded["$enum"] ~= nil then
		return decodeEnum(encoded["$enum"])
	end

	local tag = encoded["$type"]
	if tag == "Vector3" then
		local v, err = numbers(encoded.value, 3, "Vector3.value")
		if v == nil then
			return nil, err
		end
		return Vector3.new(v[1], v[2], v[3]), nil
	elseif tag == "Vector2" then
		local v, err = numbers(encoded.value, 2, "Vector2.value")
		if v == nil then
			return nil, err
		end
		return Vector2.new(v[1], v[2]), nil
	elseif tag == "CFrame" then
		local p, perr = numbers(encoded.position, 3, "CFrame.position")
		if p == nil then
			return nil, perr
		end
		local r: { number } = { 0, 0, 0 }
		if encoded.rotation ~= nil then
			local rotation, rerr = numbers(encoded.rotation, 3, "CFrame.rotation")
			if rotation == nil then
				return nil, rerr
			end
			r = rotation
		end
		-- Same convention as the Orientation property (Y, then X, then Z), degrees.
		return CFrame.new(p[1], p[2], p[3]) * CFrame.fromOrientation(math.rad(r[1]), math.rad(r[2]), math.rad(r[3])), nil
	elseif tag == "Color3" then
		local c, err = numbers(encoded.rgb, 3, "Color3.rgb")
		if c == nil then
			return nil, err
		end
		for i = 1, 3 do
			if c[i] < 0 or c[i] > 255 then
				return nil, "Color3.rgb values must be 0-255"
			end
		end
		return Color3.fromRGB(c[1], c[2], c[3]), nil
	elseif tag == "UDim2" then
		local u, err = numbers(encoded.value, 4, "UDim2.value")
		if u == nil then
			return nil, err
		end
		return UDim2.new(u[1], u[2], u[3], u[4]), nil
	elseif tag == "UDim" then
		local u, err = numbers(encoded.value, 2, "UDim.value")
		if u == nil then
			return nil, err
		end
		return UDim.new(u[1], u[2]), nil
	elseif tag == "BrickColor" then
		if typeof(encoded.name) ~= "string" then
			return nil, "BrickColor.name must be a string"
		end
		local ok, color = pcall(function()
			return BrickColor.new(encoded.name)
		end)
		if not ok then
			return nil, "invalid BrickColor: " .. tostring(encoded.name)
		end
		return color, nil
	elseif tag == "NumberRange" then
		local n, err = numbers(encoded.value, 2, "NumberRange.value")
		if n == nil then
			return nil, err
		end
		if n[1] > n[2] then
			return nil, "NumberRange min must be <= max"
		end
		return NumberRange.new(n[1], n[2]), nil
	end

	return nil, "unsupported value type: " .. tostring(tag)
end

-- Decode and assign one property. Returns nil on success or an error message.
function PropertyDecoder.apply(instance: Instance, property: string, encoded: any): string?
	if typeof(property) ~= "string" or property == "" then
		return "property name must be a non-empty string"
	end
	if PropertyDecoder.BLOCKED_PROPERTIES[property] then
		return "property '" .. property .. "' cannot be set by the server"
	end
	local value, err = PropertyDecoder.decode(encoded)
	if err ~= nil then
		return property .. ": " .. err
	end
	local ok, setErr = pcall(function()
		(instance :: any)[property] = value
	end)
	if not ok then
		return property .. ": " .. tostring(setErr)
	end
	return nil
end

-- Attribute values are limited to number / string / boolean (protocol).
function PropertyDecoder.applyAttribute(instance: Instance, name: any, value: any): string?
	if typeof(name) ~= "string" or name == "" then
		return "attribute name must be a non-empty string"
	end
	local kind = typeof(value)
	if kind ~= "number" and kind ~= "string" and kind ~= "boolean" then
		return "attribute " .. name .. " must be a number, string or boolean"
	end
	local ok, err = pcall(function()
		instance:SetAttribute(name, value)
	end)
	if not ok then
		return "attribute " .. name .. ": " .. tostring(err)
	end
	return nil
end

return PropertyDecoder
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX2B38DCC6E8AAC1855F80B1E8D13A4565">
      <Properties>
        <string name="Name">Theme</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Theme: resolves Studio theme colors and notifies listeners when the theme changes.
-- Every UI module asks Theme for colors instead of hard-coding them so the plugin
-- stays readable in both the light and dark Studio themes.

local Theme = {}

type Listener = () -> ()

local listeners: { Listener } = {}
local connection: RBXScriptConnection? = nil

local function studioTheme(): StudioTheme
	return (settings() :: any).Studio.Theme
end

-- Look up a StudioStyleGuideColor, optionally with a modifier (Hover, Pressed, Disabled, Selected).
function Theme.color(guide: Enum.StudioStyleGuideColor, modifier: Enum.StudioStyleGuideModifier?): Color3
	local ok, result = pcall(function()
		if modifier then
			return studioTheme():GetColor(guide, modifier)
		end
		return studioTheme():GetColor(guide)
	end)
	if ok then
		return result
	end
	return Color3.fromRGB(46, 46, 46)
end

-- Semantic colors used across the plugin.
function Theme.background(): Color3
	return Theme.color(Enum.StudioStyleGuideColor.MainBackground)
end

function Theme.panel(): Color3
	return Theme.color(Enum.StudioStyleGuideColor.Titlebar)
end

function Theme.text(): Color3
	return Theme.color(Enum.StudioStyleGuideColor.MainText)
end

function Theme.dimText(): Color3
	return Theme.color(Enum.StudioStyleGuideColor.DimmedText)
end

function Theme.border(): Color3
	return Theme.color(Enum.StudioStyleGuideColor.Border)
end

function Theme.inputBackground(): Color3
	return Theme.color(Enum.StudioStyleGuideColor.InputFieldBackground)
end

function Theme.button(): Color3
	return Theme.color(Enum.StudioStyleGuideColor.Button)
end

function Theme.buttonText(): Color3
	return Theme.color(Enum.StudioStyleGuideColor.ButtonText)
end

function Theme.accent(): Color3
	return Theme.color(Enum.StudioStyleGuideColor.DialogMainButton)
end

function Theme.accentText(): Color3
	return Theme.color(Enum.StudioStyleGuideColor.DialogMainButtonText)
end

-- Mix two colours: t = 0 gives `a`, t = 1 gives `b`.
function Theme.mix(a: Color3, b: Color3, t: number): Color3
	return a:Lerp(b, t)
end

-- True when the current Studio theme has a dark background.
function Theme.isDark(): boolean
	local bg = Theme.background()
	return (0.299 * bg.R + 0.587 * bg.G + 0.114 * bg.B) < 0.5
end

-- Raised surface (cards, composer field): a few percent toward the text colour.
function Theme.raised(): Color3
	return Theme.mix(Theme.background(), Theme.text(), if Theme.isDark() then 0.06 else 0.035)
end

-- Subtle fill for chips, hover rows and the thinking block.
function Theme.subtle(): Color3
	return Theme.mix(Theme.background(), Theme.text(), if Theme.isDark() then 0.11 else 0.07)
end

-- Hairline separators: softer than Studio's Border colour.
function Theme.hairline(): Color3
	return Theme.mix(Theme.background(), Theme.text(), if Theme.isDark() then 0.16 else 0.13)
end

-- User bubble: the accent colour washed into the background, so MainText stays readable.
function Theme.userBubble(): Color3
	return Theme.mix(Theme.background(), Theme.accent(), if Theme.isDark() then 0.32 else 0.16)
end

function Theme.assistantBubble(): Color3
	return Theme.raised()
end

-- Code panels are always dark (editor-like) in both themes, with fixed light text.
function Theme.codeBackground(): Color3
	return if Theme.isDark() then Color3.fromRGB(24, 24, 27) else Color3.fromRGB(32, 33, 36)
end

function Theme.codeHeader(): Color3
	return if Theme.isDark() then Color3.fromRGB(36, 36, 40) else Color3.fromRGB(45, 46, 50)
end

function Theme.codeText(): Color3
	return Color3.fromRGB(220, 220, 220)
end

function Theme.codeDimText(): Color3
	return Color3.fromRGB(150, 150, 155)
end

-- Colour of `inline code` inside prose (RichText hex), readable on light and dark.
function Theme.inlineCodeHex(): string
	return if Theme.isDark() then "#E5A86E" else "#B0461C"
end

function Theme.error(): Color3
	return Theme.color(Enum.StudioStyleGuideColor.ErrorText)
end

function Theme.warning(): Color3
	return Theme.color(Enum.StudioStyleGuideColor.WarningText)
end

function Theme.success(): Color3
	-- Studio has no "success" guide colour; a fixed mid green reads well on light and dark.
	return Color3.fromRGB(46, 160, 67)
end

function Theme.danger(): Color3
	return Color3.fromRGB(200, 40, 40)
end

function Theme.onAccent(): Color3
	return Color3.new(1, 1, 1)
end

---------------------------------------------------------------------------
-- Fonts. BuilderSans is Studio's own UI face; older Studio builds without it fall
-- back to SourceSans. RobotoMono is used for code.
---------------------------------------------------------------------------

local function pickFont(name: string, fallback: Enum.Font): Enum.Font
	local ok, font = pcall(function()
		return (Enum.Font :: any)[name]
	end)
	if ok and typeof(font) == "EnumItem" then
		return font :: any
	end
	return fallback
end

Theme.FONT_REGULAR = pickFont("BuilderSans", Enum.Font.SourceSans)
Theme.FONT_MEDIUM = pickFont("BuilderSansMedium", Enum.Font.SourceSansSemibold)
Theme.FONT_BOLD = pickFont("BuilderSansBold", Enum.Font.SourceSansBold)
Theme.FONT_MONO = Enum.Font.RobotoMono

-- Register a callback that re-applies colors. It runs immediately and on every
-- Studio ThemeChanged. Returns a function that unregisters the callback (call it
-- when the themed UI is destroyed so listeners do not leak).
function Theme.bind(callback: Listener): () -> ()
	table.insert(listeners, callback)
	callback()
	if connection == nil then
		local ok, conn = pcall(function()
			return (settings() :: any).Studio.ThemeChanged:Connect(function()
				for _, listener in ipairs(table.clone(listeners)) do
					task.spawn(listener)
				end
			end)
		end)
		if ok then
			connection = conn
		end
	end
	return function()
		local index = table.find(listeners, callback)
		if index then
			table.remove(listeners, index)
		end
	end
end

-- Paint `property` of `instance` with `colorFn()` now and again whenever the Studio
-- theme changes. Registrations are weak-keyed, so destroyed UI is not kept alive.
local painted: { [Instance]: { [string]: () -> Color3 } } = setmetatable({}, { __mode = "k" }) :: any
local paintBinding: (() -> ())? = nil

local function repaintAll()
	for instance, props in pairs(painted) do
		for property, colorFn in pairs(props) do
			pcall(function()
				(instance :: any)[property] = colorFn()
			end)
		end
	end
end

function Theme.paint(instance: Instance, property: string, colorFn: () -> Color3): ()
	local props = painted[instance]
	if props == nil then
		local newProps: { [string]: () -> Color3 } = {}
		painted[instance] = newProps
		props = newProps
		instance.Destroying:Connect(function()
			painted[instance] = nil
		end)
	end
	(props :: { [string]: () -> Color3 })[property] = colorFn;
	(instance :: any)[property] = colorFn()
	if paintBinding == nil then
		paintBinding = Theme.bind(repaintAll)
	end
end

function Theme.destroy(): ()
	if connection then
		connection:Disconnect()
		connection = nil
	end
	table.clear(listeners)
	table.clear(painted)
	paintBinding = nil
end

return Theme
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX8E902A4AA63D093C777074E3137BCE3F">
      <Properties>
        <string name="Name">Ui</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Ui: small helpers for building themed Studio widgets declaratively.
-- Colours always come from Theme (painted, so they follow live theme changes).
-- Signal connections made here are on the instances themselves, so Destroy()
-- disconnects them; nothing here keeps a per-frame loop.

local Theme = require(script.Parent.Theme)

local Ui = {}

export type Props = { [string]: any }
export type ButtonStyle = "primary" | "secondary" | "normal" | "ghost" | "danger"
export type MenuItem = { id: string, label: string, description: string? }

Ui.TEXT_SIZE = 14
Ui.SMALL_TEXT = 12
Ui.BUTTON_HEIGHT = 26

-- Create an instance, assign properties (Parent last), and parent any children.
function Ui.create(className: string, props: Props?, children: { Instance }?): Instance
	local instance = Instance.new(className)
	local parent: Instance? = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Ui.corner(radius: number): Instance
	return Ui.create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

-- CSS-like padding: (all), (vertical, horizontal) or (top, right, bottom, left).
function Ui.padding(top: number, right: number?, bottom: number?, left: number?): Instance
	local r = right or top
	local b = bottom or top
	local l = left or r
	return Ui.create("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, r),
		PaddingBottom = UDim.new(0, b),
		PaddingLeft = UDim.new(0, l),
	})
end

function Ui.vlist(spacing: number, horizontalAlignment: Enum.HorizontalAlignment?): Instance
	return Ui.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = horizontalAlignment or Enum.HorizontalAlignment.Left,
		Padding = UDim.new(0, spacing),
	})
end

function Ui.hlist(spacing: number, horizontalAlignment: Enum.HorizontalAlignment?): Instance
	return Ui.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		HorizontalAlignment = horizontalAlignment or Enum.HorizontalAlignment.Left,
		Padding = UDim.new(0, spacing),
	})
end

function Ui.stroke(colorFn: () -> Color3, thickness: number?): UIStroke
	local stroke = Ui.create("UIStroke", {
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}) :: UIStroke
	Theme.paint(stroke, "Color", colorFn)
	return stroke
end

-- Transparent full-width row that sizes to its children.
function Ui.row(spacing: number, props: Props?): Frame
	local frame = Ui.create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, { Ui.hlist(spacing) }) :: Frame
	if props then
		for key, value in pairs(props) do
			(frame :: any)[key] = value
		end
	end
	return frame
end

-- A wrapped, auto-height label.
function Ui.label(text: string, props: Props?): TextLabel
	local label = Ui.create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = Theme.FONT_REGULAR,
		TextSize = Ui.TEXT_SIZE,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = text,
	}) :: TextLabel
	if props then
		for key, value in pairs(props) do
			(label :: any)[key] = value
		end
	end
	if not (props and props.TextColor3) then
		Theme.paint(label, "TextColor3", Theme.text)
	end
	return label
end

-- Hover tint for buttons whose idle background is transparent or a theme token.
function Ui.hover(button: GuiButton, idle: () -> Color3, hovered: () -> Color3, idleTransparency: number?)
	local transparent = idleTransparency or 0
	button.MouseEnter:Connect(function()
		if button.Active then
			button.BackgroundTransparency = 0
			Theme.paint(button, "BackgroundColor3", hovered)
		end
	end)
	button.MouseLeave:Connect(function()
		button.BackgroundTransparency = transparent
		Theme.paint(button, "BackgroundColor3", idle)
	end)
end

-- A themed push button. With no width the button sizes to its text.
--   primary   accent fill (main action)
--   secondary / normal  subtle fill with hairline border
--   ghost     no fill until hovered (toolbar icons, small links)
--   danger    red fill, white text
function Ui.button(text: string, style: ButtonStyle?, width: number?): TextButton
	local kind = style or "secondary"
	local button = Ui.create("TextButton", {
		Size = UDim2.new(0, width or 0, 0, Ui.BUTTON_HEIGHT),
		AutomaticSize = if width then Enum.AutomaticSize.None else Enum.AutomaticSize.X,
		AutoButtonColor = kind ~= "ghost",
		Font = Theme.FONT_MEDIUM,
		TextSize = Ui.TEXT_SIZE,
		Text = text,
		BorderSizePixel = 0,
	}, { Ui.corner(6), Ui.padding(0, 10) }) :: TextButton
	if kind == "primary" then
		Theme.paint(button, "BackgroundColor3", Theme.accent)
		Theme.paint(button, "TextColor3", Theme.onAccent)
	elseif kind == "danger" then
		Theme.paint(button, "BackgroundColor3", Theme.danger)
		Theme.paint(button, "TextColor3", Theme.onAccent)
	elseif kind == "ghost" then
		button.BackgroundTransparency = 1
		Theme.paint(button, "BackgroundColor3", Theme.subtle)
		Theme.paint(button, "TextColor3", Theme.dimText)
		Ui.hover(button, Theme.subtle, Theme.subtle, 1)
	else
		Theme.paint(button, "BackgroundColor3", Theme.raised)
		Theme.paint(button, "TextColor3", Theme.text)
		Ui.stroke(Theme.hairline).Parent = button
	end
	return button
end

-- Square icon button (gear, plus, chevrons) using a plain Unicode glyph.
function Ui.iconButton(glyph: string, tooltip: string?): TextButton
	local button = Ui.button(glyph, "ghost", 28)
	button.Size = UDim2.fromOffset(28, 28)
	button.TextSize = 16
	button.Name = tooltip or glyph
	local padding = button:FindFirstChildOfClass("UIPadding")
	if padding then
		padding:Destroy()
	end
	return button
end

-- Small rounded pill with text, e.g. "Offline", "offline:obby", "✓ 3/3 checks".
function Ui.chip(text: string, colorFn: (() -> Color3)?): (Frame, TextLabel)
	local frame = Ui.create("Frame", {
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		BorderSizePixel = 0,
	}, { Ui.corner(10), Ui.padding(0, 8) }) :: Frame
	Theme.paint(frame, "BackgroundColor3", Theme.subtle)
	local label = Ui.create("TextLabel", {
		Name = "Text",
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = Theme.FONT_MEDIUM,
		TextSize = Ui.SMALL_TEXT,
		Text = text,
		Parent = frame,
	}) :: TextLabel
	Theme.paint(label, "TextColor3", colorFn or Theme.dimText)
	return frame, label
end

-- A themed single-line (or multi-line) text box.
function Ui.textBox(placeholder: string, multiLine: boolean?): TextBox
	local box = Ui.create("TextBox", {
		Size = UDim2.new(1, 0, 0, 28),
		Font = Theme.FONT_REGULAR,
		TextSize = Ui.TEXT_SIZE,
		Text = "",
		PlaceholderText = placeholder,
		ClearTextOnFocus = false,
		MultiLine = multiLine == true,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = if multiLine then Enum.TextYAlignment.Top else Enum.TextYAlignment.Center,
		BorderSizePixel = 0,
	}, { Ui.corner(6), Ui.padding(4, 8) }) :: TextBox
	Theme.paint(box, "BackgroundColor3", Theme.inputBackground)
	Theme.paint(box, "TextColor3", Theme.text)
	Theme.paint(box, "PlaceholderColor3", Theme.dimText)
	local stroke = Ui.stroke(Theme.hairline)
	stroke.Parent = box
	box.Focused:Connect(function()
		Theme.paint(stroke, "Color", Theme.accent)
	end)
	box.FocusLost:Connect(function()
		Theme.paint(stroke, "Color", Theme.hairline)
	end)
	return box
end

export type CodeOptions = {
	language: string?,
	onInsert: ((code: string, language: string?) -> ())?,
}

-- An editor-like dark code panel: a header (language + Select / Insert) above a
-- read-only, selectable monospace TextBox. Plugins cannot write the OS clipboard,
-- so "Select" focuses the box and selects everything for Ctrl+C.
function Ui.codeBlock(code: string, maxLines: number?, options: CodeOptions?): Frame
	local text = code
	local hidden = 0
	if maxLines then
		local lines = string.split(code, "\n")
		if #lines > maxLines then
			text = table.concat(lines, "\n", 1, maxLines)
			hidden = #lines - maxLines
		end
	end
	local language = if options then options.language else nil

	local frame = Ui.create("Frame", {
		Name = "CodeBlock",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, { Ui.corner(6), Ui.vlist(0) }) :: Frame
	Theme.paint(frame, "BackgroundColor3", Theme.codeBackground)

	local header = Ui.create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 24),
		BorderSizePixel = 0,
		LayoutOrder = 1,
		Parent = frame,
	}, { Ui.padding(0, 4, 0, 10) }) :: Frame
	Theme.paint(header, "BackgroundColor3", Theme.codeHeader)

	local languageLabel = Ui.create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -120, 1, 0),
		Font = Theme.FONT_MONO,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = language or "code",
		Parent = header,
	})
	Theme.paint(languageLabel, "TextColor3", Theme.codeDimText)

	local actions = Ui.create("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 120, 1, 0),
		Parent = header,
	}, { Ui.hlist(2, Enum.HorizontalAlignment.Right) })

	local function headerButton(label: string, order: number): TextButton
		local button = Ui.create("TextButton", {
			Size = UDim2.fromOffset(0, 20),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			BackgroundColor3 = Color3.fromRGB(70, 70, 76),
			AutoButtonColor = false,
			Font = Theme.FONT_MEDIUM,
			TextSize = 12,
			Text = label,
			LayoutOrder = order,
			Parent = actions,
		}, { Ui.corner(4), Ui.padding(0, 6) }) :: TextButton
		Theme.paint(button, "TextColor3", Theme.codeDimText)
		button.MouseEnter:Connect(function()
			button.BackgroundTransparency = 0
		end)
		button.MouseLeave:Connect(function()
			button.BackgroundTransparency = 1
		end)
		return button
	end

	local box = Ui.create("TextBox", {
		Name = "Code",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = Theme.FONT_MONO,
		TextSize = 13,
		TextWrapped = true,
		MultiLine = true,
		ClearTextOnFocus = false,
		TextEditable = false,
		RichText = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = text,
		LayoutOrder = 2,
		Parent = frame,
	}, { Ui.padding(8, 10) }) :: TextBox
	Theme.paint(box, "TextColor3", Theme.codeText)

	local selectButton = headerButton("Select", 1)
	selectButton.MouseButton1Click:Connect(function()
		box:CaptureFocus()
		box.SelectionStart = 1
		box.CursorPosition = #box.Text + 1
	end)

	local onInsert = if options then options.onInsert else nil
	if onInsert then
		local insertButton = headerButton("Insert", 2)
		insertButton.MouseButton1Click:Connect(function()
			onInsert(code, language)
		end)
	end

	if hidden > 0 then
		local note = Ui.label("… " .. tostring(hidden) .. " more lines (Select copies only what is shown; Insert uses all of it)", {
			TextSize = 11,
			LayoutOrder = 3,
			TextColor3 = Theme.codeDimText(),
		})
		note.Parent = frame
		Ui.padding(0, 10, 6, 10).Parent = note
	end
	return frame
end

-- A popover menu anchored above (or below) `anchor`, inside `host` (usually the
-- widget root). A transparent full-size scrim closes it on any outside click.
-- Returns a function that closes it.
function Ui.menu(
	host: GuiObject,
	anchor: GuiObject,
	items: { MenuItem },
	selectedId: string?,
	onPick: (id: string) -> (),
	width: number?
): () -> ()
	local scrim = Ui.create("TextButton", {
		Name = "MenuScrim",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = host,
	}) :: TextButton

	local menuWidth = width or 220
	local relative = anchor.AbsolutePosition - host.AbsolutePosition
	local openUp = relative.Y > host.AbsoluteSize.Y / 2
	local x = math.clamp(relative.X, 4, math.max(4, host.AbsoluteSize.X - menuWidth - 4))
	local panel = Ui.create("Frame", {
		Name = "Menu",
		Size = UDim2.fromOffset(menuWidth, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		AnchorPoint = if openUp then Vector2.new(0, 1) else Vector2.new(0, 0),
		Position = if openUp
			then UDim2.fromOffset(x, relative.Y - 4)
			else UDim2.fromOffset(x, relative.Y + anchor.AbsoluteSize.Y + 4),
		BorderSizePixel = 0,
		ZIndex = 51,
		Parent = scrim,
	}, { Ui.corner(8), Ui.padding(4), Ui.vlist(0) }) :: Frame
	Theme.paint(panel, "BackgroundColor3", Theme.raised)
	Ui.stroke(Theme.hairline).Parent = panel

	local function close()
		scrim:Destroy()
	end
	scrim.MouseButton1Click:Connect(close)

	for index, item in ipairs(items) do
		local entry = Ui.create("TextButton", {
			Name = item.id,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 52,
			LayoutOrder = index,
			Parent = panel,
		}, { Ui.corner(6), Ui.padding(5, 8), Ui.vlist(1) }) :: TextButton
		Theme.paint(entry, "BackgroundColor3", Theme.subtle)
		Ui.hover(entry, Theme.subtle, Theme.subtle, 1)
		local selected = item.id == selectedId
		Ui.label((if selected then "✓  " else "     ") .. item.label, {
			Font = if selected then Theme.FONT_BOLD else Theme.FONT_MEDIUM,
			ZIndex = 52,
			LayoutOrder = 1,
			Parent = entry,
		})
		if item.description and item.description ~= "" then
			local hint = Ui.label("     " .. item.description, {
				TextSize = Ui.SMALL_TEXT,
				ZIndex = 52,
				LayoutOrder = 2,
				TextColor3 = Theme.dimText(),
				Parent = entry,
			})
			Theme.paint(hint, "TextColor3", Theme.dimText)
		end
		entry.MouseButton1Click:Connect(function()
			close()
			onPick(item.id)
		end)
	end
	return close
end

return Ui
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>
