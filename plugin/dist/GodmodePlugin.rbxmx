	{
		key = "npc_patrol",
		keywords = { "npc", "patrol", "enemy", "pathfinding", "pnj", "ennemi", "enemigo", "patrouill", "patrull" },
		animation = false,
		json = [[{"ok":true,"reply_markdown":"**Source:** `tool:npc_patrol` - a deterministic template generator chosen by the keyword router (confidence 1.00); this is not neural-model output. Verification: 3/3 checks passed.\n\nAn NPC patrol system: 4 waypoint parts in `Workspace.GodmodePatrolPoints` (visited in name order) and a server Script using `PathfindingService` (with jump waypoints, a move timeout and a direct-MoveTo fallback). It drives every Model tagged **`GodmodePatrolNPC`**, stops when the NPC dies or is removed, and sets server network ownership so exploiters cannot steer it.\n\n**You still need to:** add an R15 rig (Avatar > Rig Builder) and give it the tag `GodmodePatrolNPC` (Properties > Tags).\n\n**Proposed only - nothing has been changed in Studio.** 2 action(s) await your approval in the plugin:\n- `a1` create_instances: Create patrol waypoints\n- `a2` create_script: NPC patrol controller","source":"offline:tool:npc_patrol","intent":{"name":"npc_patrol","confidence":1.0,"router":"keyword-regex","params":{}},"actions":[{"type":"create_instances","description":"Create patrol waypoints","parent_path":"Workspace","tree":{"className":"Folder","name":"GodmodePatrolPoints","properties":{},"children":[{"className":"Part","name":"Point01","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[2.0,1.0,2.0]},"CFrame":{"$type":"CFrame","position":[30.0,0.5,0.0],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[255,170,0]},"Material":{"$enum":"Material.Neon"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"},"CanCollide":false,"Transparency":0.5,"CanQuery":false,"CanTouch":false},"children":[]},{"className":"Part","name":"Point02","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[2.0,1.0,2.0]},"CFrame":{"$type":"CFrame","position":[0.0,0.5,30.0],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[255,170,0]},"Material":{"$enum":"Material.Neon"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"},"CanCollide":false,"Transparency":0.5,"CanQuery":false,"CanTouch":false},"children":[]},{"className":"Part","name":"Point03","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[2.0,1.0,2.0]},"CFrame":{"$type":"CFrame","position":[-30.0,0.5,0.0],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[255,170,0]},"Material":{"$enum":"Material.Neon"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"},"CanCollide":false,"Transparency":0.5,"CanQuery":false,"CanTouch":false},"children":[]},{"className":"Part","name":"Point04","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[2.0,1.0,2.0]},"CFrame":{"$type":"CFrame","position":[-0.0,0.5,-30.0],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[255,170,0]},"Material":{"$enum":"Material.Neon"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"},"CanCollide":false,"Transparency":0.5,"CanQuery":false,"CanTouch":false},"children":[]}]},"destructive":false,"id":"a1","requires_approval":true},{"type":"create_script","description":"NPC patrol controller","parent_path":"ServerScriptService","name":"GodmodeNPCPatrol","class":"Script","source":"-- Generated by GODMODE tool:npc_patrol (deterministic template, verified by godmode.luau; not neural-model output)\n-- Patrols every NPC model tagged \"GodmodePatrolNPC\" through the parts in Workspace.GodmodePatrolPoints.\nlocal CollectionService = game:GetService(\"CollectionService\")\nlocal PathfindingService = game:GetService(\"PathfindingService\")\n\nlocal TAG = \"GodmodePatrolNPC\"\nlocal WAYPOINT_FOLDER = workspace:WaitForChild(\"GodmodePatrolPoints\")\nlocal MOVE_TIMEOUT = 6\nlocal PAUSE_AT_POINT = 1\nlocal active = {}\n\nlocal function sortedPoints()\n\tlocal points = {}\n\tfor _, child in ipairs(WAYPOINT_FOLDER:GetChildren()) do\n\t\tif child:IsA(\"BasePart\") then\n\t\t\ttable.insert(points, child)\n\t\tend\n\tend\n\ttable.sort(points, function(a, b)\n\t\treturn a.Name < b.Name\n\tend)\n\treturn points\nend\n\nlocal function moveTo(humanoid: Humanoid, position: Vector3): boolean\n\tlocal finished = false\n\tlocal reached = false\n\tlocal connection = humanoid.MoveToFinished:Connect(function(success)\n\t\treached = success\n\t\tfinished = true\n\tend)\n\thumanoid:MoveTo(position)\n\tlocal started = os.clock()\n\twhile not finished and os.clock() - started < MOVE_TIMEOUT do\n\t\ttask.wait(0.1)\n\tend\n\tconnection:Disconnect()\n\treturn reached\nend\n\nlocal function followPath(npc: Model, humanoid: Humanoid, root: BasePart, target: Vector3)\n\tlocal path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })\n\tlocal ok = pcall(function()\n\t\tpath:ComputeAsync(root.Position, target)\n\tend)\n\tif not ok or path.Status ~= Enum.PathStatus.Success then\n\t\tmoveTo(humanoid, target)\n\t\treturn\n\tend\n\tfor _, waypoint in ipairs(path:GetWaypoints()) do\n\t\tif active[npc] ~= true or humanoid.Health <= 0 then\n\t\t\treturn\n\t\tend\n\t\tif waypoint.Action == Enum.PathWaypointAction.Jump then\n\t\t\thumanoid.Jump = true\n\t\tend\n\t\tif not moveTo(humanoid, waypoint.Position) then\n\t\t\treturn\n\t\tend\n\tend\nend\n\nlocal function patrol(npc: Instance)\n\tif not npc:IsA(\"Model\") or active[npc] then\n\t\treturn\n\tend\n\tlocal humanoid = npc:FindFirstChildOfClass(\"Humanoid\")\n\tlocal root = npc:FindFirstChild(\"HumanoidRootPart\")\n\tif humanoid == nil or root == nil or not root:IsA(\"BasePart\") then\n\t\twarn(\"GodmodePatrolNPC needs a Humanoid and HumanoidRootPart: \" .. npc:GetFullName())\n\t\treturn\n\tend\n\tactive[npc] = true\n\tpcall(function()\n\t\troot:SetNetworkOwner(nil)\n\tend)\n\tlocal diedConnection = humanoid.Died:Connect(function()\n\t\tactive[npc] = nil\n\tend)\n\ttask.spawn(function()\n\t\twhile active[npc] == true and npc.Parent ~= nil do\n\t\t\tlocal points = sortedPoints()\n\t\t\tif #points == 0 then\n\t\t\t\ttask.wait(1)\n\t\t\tend\n\t\t\tfor _, point in ipairs(points) do\n\t\t\t\tif active[npc] ~= true then\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\t\tfollowPath(npc, humanoid, root, point.Position)\n\t\t\t\ttask.wait(PAUSE_AT_POINT)\n\t\t\tend\n\t\tend\n\t\tdiedConnection:Disconnect()\n\t\tactive[npc] = nil\n\tend)\nend\n\nCollectionService:GetInstanceAddedSignal(TAG):Connect(patrol)\nCollectionService:GetInstanceRemovedSignal(TAG):Connect(function(npc)\n\tactive[npc] = nil\nend)\nfor _, npc in ipairs(CollectionService:GetTagged(TAG)) do\n\tpatrol(npc)\nend\n","destructive":false,"id":"a2","requires_approval":true}],"verification":[{"check":"tree:Workspace.GodmodePatrolPoints","ok":true,"detail":"5 instance(s), property encoding valid"},{"check":"structure:ServerScriptService.GodmodeNPCPatrol","ok":true,"detail":"balanced blocks/brackets, lexically valid"},{"check":"lint:ServerScriptService.GodmodeNPCPatrol","ok":true,"detail":"no findings"}],"warnings":["Offline mode: this is the default version of this build/script. Edit it after applying, or enable the optional GODMODE server (/server on) for custom sizes, counts and colors."],"autonomy":3,"applied":false}]],
	},
	{
		key = "tween_door",
		keywords = { "door", "tween", "gate", "porte", "puerta", "portail", "ouvr", "abre", "abrir" },
		animation = false,
		json = [[{"ok":true,"reply_markdown":"**Source:** `tool:tween_door` - a deterministic template generator chosen by the keyword router (confidence 1.00); this is not neural-model output. Verification: 3/3 checks passed.\n\nA 6x10 sliding door model with a ProximityPrompt. A server Script tweens it open (1 s, Quad InOut), keeps it open 3 s, and closes it; it ignores triggers while moving and re-checks the player's distance on the server.\n\n**Proposed only - nothing has been changed in Studio.** 2 action(s) await your approval in the plugin:\n- `a1` create_instances: Create door model\n- `a2` create_script: Door tween controller","source":"offline:tool:tween_door","intent":{"name":"tween_door","confidence":1.0,"router":"keyword-regex","params":{}},"actions":[{"type":"create_instances","description":"Create door model","parent_path":"Workspace","tree":{"className":"Model","name":"GodmodeDoor","properties":{},"children":[{"className":"Part","name":"FrameLeft","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[1.0,11.0,1.0]},"CFrame":{"$type":"CFrame","position":[-3.5,5.5,0.0],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[90,90,90]},"Material":{"$enum":"Material.Concrete"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]},{"className":"Part","name":"FrameRight","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[1.0,11.0,1.0]},"CFrame":{"$type":"CFrame","position":[3.5,5.5,0.0],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[90,90,90]},"Material":{"$enum":"Material.Concrete"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]},{"className":"Part","name":"FrameTop","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[8.0,1.0,1.0]},"CFrame":{"$type":"CFrame","position":[0.0,11.5,0.0],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[90,90,90]},"Material":{"$enum":"Material.Concrete"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]},{"className":"Part","name":"Door","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[6.0,10.0,0.6]},"CFrame":{"$type":"CFrame","position":[0.0,5.0,0.0],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[124,92,70]},"Material":{"$enum":"Material.Wood"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[{"className":"ProximityPrompt","name":"OpenPrompt","properties":{"ActionText":"Open","ObjectText":"Door","MaxActivationDistance":10,"HoldDuration":0},"children":[]}]}]},"destructive":false,"id":"a1","requires_approval":true},{"type":"create_script","description":"Door tween controller","parent_path":"Workspace.GodmodeDoor","name":"DoorController","class":"Script","source":"-- Generated by GODMODE tool:tween_door (deterministic template, verified by godmode.luau; not neural-model output)\n-- Server-side sliding door: a ProximityPrompt opens it with a tween, then it auto-closes.\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal model = script.Parent\nlocal door = model:WaitForChild(\"Door\")\nlocal prompt = door:WaitForChild(\"OpenPrompt\")\n\nlocal OPEN_TIME = 1.0\nlocal STAY_OPEN = 3\nlocal closedCFrame = door.CFrame\nlocal openCFrame = closedCFrame + Vector3.new(0, door.Size.Y - 0.5, 0)\nlocal tweenInfo = TweenInfo.new(OPEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)\nlocal busy = false\n\nlocal function tweenTo(target: CFrame)\n\tlocal tween = TweenService:Create(door, tweenInfo, { CFrame = target })\n\ttween:Play()\n\ttween.Completed:Wait()\n\ttween:Destroy()\nend\n\nprompt.Triggered:Connect(function(player: Player)\n\tif busy then\n\t\treturn\n\tend\n\tlocal character = player.Character\n\tlocal root = character and character:FindFirstChild(\"HumanoidRootPart\")\n\tif root == nil or (root.Position - door.Position).Magnitude > prompt.MaxActivationDistance + 5 then\n\t\treturn\n\tend\n\tbusy = true\n\tprompt.Enabled = false\n\ttweenTo(openCFrame)\n\ttask.wait(STAY_OPEN)\n\ttweenTo(closedCFrame)\n\tprompt.Enabled = true\n\tbusy = false\nend)\n","destructive":false,"id":"a2","requires_approval":true}],"verification":[{"check":"tree:Workspace.GodmodeDoor","ok":true,"detail":"6 instance(s), property encoding valid"},{"check":"structure:Workspace.GodmodeDoor.DoorController","ok":true,"detail":"balanced blocks/brackets, lexically valid"},{"check":"lint:Workspace.GodmodeDoor.DoorController","ok":true,"detail":"no findings"}],"warnings":["Offline mode: this is the default version of this build/script. Edit it after applying, or enable the optional GODMODE server (/server on) for custom sizes, counts and colors."],"autonomy":3,"applied":false}]],
