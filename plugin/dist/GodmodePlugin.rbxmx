oses":{"LowerTorso":{"rotation":[0.0,0.0,0.0],"position":[0.0,0.3,0.0]},"UpperTorso":{"rotation":[15.0,0.0,0.0],"position":[0.0,0.0,0.0]},"Head":{"rotation":[25.0,0.0,0.0],"position":[0.0,0.0,0.0]},"LeftUpperArm":{"rotation":[0.0,0.0,-165.0],"position":[0.0,0.0,0.0]},"LeftLowerArm":{"rotation":[20.0,0.0,0.0],"position":[0.0,0.0,0.0]},"LeftHand":{"rotation":[0.0,0.0,0.0],"position":[0.0,0.0,0.0]},"RightUpperArm":{"rotation":[0.0,0.0,165.0],"position":[0.0,0.0,0.0]},"RightLowerArm":{"rotation":[20.0,0.0,0.0],"position":[0.0,0.0,0.0]},"RightHand":{"rotation":[0.0,0.0,0.0],"position":[0.0,0.0,0.0]},"LeftUpperLeg":{"rotation":[0.0,0.0,0.0],"position":[0.0,0.0,0.0]},"LeftLowerLeg":{"rotation":[0,0.0,0.0],"position":[0.0,0.0,0.0]},"LeftFoot":{"rotation":[-20.0,0.0,0.0],"position":[0.0,0.0,0.0]},"RightUpperLeg":{"rotation":[0.0,0.0,0.0],"position":[0.0,0.0,0.0]},"RightLowerLeg":{"rotation":[0,0.0,0.0],"position":[0.0,0.0,0.0]},"RightFoot":{"rotation":[-20.0,0.0,0.0],"position":[0.0,0.0,0.0]}}}],"markers":[],"style":"victory","params":{"speed":1.0,"intensity":1.0},"provenance":"procedural keyframes designed from the reference video TITLES supplied by the user (the videos were not watched; no motion capture)","destructive":false,"meta":{"clamped":0,"description":"Victory pose: anticipation crouch, explosive two-fist raise, two fist pumps, hold."},"id":"a1","requires_approval":true},{"type":"create_script","description":"Play GodmodeVictory on the local character","parent_path":"StarterPlayer.StarterCharacterScripts","name":"PlayGodmodeVictory","class":"LocalScript","source":"-- Generated by GODMODE tool:animation (deterministic template, verified by godmode.luau; not neural-model output)\n-- Plays the \"GodmodeVictory\" animation (victory) on this character. Press G to toggle.\n-- Publish the KeyframeSequence (Animation Editor > Publish to Roblox) and paste the id below for live games.\nlocal ContextActionService = game:GetService(\"ContextActionService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal ANIMATION_ID = \"rbxassetid://0\"\nlocal SEQUENCE_FOLDER = \"GodmodeAnimations\"\nlocal SEQUENCE_NAME = \"GodmodeVictory\"\nlocal ACTION_NAME = \"Godmode_GodmodeVictory\"\nlocal TOGGLE_KEY = Enum.KeyCode.G\nlocal LOOPED = false\nlocal FADE_TIME = 0.15\n\nlocal character = script.Parent\nlocal humanoid = character:WaitForChild(\"Humanoid\")\nlocal animator = humanoid:WaitForChild(\"Animator\")\n\nlocal animation = nil\nlocal track = nil\nlocal connections = {}\n\nlocal function resolveAnimationId(): string?\n\tif ANIMATION_ID ~= \"rbxassetid://0\" then\n\t\treturn ANIMATION_ID\n\tend\n\tif not RunService:IsStudio() then\n\t\treturn nil\n\tend\n\tlocal folder = ReplicatedStorage:FindFirstChild(SEQUENCE_FOLDER)\n\tlocal sequence = folder and folder:FindFirstChild(SEQUENCE_NAME)\n\tif sequence == nil or not sequence:IsA(\"KeyframeSequence\") then\n\t\treturn nil\n\tend\n\tlocal ok, temporaryId = pcall(function()\n\t\treturn game:GetService(\"KeyframeSequenceProvider\"):RegisterKeyframeSequence(sequence)\n\tend)\n\tif ok then\n\t\treturn temporaryId\n\tend\n\treturn nil\nend\n\nlocal function cleanup()\n\tContextActionService:UnbindAction(ACTION_NAME)\n\tfor _, connection in ipairs(connections) do\n\t\tconnection:Disconnect()\n\tend\n\ttable.clear(connections)\n\tif track then\n\t\ttrack:Stop(FADE_TIME)\n\t\ttrack:Destroy()\n\t\ttrack = nil\n\tend\n\tif animation then\n\t\tanimation:Destroy()\n\t\tanimation = nil\n\tend\nend\n\nlocal animationId = resolveAnimationId()\nif animationId == nil then\n\twarn(\"[GODMODE] No animation id for \" .. SEQUENCE_NAME .. \": publish it and set ANIMATION_ID.\")\nelse\n\tanimation = Instance.new(\"Animation\")\n\tanimation.AnimationId = animationId\n\ttrack = animator:LoadAnimation(animation)\n\ttrack.Priority = Enum.AnimationPriority.Action\n\ttrack.Looped = LOOPED\n\n\tContextActionService:BindAction(ACTION_NAME, function(_, inputState)\n\t\tif inputState ~= Enum.UserInputState.Begin or track == nil then\n\t\t\treturn Enum.ContextActionResult.Pass\n\t\tend\n\t\tif track.IsPlaying then\n\t\t\ttrack:Stop(FADE_TIME)\n\t\telse\n\t\t\ttrack:Play(FADE_TIME)\n\t\tend\n\t\treturn Enum.ContextActionResult.Sink\n\tend, true, TOGGLE_KEY)\n\n\ttable.insert(connections, humanoid.Died:Connect(cleanup))\n\ttable.insert(connections, script.Destroying:Connect(cleanup))\nend\n","destructive":false,"id":"a2","requires_approval":true}],"verification":[{"check":"animation:GodmodeVictory","ok":true,"detail":"8 keyframes, joint limits respected, hierarchy consistent"},{"check":"structure:StarterPlayer.StarterCharacterScripts.PlayGodmodeVictory","ok":true,"detail":"balanced blocks/brackets, lexically valid"},{"check":"lint:StarterPlayer.StarterCharacterScripts.PlayGodmodeVictory","ok":true,"detail":"no findings"}],"warnings":["Offline mode: this is the default version of this build/script. Edit it after applying, or enable the optional GODMODE server (/server on) for custom sizes, counts and colors."],"autonomy":3,"applied":false}]],
