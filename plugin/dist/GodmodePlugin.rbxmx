		json = [[{"ok":true,"reply_markdown":"**Source:** `tool:animation` - a deterministic template generator chosen by the keyword router (confidence 1.00); this is not neural-model output. Verification: 3/3 checks passed.\n\n**crouch** animation `GodmodeCrouch` (looped, 1.60 s, priority Movement, speed x1, intensity x1): Crouch-sneak loop: low centre of mass, torso pitched forward, head up scanning, slow careful steps with arms ready.\n\nKeyframes: step_L, pass, step_R, pass, step_L.\n\nThe plugin builds a KeyframeSequence in `ReplicatedStorage.GodmodeAnimations`; the LocalScript in `StarterCharacterScripts` toggles it with **G** (Studio test via a temporary id; publish it and paste the asset id for live games).\n\n_Provenance: procedural keyframes designed from the reference video TITLES supplied by the user (the videos were not watched; no motion capture)._\n\n**Proposed only - nothing has been changed in Studio.** 2 action(s) await your approval in the plugin:\n- `a1` create_animation: Create crouch animation (looped, 1.60s)\n- `a2` create_script: Play GodmodeCrouch on the local character","source":"offline:tool:animation","intent":{"name":"animation","confidence":1.0,"router":"keyword-regex","params":{"style":"crouch"}},"actions":[{"type":"create_animation","description":"Create crouch animation (looped, 1.60s)","name":"GodmodeCrouch","parent_path":"ReplicatedStorage.GodmodeAnimations","rig":"R15","looped":true,"priority":"Movement","duration":1.6,"hierarchy":{"HumanoidRootPart":null,"LowerTorso":"HumanoidRootPart","UpperTorso":"LowerTorso","Head":"UpperTorso","LeftUpperArm":"UpperTorso","LeftLowerArm":"LeftUpperArm","LeftHand":"LeftLowerArm","RightUpperArm":"UpperTorso","RightLowerArm":"RightUpperArm","RightHand":"RightLowerArm","LeftUpperLeg":"LowerTorso","LeftLowerLeg":"LeftUpperLeg","LeftFoot":"LeftLowerLeg","RightUpperLeg":"LowerTorso","RightLowerLeg":"RightUpperLeg","RightFoot":"RightLowerLeg"},"joints":{"LowerTorso":"Root","UpperTorso":"Waist","Head":"Neck","LeftUpperArm":"LeftShoulder","LeftLowerArm":"LeftElbow","LeftHand":"LeftWrist","RightUpperArm":"RightShoulder","RightLowerArm":"RightElbow","RightHand":"RightWrist","LeftUpperLeg":"LeftHip","LeftLowerLeg":"LeftKnee","LeftFoot":"LeftAnkle","RightUpperLeg":"RightHip","RightLowerLeg":"RightKnee","RightFoot":"RightAnkle"},"keyframes":[{"time":0.0,"name":"step_L","easing_style":"Cubic","easing_direction":"InOut","poses":{"LowerTorso":{"rotation":[-20.0,-5.0,0.0],"position":[0.0,-1.0,0.0]},"UpperTorso":{"rotation":[-15.0,6.0,0.0],"position":[0.0,0.0,0.0]},"Head":{"rotation":[18.0,-4.0,0.0],"position":[0.0,0.0,0.0]},"LeftUpperArm":{"rotation":[15.0,0.0,-12.0],"position":[0.0,0.0,0.0]},"LeftLowerArm":{"rotation":[70.0,0.0,0.0],"position":[0.0,0.0,0.0]},"LeftHand":{"rotation":[0.0,0.0,0.0],"position":[0.0,0.0,0.0]},"RightUpperArm":{"rotation":[40.0,0.0,12.0],"position":[0.0,0.0,0.0]},"RightLowerArm":{"rotation":[75.0,0.0,0.0],"position":[0.0,0.0,0.0]},"RightHand":{"rotation":[0.0,0.0,0.0],"position":[0.0,0.0,0.0]},"LeftUpperLeg":{"rotation":[70.0,0.0,0.0],"position":[0.0,0.0,0.0]},"LeftLowerLeg":{"rotation":[-95.0,0.0,0.0],"position":[0.0,0.0,0.0]},"LeftFoot":{"rotation":[15.0,0.0,0.0],"position":[0.0,0.0,0.0]},"RightUpperLeg":{"rotation":[30.0,0.0,0.0],"position":[0.0,0.0,0.0]},"RightLowerLeg":{"rotation":[-110.0,0.0,0.0],"position":[0.0,0.0,0.0]},"RightFoot":{"rotation":[-10.0,0.0,0.0],"position":[0.0,0.0,0.0]}}},{"time":0.4,"name":"pass","easing_style":"Cubic","easing_direction":"InOut","poses":{"LowerTorso":{"rotation":[-20.0,0.0,0.0],"position":[0.0,-0.9,0.0]},"UpperTorso":{"rotation":[-15.0,0.0,0.0],"position":[0.0,0.0,0.0]},"Head":{"rotation":[18.0,0.0,0.0],"position":[0.0,0.0,0.0]},"LeftUpperArm":{"rotation":[28.0,0.0,-12.0],"position":[0.0,0.0,0.0]},"LeftLowerArm":{"rotation":[72.0,0.0,0.0],"position":[0.0,0.0,0.0]},"LeftHand":{"rotation":[0.0,0.0,0.0],"position":[0.0,0.0,0.0]},"RightUpperArm":{"rotation":[28.0,0.0,12.0],"position":[0.0,0.0,0.0]},"RightLowerArm":{