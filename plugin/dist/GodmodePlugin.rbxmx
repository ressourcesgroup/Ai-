		animation = false,
		json = [[{"ok":true,"reply_markdown":"**Source:** `tool:moving_platform` - a deterministic template generator chosen by the keyword router (confidence 1.00); this is not neural-model output. Verification: 3/3 checks passed.\n\nA moving platform that travels 20 studs sideways and back every 3 s (Sine InOut, infinite, reversing).\n\n**Proposed only - nothing has been changed in Studio.** 2 action(s) await your approval in the plugin:\n- `a1` create_instances: Create moving platform\n- `a2` create_script: Platform tween","source":"offline:tool:moving_platform","intent":{"name":"moving_platform","confidence":1.0,"router":"keyword-regex","params":{}},"actions":[{"type":"create_instances","description":"Create moving platform","parent_path":"Workspace","tree":{"className":"Model","name":"GodmodeMovingPlatform","properties":{},"children":[{"className":"Part","name":"Platform","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[10.0,1.0,10.0]},"CFrame":{"$type":"CFrame","position":[0.0,10.0,0.0],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[13,105,172]},"Material":{"$enum":"Material.Metal"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]}]},"destructive":false,"id":"a1","requires_approval":true},{"type":"create_script","description":"Platform tween","parent_path":"Workspace.GodmodeMovingPlatform","name":"PlatformMover","class":"Script","source":"-- Generated by GODMODE tool:moving_platform (deterministic template, verified by godmode.luau; not neural-model output)\n-- Moves the platform back and forth forever with TweenService (server-side, replicates to everyone).\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal platform = script.Parent:WaitForChild(\"Platform\")\nlocal TRAVEL = Vector3.new(20, 0, 0)\nlocal DURATION = 3.0\n\nlocal tween = TweenService:Create(\n\tplatform,\n\tTweenInfo.new(DURATION, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, 0.5),\n\t{ CFrame = platform.CFrame + TRAVEL }\n)\ntween:Play()\n\nscript.Destroying:Connect(function()\n\ttween:Cancel()\n\ttween:Destroy()\nend)\n","destructive":false,"id":"a2","requires_approval":true}],"verification":[{"check":"tree:Workspace.GodmodeMovingPlatform","ok":true,"detail":"2 instance(s), property encoding valid"},{"check":"structure:Workspace.GodmodeMovingPlatform.PlatformMover","ok":true,"detail":"balanced blocks/brackets, lexically valid"},{"check":"lint:Workspace.GodmodeMovingPlatform.PlatformMover","ok":true,"detail":"no findings"}],"warnings":["Tweening an anchored part's CFrame does not carry standing players along; for rideable platforms use an unanchored part with AlignPosition/PrismaticConstraint.","Offline mode: this is the default version of this build/script. Edit it after applying, or enable the optional GODMODE server (/server on) for custom sizes, counts and colors."],"autonomy":3,"applied":false}]],
