<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
  <Item class="Script" referent="RBX9FE3BA2F986A0489988264925B98C819">
    <Properties>
      <string name="Name">GodmodePlugin</string>
      <bool name="Disabled">false</bool>
      <ProtectedString name="Source"><![CDATA[--!strict
-- GODMODE Studio plugin entry point (packaged as the Script "GodmodePlugin";
-- every other module is a ModuleScript child of it).
--
-- Flow: user message -> POST /chat (with selection / open-script context and the
-- autonomy level) -> reply bubble + one ActionPreview card per proposed action ->
-- user clicks Apply -> ActionApplier applies it as one undo step -> the real
-- outcome (success or the exact error) is reported in the chat.
-- The server only proposes; only this plugin changes the place, and only on a click.

local ActionApplier = require(script.ActionApplier)
local ActionPreview = require(script.ActionPreview)
local ChatUI = require(script.ChatUI)
local Context = require(script.Context)
local HttpClient = require(script.HttpClient)
local OfflineEngine = require(script.OfflineEngine)
local Theme = require(script.Theme)
local Ui = require(script.Ui)

local PROTOCOL_VERSION = 1
local DEFAULT_URL = "http://127.0.0.1:8765"
local DEFAULT_AUTONOMY = 2
local HEALTH_INTERVAL = 30
local MAX_HISTORY = 20
local MAX_MESSAGE_CHARS = 8000

local SETTING_URL = "GodmodeServerUrl"
local SETTING_TOKEN = "GodmodeToken"
local SETTING_AUTONOMY = "GodmodeAutonomy"
local SETTING_THINKING = "GodmodeThinking"

local thisPlugin: Plugin = plugin

---------------------------------------------------------------------------
-- Settings (persisted per user with plugin:SetSetting)
---------------------------------------------------------------------------

local function readSetting(key: string): any
	local ok, value = pcall(function()
		return thisPlugin:GetSetting(key)
	end)
	return if ok then value else nil
end

local function writeSetting(key: string, value: any)
	pcall(function()
		thisPlugin:SetSetting(key, value)
	end)
end

local serverUrl: string = DEFAULT_URL
local storedUrl = readSetting(SETTING_URL)
if typeof(storedUrl) == "string" and storedUrl ~= "" then
	serverUrl = storedUrl
end

local token: string = ""
local storedToken = readSetting(SETTING_TOKEN)
if typeof(storedToken) == "string" then
	token = storedToken
end

local autonomy: number = DEFAULT_AUTONOMY
local storedAutonomy = readSetting(SETTING_AUTONOMY)
if typeof(storedAutonomy) == "number" and storedAutonomy >= 1 and storedAutonomy <= 5 then
	autonomy = math.floor(storedAutonomy)
end

local thinkingLevel: string = ChatUI.DEFAULT_THINKING
local storedThinking = readSetting(SETTING_THINKING)
for _, level in ipairs(ChatUI.THINKING_LEVELS) do
	if storedThinking == level.id then
		thinkingLevel = level.id
	end
end

-- Every request goes to the configured base URL (Settings > Server URL).
local client = HttpClient.new(serverUrl, token)

-- Offline by default: the built-in engine needs no server and no HTTP permission.
-- Settings > Mode (or `/server on|off` in the chat) switches to the optional GODMODE server.
local SETTING_USE_SERVER = "godmode_use_server"
local useServer = readSetting(SETTING_USE_SERVER) == true

---------------------------------------------------------------------------
-- Toolbar button + dock widget
---------------------------------------------------------------------------

local toolbar = thisPlugin:CreateToolbar("GODMODE")
local toggleButton = toolbar:CreateButton("GODMODE", "Open the GODMODE assistant", "", "GODMODE")
toggleButton.ClickableWhenViewportHidden = true

local widgetInfo = DockWidgetPluginGuiInfo.new(
	Enum.InitialDockState.Right,
	false, -- initially enabled
	false, -- override saved enabled state
	380, -- default width
	560, -- default height
	300, -- minimum width
	300 -- minimum height
)
local widget = thisPlugin:CreateDockWidgetPluginGui("GodmodeAssistant", widgetInfo)
widget.Title = "GODMODE"
widget.Name = "GodmodeAssistant"
widget.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

toggleButton:SetActive(widget.Enabled)
toggleButton.Click:Connect(function()
	widget.Enabled = not widget.Enabled
end)

---------------------------------------------------------------------------
-- Chat state
---------------------------------------------------------------------------

type HistoryEntry = { role: string, content: string }
local history: { HistoryEntry } = {}
local serverCompatible = true
local ui: ChatUI.ChatUI

local function pushHistory(role: string, content: string)
	table.insert(history, { role = role, content = content })
	while #history > MAX_HISTORY do
		table.remove(history, 1)
	end
end

local function trim(text: string): string
	return text:match("^%s*(.-)%s*$") or ""
end

local function isLocalUrl(url: string): boolean
	local host = url:match("^https?://([^/:]+)")
	return host == "127.0.0.1" or host == "localhost" or host == "[::1]"
end

local function hostOf(url: string): string
	return url:match("^https?://([^/]+)") or url
end

local function checkHealth()
	if not useServer then
		ui:setStatus("offline")
		return nil
	end
	ui:setStatus("checking")
	local response = client:get("/health")
	if not response.ok then
		serverCompatible = true -- unknown; let /chat report its own error
		ui:setStatus("unreachable", "Unreachable · " .. hostOf(serverUrl))
		return response.error
	end
	local body = response.body
	local protocol = if typeof(body) == "table" then body.protocol_version else nil
	if typeof(protocol) == "number" and protocol > PROTOCOL_VERSION then
		serverCompatible = false
		ui:setStatus("unreachable", "Protocol v" .. tostring(protocol))
		return "The server speaks protocol v" .. tostring(protocol)
			.. " but this plugin only understands v" .. tostring(PROTOCOL_VERSION) .. ". Update the plugin."
	end
	serverCompatible = true
	if typeof(body) == "table" then
		-- Optional: tooltips for the thinking picker.
		ui:setThinkingLevels(body.thinking_levels)
	end
	ui:setStatus("online", "Online · " .. hostOf(serverUrl))
	return nil
end

local function verifySource(source: string): (boolean, string)
	if not useServer then
		return true, "Offline mode: this script was already verified (structure + security lint) when the plugin was built. "
			.. "Re-verifying edited code needs the optional server (/server on)."
	end
	local response = client:post("/verify", { source = source })
	if not response.ok then
		return false, "Verification request failed: " .. tostring(response.error)
	end
	local body = response.body
	local lines: { string } = {}
	if typeof(body.verification) == "table" then
		for _, entry in ipairs(body.verification) do
			if typeof(entry) == "table" then
				table.insert(lines, (if entry.ok == true then "PASS " else "FAIL ") .. tostring(entry.check)
					.. (if typeof(entry.detail) == "string" then " - " .. entry.detail else ""))
			end
		end
	end
	if typeof(body.lint) == "table" then
		for _, finding in ipairs(body.lint) do
			if typeof(finding) == "table" then
				table.insert(lines, string.format("  %s %s line %s: %s", tostring(finding.rule), tostring(finding.severity),
					tostring(finding.line), tostring(finding.message)))
			end
		end
	end
	local passed = body.passed == true
	return passed, (if passed then "Verifier (/verify): passed" else "Verifier (/verify): not passed")
		.. (if #lines > 0 then "\n" .. table.concat(lines, "\n") else "")
end

local function reportResult(action: any, result: ActionApplier.Result)
	local label = tostring(action.type) .. " " .. ActionApplier.targetPath(action)
	if result.ok then
		ui:addNotice("success", "Applied " .. label .. ": " .. result.message)
	else
		ui:addNotice("error", "Did NOT apply " .. label .. ": " .. result.message)
	end
end

local function showActions(actions: { any }, verification: { any })
	local cards: { ActionPreview.Card } = {}
	for _, action in ipairs(actions) do
		local card = ActionPreview.new(action, {
			verification = verification,
			onApply = ActionApplier.apply,
			onVerify = verifySource,
			onResult = reportResult,
		})
		ui:append(card.frame)
		table.insert(cards, card)
	end

	-- Autonomy 4-5: the server marks safe actions requires_approval=false; the
	-- protocol allows applying those together after ONE confirmation click.
	local batchable = 0
	for _, card in ipairs(cards) do
		if card:isBatchable() then
			batchable += 1
		end
	end
	if autonomy >= 4 and batchable > 0 then
		local row = Ui.create("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 26),
		}, { Ui.hlist(6) }) :: Frame
		local applyAll = Ui.button("Apply " .. tostring(batchable) .. " safe action(s) in order", "primary", 240)
		applyAll.Parent = row
		ui:append(row)
		applyAll.MouseButton1Click:Connect(function()
			applyAll:Destroy()
			local applied, failed = 0, false
			for _, card in ipairs(cards) do
				if card:isBatchable() then
					local result = card:apply()
					if result and result.ok then
						applied += 1
					elseif result then
						failed = true
						break
					end
				end
			end
			if failed then
				ui:addNotice("error", "Batch stopped after a failure: " .. tostring(applied)
					.. " action(s) applied, the rest were NOT applied (they may depend on the failed one).")
			else
				ui:addNotice("success", "Batch finished: " .. tostring(applied) .. " action(s) applied. Destructive actions (if any) still need their own confirmation.")
			end
		end)
	end
end

-- "Insert" on a code panel: create a Script from the block through the normal
-- ActionApplier path (one undo step), then report the real outcome.
local function insertSnippet(code: string, _language: string?)
	local action = {
		type = "create_script",
		class = "Script",
		name = "GodmodeSnippet",
		parent_path = "ServerScriptService",
		source = code,
	}
	reportResult(action, ActionApplier.apply(action))
end

local function setMode(mode: ChatUI.Mode)
	useServer = mode == "online"
	writeSetting(SETTING_USE_SERVER, useServer)
	ui:setMode(mode)
	task.spawn(function()
		local err = checkHealth()
		if err then
			ui:addNotice("warning", "Online mode, but the server did not answer: " .. tostring(err) .. " Replies will come from the offline engine until it does.")
		end
	end)
end

local function sendMessage(text: string)
	if #text > MAX_MESSAGE_CHARS then
		ui:addNotice("error", "Message is too long (" .. tostring(#text) .. " characters; the limit is " .. tostring(MAX_MESSAGE_CHARS) .. ").")
		return
	end
	local command = string.lower(text):match("^/server%s+(%a+)$")
	if command == "on" or command == "off" then
		useServer = command == "on"
		writeSetting(SETTING_USE_SERVER, useServer)
		ui:setMode(if useServer then "online" else "offline")
		ui:addNotice("info", if useServer
			then "Online mode: using the GODMODE server at " .. serverUrl .. " (start it with `python -m godmode.server`). Falls back to offline if unreachable."
			else "Offline mode: built-in tools and animations, no server needed.")
		task.spawn(checkHealth)
		return
	end
	if useServer and not serverCompatible then
		ui:addNotice("error", "This plugin is too old for the connected server's protocol version. Update the plugin.")
		return
	end
	ui:addUserMessage(text)
	ui:setBusy(true)
	local historySnapshot = table.clone(history)
	pushHistory("user", text)

	task.spawn(function()
		local payload = {
			message = text,
			history = historySnapshot,
			context = Context.collect(),
			autonomy = autonomy,
			thinking = thinkingLevel,
		}
		local response
		if useServer then
			response = client:post("/chat", payload)
			if not response.ok then
				ui:addNotice("warning", "Server unreachable (" .. tostring(response.error) .. "); answering offline.")
				response = { ok = true, body = OfflineEngine.chat(payload) }
			end
		else
			response = { ok = true, body = OfflineEngine.chat(payload) }
		end
		ui:setBusy(false)
		if not useServer then
			ui:setStatus("offline")
		end
		local body = response.body
		local reply = if typeof(body.reply_markdown) == "string" then body.reply_markdown else "(empty reply)"
		local verification = if typeof(body.verification) == "table" then body.verification else {}
		ui:addAssistantMessage(reply, {
			-- Rendered only when the reply carries a thinking object.
			thinking = body.thinking,
			source = if typeof(body.source) == "string" then body.source else nil,
			verification = verification,
			onInsert = insertSnippet,
		})
		pushHistory("assistant", reply)
		if typeof(body.warnings) == "table" then
			for _, warning in ipairs(body.warnings) do
				ui:addNotice("warning", "Warning: " .. tostring(warning))
			end
		end
		local actions = if typeof(body.actions) == "table" then body.actions else {}
		if #actions > 0 then
			showActions(actions, verification)
		end
	end)
end

ui = ChatUI.new(widget, {
	onSend = sendMessage,
	onAutonomyChanged = function(level: number)
		autonomy = level
		writeSetting(SETTING_AUTONOMY, level)
	end,
	onThinkingChanged = function(id: string)
		thinkingLevel = id
		writeSetting(SETTING_THINKING, id)
	end,
	onModeChanged = setMode,
	onSaveSettings = function(url: string, newToken: string)
		serverUrl = HttpClient.normaliseUrl(if trim(url) ~= "" then trim(url) else DEFAULT_URL)
		token = trim(newToken)
		writeSetting(SETTING_URL, serverUrl)
		writeSetting(SETTING_TOKEN, token)
		client = HttpClient.new(serverUrl, token)
		if not isLocalUrl(serverUrl) then
			ui:setTestResult("warning", "Saved. " .. serverUrl .. " is not on this computer: your messages, open script and token will be sent there.")
		end
		task.spawn(checkHealth)
	end,
	onTestConnection = function(url: string, testToken: string)
		local target = HttpClient.normaliseUrl(if trim(url) ~= "" then trim(url) else DEFAULT_URL)
		task.spawn(function()
			local response = HttpClient.new(target, trim(testToken), 10):get("/health")
			if not response.ok then
				ui:setTestResult("error", "Could not reach " .. target .. "/health: " .. tostring(response.error))
				return
			end
			local body = response.body
			if typeof(body) ~= "table" then
				ui:setTestResult("error", target .. "/health answered, but not with JSON.")
				return
			end
			local version = if body.version ~= nil then tostring(body.version) else "unknown"
			local loaded = typeof(body.model) == "table" and body.model.loaded == true
			local protocol = if typeof(body.protocol_version) == "number" then tostring(body.protocol_version) else "?"
			ui:setTestResult(if loaded then "success" else "warning", "Connected. Server version " .. version
				.. " · protocol v" .. protocol .. " · model loaded: " .. (if loaded then "yes" else "no (rule-based replies only)")
				.. (if isLocalUrl(target) then "" else "\nThis host is not on this computer."))
			ui:setThinkingLevels(body.thinking_levels)
		end)
	end,
	onRefreshStatus = function()
		task.spawn(function()
			local err = checkHealth()
			if err then
				ui:addNotice("error", err)
			end
		end)
	end,
	onNewChat = function()
		ui:clear()
		table.clear(history)
	end,
}, {
	url = serverUrl,
	token = token,
	autonomy = autonomy,
	thinking = thinkingLevel,
	mode = if useServer then "online" else "offline",
})

---------------------------------------------------------------------------
-- Lifecycle: health polling while the widget is open
---------------------------------------------------------------------------

local running = true
local lastHealth = 0

local function onEnabledChanged()
	toggleButton:SetActive(widget.Enabled)
	if widget.Enabled then
		lastHealth = os.clock()
		task.spawn(function()
			local err = checkHealth()
			if err then
				ui:addNotice("error", err)
			end
		end)
	end
end

widget:GetPropertyChangedSignal("Enabled"):Connect(onEnabledChanged)
if widget.Enabled then
	onEnabledChanged()
end

task.spawn(function()
	while running do
		task.wait(5)
		if running and widget.Enabled and os.clock() - lastHealth >= HEALTH_INTERVAL then
			lastHealth = os.clock()
			checkHealth()
		end
	end
end)

thisPlugin.Unloading:Connect(function()
	running = false
	Theme.destroy()
end)
]]></ProtectedString>
    </Properties>
    <Item class="ModuleScript" referent="RBXB51BC9B3C2E2D24960A8A16F68A975AA">
      <Properties>
        <string name="Name">ActionApplier</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- ActionApplier: applies the declarative actions from docs/PLUGIN_PROTOCOL.md.
--
-- * Each action is applied inside ChangeHistoryService:TryBeginRecording /
--   FinishRecording, so it is exactly one undo step. Success => Commit;
--   any error => Cancel (Studio reverts everything done during the recording).
-- * Nothing received from the server is ever executed. Scripts are created with
--   their source as plain text; instances are built from a fixed allow-list of
--   value types (PropertyDecoder); paths are limited to normal game services
--   (PathResolver).
-- * Every call returns a Result describing exactly what happened. Callers must
--   report `ok = false` results as failures, never as success.

local ChangeHistoryService = game:GetService("ChangeHistoryService")
local CollectionService = game:GetService("CollectionService")
local Selection = game:GetService("Selection")

local PathResolver = require(script.Parent.PathResolver)
local PropertyDecoder = require(script.Parent.PropertyDecoder)

local ActionApplier = {}

export type Result = {
	ok: boolean,
	message: string,
	created: Instance?,
	previewId: string?,
}

ActionApplier.SUPPORTED_ACTIONS = {
	"create_script",
	"edit_script",
	"create_instances",
	"create_animation",
	"delete_instance",
}

local SCRIPT_CLASSES = { Script = true, LocalScript = true, ModuleScript = true } :: { [string]: boolean }
local EASING_STYLES = {
	Linear = true,
	Constant = true,
	Cubic = true,
	Elastic = true,
	Bounce = true,
	CubicV2 = true,
} :: { [string]: boolean }
local EASING_DIRECTIONS = { In = true, Out = true, InOut = true } :: { [string]: boolean }
local ANIMATION_ROOT = "HumanoidRootPart"
local DEFAULT_ANIMATION_PARENT = "ServerStorage.GodmodeAnimations"
local MAX_TREE_NODES = 5000
local MAX_TREE_DEPTH = 50
local MAX_SOURCE_LENGTH = 1000000

-- Properties set first / last when building instances. JSONDecode does not keep
-- object key order, so the protocol's "Size before CFrame" rule is enforced here.
local FIRST_PROPERTIES = { "Shape", "Size" }
local LAST_PROPERTIES = { "CFrame", "Position", "Orientation", "Rotation", "PivotOffset" }

local function fail(message: string): Result
	return { ok = false, message = message, created = nil, previewId = nil }
end

local function succeed(message: string, created: Instance?, previewId: string?): Result
	return { ok = true, message = message, created = created, previewId = previewId }
end

-- Destructive actions always require an explicit confirmation in the UI.
function ActionApplier.isDestructive(action: any): boolean
	return typeof(action) == "table" and (action.type == "delete_instance" or action.destructive == true)
end

-- Best-effort target path for display.
function ActionApplier.targetPath(action: any): string
	if typeof(action) ~= "table" then
		return "?"
	end
	if typeof(action.path) == "string" then
		return action.path
	end
	local parentPath = action.parent_path
	if action.type == "create_animation" and parentPath == nil then
		parentPath = DEFAULT_ANIMATION_PARENT
	end
	local name = action.name
	if action.type == "create_instances" and typeof(action.tree) == "table" then
		name = action.tree.name
	end
	if typeof(parentPath) == "string" and typeof(name) == "string" then
		return parentPath .. "." .. name
	end
	if typeof(parentPath) == "string" then
		return parentPath
	end
	return "?"
end

---------------------------------------------------------------------------
-- Script source helpers
---------------------------------------------------------------------------

local function readSource(container: LuaSourceContainer): string
	local ok, source = pcall(function()
		return game:GetService("ScriptEditorService"):GetEditorSource(container)
	end)
	if ok and typeof(source) == "string" then
		return source
	end
	return (container :: any).Source
end

-- Write source through ScriptEditorService when available (keeps open editor
-- tabs in sync), falling back to the Source property. Returns an error or nil.
local function writeSource(container: LuaSourceContainer, source: string): string?
	local editorOk, editorErr = pcall(function()
		local ScriptEditorService = game:GetService("ScriptEditorService")
		ScriptEditorService:UpdateSourceAsync(container, function(_old: string): string
			return source
		end)
	end)
	if not editorOk then
		local propertyOk, propertyErr = pcall(function()
			(container :: any).Source = source
		end)
		if not propertyOk then
			return "could not set source (ScriptEditorService: " .. tostring(editorErr) .. "; Source: " .. tostring(propertyErr) .. ")"
		end
	end
	if readSource(container) ~= source then
		return "source did not update (the script may be locked by Team Create or another editor)"
	end
	return nil
end

local function checkSource(source: any): string?
	if typeof(source) ~= "string" then
		return "source must be a string"
	end
	if #source > MAX_SOURCE_LENGTH then
		return "source is too large"
	end
	return nil
end

---------------------------------------------------------------------------
-- Handlers. Each returns a Result; errors raised inside are caught by apply().
---------------------------------------------------------------------------

local function createScript(action: any): Result
	local className = action.class
	if typeof(className) ~= "string" or not SCRIPT_CLASSES[className] then
		return fail("class must be Script, LocalScript or ModuleScript (got " .. tostring(className) .. ")")
	end
	local okName, nameErr = PathResolver.validName(action.name)
	if not okName then
		return fail(nameErr :: string)
	end
	local sourceErr = checkSource(action.source)
	if sourceErr then
		return fail(sourceErr)
	end
	local parent, err = PathResolver.resolve(action.parent_path)
	if parent == nil then
		return fail("parent_path: " .. tostring(err))
	end

	local name = PathResolver.uniqueName(parent, action.name)
	local container = Instance.new(className) :: LuaSourceContainer
	container.Name = name
	container.Parent = parent
	local writeErr = writeSource(container, action.source)
	if writeErr then
		container:Destroy()
		return fail(writeErr)
	end
	local note = if name ~= action.name then " (renamed: '" .. action.name .. "' already existed)" else ""
	return succeed(
		"created " .. className .. " " .. (PathResolver.pathOf(container) or name) .. note,
		container
	)
end

local function editScript(action: any): Result
	local sourceErr = checkSource(action.new_source)
	if sourceErr then
		return fail("new_source: " .. sourceErr)
	end
	local target, err = PathResolver.resolve(action.path)
	if target == nil then
		return fail("path: " .. tostring(err))
	end
	if not SCRIPT_CLASSES[target.ClassName] then
		return fail(tostring(action.path) .. " is a " .. target.ClassName .. ", not a script")
	end
	local container = target :: LuaSourceContainer
	local writeErr = writeSource(container, action.new_source)
	if writeErr then
		return fail(writeErr)
	end
	return succeed("replaced the source of " .. tostring(action.path), container)
end

local function orderedPropertyNames(properties: { [string]: any }): { string }
	local first: { string } = {}
	local middle: { string } = {}
	local last: { string } = {}
	for _, name in ipairs(FIRST_PROPERTIES) do
		if properties[name] ~= nil then
			table.insert(first, name)
		end
	end
	for name in pairs(properties) do
		if typeof(name) == "string" and not table.find(FIRST_PROPERTIES, name) and not table.find(LAST_PROPERTIES, name) then
			table.insert(middle, name)
		end
	end
	table.sort(middle)
	for _, name in ipairs(LAST_PROPERTIES) do
		if properties[name] ~= nil then
			table.insert(last, name)
		end
	end
	local ordered = first
	for _, name in ipairs(middle) do
		table.insert(ordered, name)
	end
	for _, name in ipairs(last) do
		table.insert(ordered, name)
	end
	return ordered
end

type BuildState = { count: number }

-- Build an unparented instance tree. Returns the root or an error.
local function buildNode(node: any, depth: number, state: BuildState, path: string): (Instance?, string?)
	if typeof(node) ~= "table" then
		return nil, path .. ": node must be an object"
	end
	if depth > MAX_TREE_DEPTH then
		return nil, path .. ": tree is deeper than " .. tostring(MAX_TREE_DEPTH)
	end
	state.count += 1
	if state.count > MAX_TREE_NODES then
		return nil, "tree has more than " .. tostring(MAX_TREE_NODES) .. " nodes"
	end
	if typeof(node.className) ~= "string" then
		return nil, path .. ": className is required"
	end
	local okName, nameErr = PathResolver.validName(node.name)
	if not okName then
		return nil, path .. ": " .. tostring(nameErr)
	end
	local nodePath = path .. "." .. node.name

	local created, instanceOrErr = pcall(function()
		return Instance.new(node.className)
	end)
	if not created then
		return nil, nodePath .. ": cannot create class '" .. node.className .. "' (" .. tostring(instanceOrErr) .. ")"
	end
	local instance = instanceOrErr :: Instance
	instance.Name = node.name

	local function abort(message: string): (Instance?, string?)
		instance:Destroy()
		return nil, message
	end

	if node.properties ~= nil then
		if typeof(node.properties) ~= "table" then
			return abort(nodePath .. ": properties must be an object")
		end
		for _, property in ipairs(orderedPropertyNames(node.properties)) do
			local propErr = PropertyDecoder.apply(instance, property, node.properties[property])
			if propErr then
				return abort(nodePath .. ": " .. propErr)
			end
		end
	end

	if node.attributes ~= nil then
		if typeof(node.attributes) ~= "table" then
			return abort(nodePath .. ": attributes must be an object")
		end
		for attrName, attrValue in pairs(node.attributes) do
			local attrErr = PropertyDecoder.applyAttribute(instance, attrName, attrValue)
			if attrErr then
				return abort(nodePath .. ": " .. attrErr)
			end
		end
	end

	if node.tags ~= nil then
		if typeof(node.tags) ~= "table" then
			return abort(nodePath .. ": tags must be an array of strings")
		end
		for _, tag in ipairs(node.tags) do
			if typeof(tag) ~= "string" or tag == "" then
				return abort(nodePath .. ": tags must be non-empty strings")
			end
			CollectionService:AddTag(instance, tag)
		end
	end

	if node.children ~= nil then
		if typeof(node.children) ~= "table" then
			return abort(nodePath .. ": children must be an array")
		end
		for _, childNode in ipairs(node.children) do
			local child, childErr = buildNode(childNode, depth + 1, state, nodePath)
			if child == nil then
				return abort(tostring(childErr))
			end
			child.Parent = instance
		end
	end

	return instance, nil
end

local function createInstances(action: any): Result
	local parent, err = PathResolver.resolve(action.parent_path)
	if parent == nil then
		return fail("parent_path: " .. tostring(err))
	end
	local state: BuildState = { count = 0 }
	local root, buildErr = buildNode(action.tree, 1, state, tostring(action.parent_path))
	if root == nil then
		return fail(tostring(buildErr))
	end
	local requested = root.Name
	root.Name = PathResolver.uniqueName(parent, requested)
	root.Parent = parent -- Parent is always set last.
	local note = if root.Name ~= requested then " (renamed: '" .. requested .. "' already existed)" else ""
	return succeed(
		"created " .. root.ClassName .. " " .. (PathResolver.pathOf(root) or root.Name)
			.. " with " .. tostring(state.count) .. " instance(s)" .. note,
		root
	)
end

---------------------------------------------------------------------------
-- Animation
---------------------------------------------------------------------------

local function vector3Of(value: any, label: string): (Vector3?, string?)
	if value == nil then
		return Vector3.zero, nil
	end
	if typeof(value) ~= "table" or #value ~= 3 then
		return nil, label .. " must be [x, y, z]"
	end
	for i = 1, 3 do
		if typeof(value[i]) ~= "number" or value[i] ~= value[i] or math.abs(value[i]) > 1e6 then
			return nil, label .. "[" .. tostring(i) .. "] is not a finite number"
		end
	end
	return Vector3.new(value[1], value[2], value[3]), nil
end

-- Pose CFrame per protocol: CFrame.new(position) * CFrame.Angles(rad X, rad Y, rad Z)
-- (X, then Y, then Z), in the joint's Motor6D space.
local function poseCFrame(pose: any, label: string): (CFrame?, string?)
	local rotation, rotErr = vector3Of(pose.rotation, label .. ".rotation")
	if rotation == nil then
		return nil, rotErr
	end
	local position, posErr = vector3Of(pose.position, label .. ".position")
	if position == nil then
		return nil, posErr
	end
	return CFrame.new(position.X, position.Y, position.Z)
		* CFrame.Angles(math.rad(rotation.X), math.rad(rotation.Y), math.rad(rotation.Z)), nil
end

local function easingStyle(name: any, fallback: Enum.PoseEasingStyle): (Enum.PoseEasingStyle?, string?)
	if name == nil then
		return fallback, nil
	end
	if typeof(name) ~= "string" or not EASING_STYLES[name] then
		return nil, "unsupported easing_style: " .. tostring(name)
	end
	return (Enum.PoseEasingStyle :: any)[name], nil
end

local function easingDirection(name: any, fallback: Enum.PoseEasingDirection): (Enum.PoseEasingDirection?, string?)
	if name == nil then
		return fallback, nil
	end
	if typeof(name) ~= "string" or not EASING_DIRECTIONS[name] then
		return nil, "unsupported easing_direction: " .. tostring(name)
	end
	return (Enum.PoseEasingDirection :: any)[name], nil
end

-- A part is a hierarchy root when it has no parent entry. JSON `null` values vanish
-- in JSONDecode, so `{"HumanoidRootPart": null}` and a missing key look the same;
-- only HumanoidRootPart or a part that is itself used as a parent may be a root.
local function isRootPart(part: string, hierarchy: { [string]: any }): boolean
	if hierarchy[part] ~= nil then
		return false
	end
	if part == ANIMATION_ROOT then
		return true
	end
	for _, parentName in pairs(hierarchy) do
		if parentName == part then
			return true
		end
	end
	return false
end

local function buildKeyframe(frame: any, index: number, hierarchy: { [string]: any }): (Keyframe?, string?)
	local label = "keyframes[" .. tostring(index) .. "]"
	if typeof(frame) ~= "table" then
		return nil, label .. " must be an object"
	end
	if typeof(frame.time) ~= "number" or frame.time ~= frame.time or frame.time < 0 or frame.time > 3600 then
		return nil, label .. ".time must be a number >= 0"
	end
	local defaultStyle, styleErr = easingStyle(frame.easing_style, Enum.PoseEasingStyle.Linear)
	if defaultStyle == nil then
		return nil, label .. ": " .. tostring(styleErr)
	end
	local defaultDirection, dirErr = easingDirection(frame.easing_direction, Enum.PoseEasingDirection.In)
	if defaultDirection == nil then
		return nil, label .. ": " .. tostring(dirErr)
	end
	if typeof(frame.poses) ~= "table" then
		return nil, label .. ".poses must be an object"
	end

	local keyframe = Instance.new("Keyframe")
	keyframe.Time = frame.time
	keyframe.Name = if typeof(frame.name) == "string" and frame.name ~= "" then frame.name else "Keyframe"

	local poses: { [string]: Pose } = {}

	local function abort(message: string): (Keyframe?, string?)
		keyframe:Destroy()
		return nil, message
	end

	-- Create (or fetch) the Pose for `part`, creating its ancestors first.
	local function ensurePose(part: string, depth: number): (Pose?, string?)
		local existing = poses[part]
		if existing then
			return existing, nil
		end
		if depth > 64 then
			return nil, "hierarchy has a cycle near '" .. part .. "'"
		end
		local okName, nameErr = PathResolver.validName(part)
		if not okName then
			return nil, "pose part: " .. tostring(nameErr)
		end
		local parentInstance: Instance
		if isRootPart(part, hierarchy) then
			parentInstance = keyframe
		else
			local parentPart = hierarchy[part]
			if typeof(parentPart) ~= "string" then
				return nil, "part '" .. part .. "' is not in the hierarchy map"
			end
			local parentPose, parentErr = ensurePose(parentPart, depth + 1)
			if parentPose == nil then
				return nil, parentErr
			end
			parentInstance = parentPose
		end
		local pose = Instance.new("Pose")
		pose.Name = part -- R15 convention: Pose named after the part.
		pose.CFrame = CFrame.identity
		-- Structural (ancestor-only) poses carry no influence; posed parts get Weight = 1.
		pose.Weight = 0
		pose.EasingStyle = defaultStyle :: Enum.PoseEasingStyle
		pose.EasingDirection = defaultDirection :: Enum.PoseEasingDirection
		pose.Parent = parentInstance
		poses[part] = pose
		return pose, nil
	end

	-- Sort part names so construction is deterministic.
	local partNames: { string } = {}
	for part in pairs(frame.poses) do
		if typeof(part) ~= "string" then
			return abort(label .. ".poses keys must be part names")
		end
		table.insert(partNames, part)
	end
	table.sort(partNames)

	for _, part in ipairs(partNames) do
		local spec = frame.poses[part]
		if typeof(spec) ~= "table" then
			return abort(label .. ".poses." .. part .. " must be an object")
		end
		local pose, poseErr = ensurePose(part, 0)
		if pose == nil then
			return abort(label .. ": " .. tostring(poseErr))
		end
		if isRootPart(part, hierarchy) and part == ANIMATION_ROOT then
			-- Protocol: the root HumanoidRootPart pose is always identity.
			pose.CFrame = CFrame.identity
		else
			local cf, cfErr = poseCFrame(spec, label .. ".poses." .. part)
			if cf == nil then
				return abort(tostring(cfErr))
			end
			pose.CFrame = cf
		end
		pose.Weight = 1
		local style, sErr = easingStyle(spec.easing_style, defaultStyle :: Enum.PoseEasingStyle)
		if style == nil then
			return abort(label .. ".poses." .. part .. ": " .. tostring(sErr))
		end
		local direction, dErr = easingDirection(spec.easing_direction, defaultDirection :: Enum.PoseEasingDirection)
		if direction == nil then
			return abort(label .. ".poses." .. part .. ": " .. tostring(dErr))
		end
		pose.EasingStyle = style
		pose.EasingDirection = direction
	end

	return keyframe, nil
end

local function createAnimation(action: any): Result
	local okName, nameErr = PathResolver.validName(action.name)
	if not okName then
		return fail("name: " .. tostring(nameErr))
	end
	if action.rig ~= nil and action.rig ~= "R15" then
		return fail("only R15 rigs are supported (got " .. tostring(action.rig) .. ")")
	end
	if typeof(action.keyframes) ~= "table" or #action.keyframes == 0 then
		return fail("keyframes must be a non-empty array")
	end
	local hierarchy = action.hierarchy
	if hierarchy == nil then
		hierarchy = {}
	elseif typeof(hierarchy) ~= "table" then
		return fail("hierarchy must be an object")
	end

	local priority: Enum.AnimationPriority = Enum.AnimationPriority.Core
	if action.priority ~= nil then
		local found = false
		for _, item in ipairs(Enum.AnimationPriority:GetEnumItems()) do
			if item.Name == action.priority then
				priority = item :: any
				found = true
			end
		end
		if not found then
			return fail("unknown priority: " .. tostring(action.priority))
		end
	end

	local sequence = Instance.new("KeyframeSequence")
	sequence.Name = action.name
	sequence.Loop = action.looped == true
	sequence.Priority = priority

	local keyframes: { Keyframe } = {}
	for index, frame in ipairs(action.keyframes) do
		local keyframe, err = buildKeyframe(frame, index, hierarchy)
		if keyframe == nil then
			sequence:Destroy()
			return fail(tostring(err))
		end
		keyframe.Parent = sequence
		table.insert(keyframes, keyframe)
	end

	if action.markers ~= nil then
		if typeof(action.markers) ~= "table" then
			sequence:Destroy()
			return fail("markers must be an array")
		end
		for index, marker in ipairs(action.markers) do
			if typeof(marker) ~= "table" or typeof(marker.time) ~= "number" or typeof(marker.name) ~= "string" then
				sequence:Destroy()
				return fail("markers[" .. tostring(index) .. "] needs a numeric time and a string name")
			end
			-- Attach to the keyframe at or just before `time` (earliest keyframe as fallback).
			local target: Keyframe? = nil
			for _, keyframe in ipairs(keyframes) do
				if keyframe.Time <= marker.time and (target == nil or keyframe.Time >= (target :: Keyframe).Time) then
					target = keyframe
				end
			end
			if target == nil then
				target = keyframes[1]
				for _, keyframe in ipairs(keyframes) do
					if keyframe.Time < (target :: Keyframe).Time then
						target = keyframe
					end
				end
			end
			local keyframeMarker = Instance.new("KeyframeMarker")
			keyframeMarker.Name = marker.name
			keyframeMarker.Value = if typeof(marker.value) == "string" then marker.value else ""
			;(target :: Keyframe):AddMarker(keyframeMarker)
		end
	end

	local parentPath = if action.parent_path ~= nil then action.parent_path else DEFAULT_ANIMATION_PARENT
	local parent, parentErr = PathResolver.resolveOrCreateFolders(parentPath)
	if parent == nil then
		sequence:Destroy()
		return fail("parent_path: " .. tostring(parentErr))
	end
	sequence.Name = PathResolver.uniqueName(parent, action.name)
	sequence.Parent = parent

	-- Optional local preview id (not an uploaded asset). Failure is reported, not fatal.
	local previewId: string? = nil
	local previewOk, previewResult = pcall(function()
		return game:GetService("AnimationClipProvider"):RegisterKeyframeSequence(sequence)
	end)
	if previewOk and typeof(previewResult) == "string" then
		previewId = previewResult
	end

	local message = "created KeyframeSequence " .. (PathResolver.pathOf(sequence) or sequence.Name)
		.. " (" .. tostring(#keyframes) .. " keyframes, Loop=" .. tostring(sequence.Loop)
		.. ", Priority=" .. priority.Name .. ")"
	if previewId then
		message ..= "; preview id " .. previewId .. " (local to this Studio session; publish it to get a real asset id)"
	else
		message ..= "; could not register a preview id (" .. tostring(previewResult) .. ")"
	end
	return succeed(message, sequence, previewId)
end

local function deleteInstance(action: any): Result
	if typeof(action.path) ~= "string" then
		return fail("path must be a string")
	end
	if PathResolver.isServiceRoot(action.path) then
		return fail("refusing to delete a service: " .. action.path)
	end
	local target, err = PathResolver.resolve(action.path)
	if target == nil then
		return fail("path: " .. tostring(err))
	end
	local descendants = #target:GetDescendants()
	-- Parent = nil (rather than Destroy) keeps the instance restorable with Undo.
	target.Parent = nil
	return succeed("deleted " .. action.path .. " (" .. tostring(descendants) .. " descendant(s)); use Undo to restore it", nil)
end

local HANDLERS: { [string]: (any) -> Result } = {
	create_script = createScript,
	edit_script = editScript,
	create_instances = createInstances,
	create_animation = createAnimation,
	delete_instance = deleteInstance,
}

-- Apply one action as a single undo step. Never throws.
function ActionApplier.apply(action: any): Result
	if typeof(action) ~= "table" then
		return fail("action must be an object")
	end
	local handler = HANDLERS[action.type]
	if handler == nil then
		return fail("unsupported action type: " .. tostring(action.type))
	end

	local description = if typeof(action.description) == "string" then action.description else action.type
	local recording = ChangeHistoryService:TryBeginRecording("GODMODE: " .. action.type, "GODMODE: " .. description)
	if recording == nil then
		return fail("Studio refused to start an undo recording (another plugin is recording, or playtest is running); nothing was changed")
	end

	local ok, result = pcall(handler, action)
	if ok and result.ok then
		ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
		if result.created and result.created.Parent ~= nil then
			pcall(function()
				Selection:Set({ result.created :: Instance })
			end)
		end
		return result
	end

	-- Cancel reverts everything done during the recording.
	ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Cancel)
	if not ok then
		return fail("error while applying (changes reverted): " .. tostring(result))
	end
	return fail(result.message .. " (nothing was changed)")
end

return ActionApplier
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBXA24B48260AA30EB1C232B47E6A1CE036">
      <Properties>
        <string name="Name">ActionPreview</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- ActionPreview: one card per proposed action, with Apply / Discard buttons.
--
-- Cards show the action type, target path, a summary (script preview, diff,
-- instance outline, animation summary) and the server's verification results.
-- Destructive actions are shown with a red warning and need a second, explicit
-- "Confirm delete" click. Nothing is applied without a user click.

local Theme = require(script.Parent.Theme)
local Ui = require(script.Parent.Ui)
local PathResolver = require(script.Parent.PathResolver)
local ActionApplier = require(script.Parent.ActionApplier)

local ActionPreview = {}
ActionPreview.__index = ActionPreview

local PREVIEW_LINES = 20
local DIFF_LINES = 40
local OUTLINE_LINES = 30

export type CardState = "pending" | "applying" | "applied" | "failed" | "discarded"

export type Options = {
	verification: { any },
	onApply: (action: any) -> ActionApplier.Result,
	onVerify: ((source: string) -> (boolean, string))?,
	onResult: (action: any, result: ActionApplier.Result) -> (),
}

type CardData = {
	action: any,
	frame: Frame,
	buttons: Frame,
	status: TextLabel,
	state: CardState,
	options: Options,
}

export type Card = typeof(setmetatable({} :: CardData, ActionPreview))

local TYPE_TITLES = {
	create_script = "Create script",
	edit_script = "Edit script",
	create_instances = "Create instances",
	create_animation = "Create animation",
	delete_instance = "Delete instance",
} :: { [string]: string }

---------------------------------------------------------------------------
-- Summaries
---------------------------------------------------------------------------

-- Line diff by trimming the common prefix and suffix; good enough to show what an
-- edit_script replaces without a full LCS.
function ActionPreview.diff(oldSource: string, newSource: string, maxLines: number): (string, number, number)
	local old = string.split(oldSource, "\n")
	local new = string.split(newSource, "\n")
	local prefix = 0
	while prefix < #old and prefix < #new and old[prefix + 1] == new[prefix + 1] do
		prefix += 1
	end
	local suffix = 0
	while suffix < #old - prefix and suffix < #new - prefix and old[#old - suffix] == new[#new - suffix] do
		suffix += 1
	end
	local lines: { string } = {}
	local removed, added = 0, 0
	table.insert(lines, "@@ line " .. tostring(prefix + 1) .. " @@")
	for i = prefix + 1, #old - suffix do
		removed += 1
		table.insert(lines, "- " .. old[i])
	end
	for i = prefix + 1, #new - suffix do
		added += 1
		table.insert(lines, "+ " .. new[i])
	end
	if removed == 0 and added == 0 then
		return "(no changes)", 0, 0
	end
	if #lines > maxLines then
		local extra = #lines - maxLines
		local kept = table.move(lines, 1, maxLines, 1, {})
		table.insert(kept, "... (" .. tostring(extra) .. " more diff lines)")
		lines = kept
	end
	return table.concat(lines, "\n"), removed, added
end

local function outline(node: any, depth: number, lines: { string }, counter: { number })
	if typeof(node) ~= "table" then
		return
	end
	counter[1] += 1
	if #lines < OUTLINE_LINES then
		table.insert(lines, string.rep("  ", depth) .. tostring(node.className) .. " \"" .. tostring(node.name) .. "\"")
	end
	if typeof(node.children) == "table" then
		for _, child in ipairs(node.children) do
			outline(child, depth + 1, lines, counter)
		end
	end
end

local function currentSource(path: any): string?
	local target = PathResolver.resolve(path)
	if target == nil or not target:IsA("LuaSourceContainer") then
		return nil
	end
	local ok, source = pcall(function()
		return game:GetService("ScriptEditorService"):GetEditorSource(target)
	end)
	if ok and typeof(source) == "string" then
		return source
	end
	return (target :: any).Source
end

-- Pick the verification entries that concern this action. Check labels look like
-- "structure:<label>", "lint:<label>", "animation:<name>".
function ActionPreview.relevantChecks(action: any, verification: { any }): { any }
	local target = ActionApplier.targetPath(action)
	local name = if typeof(action.name) == "string" then action.name else nil
	local out = {}
	for _, entry in ipairs(verification) do
		if typeof(entry) == "table" and typeof(entry.check) == "string" then
			local label = entry.check:match("^[^:]*:(.+)$")
			if label ~= nil and (label == target or label == name or target:sub(-(#label + 1)) == "." .. label) then
				table.insert(out, entry)
			end
		end
	end
	return out
end

---------------------------------------------------------------------------
-- Card
---------------------------------------------------------------------------

local function addLabel(parent: Instance, text: string, order: number, colorFn: (() -> Color3)?, props: Ui.Props?): TextLabel
	local label = Ui.label(text, props)
	label.LayoutOrder = order
	if colorFn then
		Theme.paint(label, "TextColor3", colorFn)
	end
	label.Parent = parent
	return label
end

-- A "✓ n/m checks" badge; clicking it shows / hides the individual checks.
local function addVerification(parent: Instance, checks: { any }, order: number)
	if #checks == 0 then
		return
	end
	local lines: { string } = {}
	local passed = 0
	for _, entry in ipairs(checks) do
		local ok = entry.ok == true
		if ok then
			passed += 1
		end
		local detail = if typeof(entry.detail) == "string" and entry.detail ~= "" then " - " .. entry.detail else ""
		table.insert(lines, (if ok then "PASS " else "FAIL ") .. entry.check .. detail)
	end
	local allOk = passed == #checks
	local colorFn = if allOk then Theme.success else Theme.error
	local row = Ui.row(6, { LayoutOrder = order, Name = "Verification" })
	row.Parent = parent
	local badge = Ui.create("TextButton", {
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Font = Theme.FONT_MEDIUM,
		TextSize = Ui.SMALL_TEXT,
		Text = (if allOk then "✓ " else "✕ ") .. tostring(passed) .. "/" .. tostring(#checks) .. " checks  ▸",
		Parent = row,
	}, { Ui.corner(10), Ui.padding(0, 8) }) :: TextButton
	Theme.paint(badge, "BackgroundColor3", Theme.subtle)
	Theme.paint(badge, "TextColor3", colorFn)
	local details = addLabel(parent, table.concat(lines, "\n"), order + 1, colorFn, {
		TextSize = 12,
		Font = Theme.FONT_MONO,
		Visible = false,
	})
	badge.MouseButton1Click:Connect(function()
		details.Visible = not details.Visible
		badge.Text = (if allOk then "✓ " else "✕ ") .. tostring(passed) .. "/" .. tostring(#checks)
			.. " checks  " .. (if details.Visible then "▾" else "▸")
	end)
end

local function describe(card: CardData, body: Frame)
	local action = card.action
	local kind = action.type
	local order = 10
	if kind == "create_script" then
		addLabel(body, tostring(action.class) .. " in " .. tostring(action.parent_path), order, Theme.dimText, { TextSize = 13 })
		if typeof(action.source) == "string" then
			local block = Ui.codeBlock(action.source, PREVIEW_LINES)
			block.LayoutOrder = order + 1
			block.Parent = body
		end
	elseif kind == "edit_script" then
		local old = currentSource(action.path)
		if old == nil then
			addLabel(body, "Warning: " .. tostring(action.path) .. " was not found or is not a script; applying will fail.", order, Theme.warning)
		elseif typeof(action.new_source) == "string" then
			local text, removed, added = ActionPreview.diff(old, action.new_source, DIFF_LINES)
			addLabel(body, "Diff: -" .. tostring(removed) .. " / +" .. tostring(added) .. " lines", order, Theme.dimText, { TextSize = 13 })
			local block = Ui.codeBlock(text, nil)
			block.LayoutOrder = order + 1
			block.Parent = body
		end
	elseif kind == "create_instances" then
		local lines: { string } = {}
		local counter = { 0 }
		outline(action.tree, 0, lines, counter)
		if counter[1] > #lines then
			table.insert(lines, "... (" .. tostring(counter[1] - #lines) .. " more)")
		end
		addLabel(body, tostring(counter[1]) .. " instance(s) under " .. tostring(action.parent_path), order, Theme.dimText, { TextSize = 13 })
		local block = Ui.codeBlock(table.concat(lines, "\n"), nil)
		block.LayoutOrder = order + 1
		block.Parent = body
	elseif kind == "create_animation" then
		local keyframeCount = if typeof(action.keyframes) == "table" then #action.keyframes else 0
		local parts: { [string]: boolean } = {}
		local partCount = 0
		if typeof(action.keyframes) == "table" then
			for _, frame in ipairs(action.keyframes) do
				if typeof(frame) == "table" and typeof(frame.poses) == "table" then
					for part in pairs(frame.poses) do
						if not parts[part] then
							parts[part] = true
							partCount += 1
						end
					end
				end
			end
		end
		local summary = string.format(
			"%s rig, %d keyframes, %s s, looped=%s, priority=%s, %d posed parts",
			tostring(action.rig or "R15"),
			keyframeCount,
			tostring(action.duration or "?"),
			tostring(action.looped == true),
			tostring(action.priority or "Core"),
			partCount
		)
		addLabel(body, summary, order, Theme.dimText, { TextSize = 13 })
		if typeof(action.provenance) == "string" then
			addLabel(body, "Provenance: " .. action.provenance, order + 1, Theme.dimText, { TextSize = 13 })
		end
	elseif kind == "delete_instance" then
		local target = PathResolver.resolve(action.path)
		local detail = if target
			then target.ClassName .. " with " .. tostring(#target:GetDescendants()) .. " descendant(s)"
			else "target not found"
		addLabel(body, "DESTRUCTIVE: deletes " .. tostring(action.path) .. " (" .. detail .. "). Undo (Ctrl+Z) can restore it.", order, Theme.danger, {
			Font = Theme.FONT_BOLD,
		})
	else
		addLabel(body, "Unsupported action type '" .. tostring(kind) .. "'; it cannot be applied.", order, Theme.error)
	end
end

function ActionPreview.new(action: any, options: Options): Card
	local destructive = ActionApplier.isDestructive(action)
	local frame = Ui.create("Frame", {
		Name = "ActionCard",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
	}, { Ui.corner(8), Ui.padding(10), Ui.vlist(6) }) :: Frame
	Theme.paint(frame, "BackgroundColor3", Theme.raised)
	local stroke = Ui.stroke(if destructive then Theme.danger else Theme.hairline)
	if destructive then
		(stroke :: UIStroke).Thickness = 2
	end
	stroke.Parent = frame

	local kind = if typeof(action) == "table" then action.type else nil
	-- Header: type pill, then the title (action name or target), then the
	-- description and the full target path in monospace.
	local pillRow = Ui.row(6, { LayoutOrder = 1 })
	pillRow.Parent = frame
	local pill = Ui.chip(string.upper(TYPE_TITLES[kind] or tostring(kind)), if destructive then Theme.danger else Theme.accent)
	pill.Parent = pillRow
	local target = ActionApplier.targetPath(action)
	local name = if typeof(action) == "table" and typeof(action.name) == "string" then action.name else target:match("([^%.]+)$")
	addLabel(frame, name or target, 2, nil, { Font = Theme.FONT_BOLD, TextSize = 15 })
	if typeof(action) == "table" and typeof(action.description) == "string" then
		addLabel(frame, action.description, 3, nil, { TextSize = 14 })
	end
	addLabel(frame, target, 4, Theme.dimText, { TextSize = 12, Font = Theme.FONT_MONO })

	local buttons = Ui.create("Frame", {
		Name = "Buttons",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = 100,
	}, { Ui.hlist(6) }) :: Frame

	local status = addLabel(frame, "", 101, Theme.dimText, { TextSize = 13, Visible = false })

	local self = setmetatable({
		action = action,
		frame = frame,
		buttons = buttons,
		status = status,
		state = "pending",
		options = options,
	} :: CardData, ActionPreview)

	if typeof(action) == "table" then
		describe(self, frame)
		addVerification(frame, ActionPreview.relevantChecks(action, options.verification), 50)
	end
	buttons.Parent = frame
	self:showDefaultButtons()
	return self
end

function ActionPreview.clearButtons(self: Card)
	for _, child in ipairs(self.buttons:GetChildren()) do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
end

function ActionPreview.setStatus(self: Card, text: string, colorFn: () -> Color3)
	self.status.Text = text
	self.status.Visible = true
	Theme.paint(self.status, "TextColor3", colorFn)
end

function ActionPreview.showDefaultButtons(self: Card)
	self:clearButtons()
	local action = self.action
	local supported = typeof(action) == "table" and table.find(ActionApplier.SUPPORTED_ACTIONS, action.type) ~= nil
	if not supported then
		self.state = "discarded"
		self:setStatus("Skipped: unsupported action.", Theme.warning)
		return
	end

	if ActionApplier.isDestructive(action) then
		local deleteButton = Ui.button("Delete…", "danger")
		deleteButton.LayoutOrder = 1
		deleteButton.Parent = self.buttons
		deleteButton.MouseButton1Click:Connect(function()
			self:showConfirmButtons()
		end)
	else
		local applyButton = Ui.button("Apply", "primary")
		applyButton.LayoutOrder = 1
		applyButton.Parent = self.buttons
		applyButton.MouseButton1Click:Connect(function()
			self:apply()
		end)
	end

	local discardButton = Ui.button("Discard", "secondary")
	discardButton.LayoutOrder = 2
	discardButton.Parent = self.buttons
	discardButton.MouseButton1Click:Connect(function()
		self.state = "discarded"
		self:clearButtons()
		self:setStatus("Discarded. Nothing was changed.", Theme.dimText)
	end)

	local source = if action.type == "create_script" then action.source elseif action.type == "edit_script" then action.new_source else nil
	local onVerify = self.options.onVerify
	if typeof(source) == "string" and onVerify then
		local verifyButton = Ui.button("Re-verify", "ghost")
		verifyButton.LayoutOrder = 3
		verifyButton.Parent = self.buttons
		verifyButton.MouseButton1Click:Connect(function()
			self:setStatus("Verifying...", Theme.dimText)
			task.spawn(function()
				local passed, summary = onVerify(source)
				self:setStatus(summary, if passed then Theme.success else Theme.warning)
			end)
		end)
	end
end

function ActionPreview.showConfirmButtons(self: Card)
	self:clearButtons()
	self:setStatus("This permanently removes " .. ActionApplier.targetPath(self.action) .. " from the place (Undo can restore it). Are you sure?", Theme.danger)
	local confirmButton = Ui.button("Confirm delete", "danger")
	confirmButton.LayoutOrder = 1
	confirmButton.Parent = self.buttons
	confirmButton.MouseButton1Click:Connect(function()
		self:apply()
	end)
	local cancelButton = Ui.button("Cancel", "secondary")
	cancelButton.LayoutOrder = 2
	cancelButton.Parent = self.buttons
	cancelButton.MouseButton1Click:Connect(function()
		self.status.Visible = false
		self:showDefaultButtons()
	end)
end

function ActionPreview.isPending(self: Card): boolean
	return self.state == "pending"
end

-- True when this card may be included in a one-confirmation batch (autonomy 4-5).
function ActionPreview.isBatchable(self: Card): boolean
	local action = self.action
	return self.state == "pending"
		and typeof(action) == "table"
		and action.requires_approval == false
		and not ActionApplier.isDestructive(action)
		and table.find(ActionApplier.SUPPORTED_ACTIONS, action.type) ~= nil
end

-- Apply this card's action and show the real outcome. Returns the result.
function ActionPreview.apply(self: Card): ActionApplier.Result?
	if self.state ~= "pending" then
		return nil
	end
	self.state = "applying"
	self:clearButtons()
	self:setStatus("Applying...", Theme.dimText)
	local result = self.options.onApply(self.action)
	if result.ok then
		self.state = "applied"
		self:setStatus("Applied: " .. result.message, Theme.success)
	else
		self.state = "failed"
		self:setStatus("FAILED: " .. result.message, Theme.error)
	end
	self.options.onResult(self.action, result)
	return result
end

return ActionPreview
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX06C348926C4AC61361488BBA2CCD8697">
      <Properties>
        <string name="Name">ChatUI</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- ChatUI: the dock-widget chat surface. It owns layout only; Main wires callbacks
-- to the HTTP client, the offline engine and the action pipeline.
--
--  +-------------------------------------------+
--  | GODMODE  (o Offline)              [⚙] [+] |  header
--  |-------------------------------------------|
--  |                     [ user bubble      ]  |
--  | ▸ Thought for 0.0s · 5 steps              |  assistant: full width
--  | Markdown reply, headings, `code`          |
--  | +-- luau ------------- Select  Insert --+ |
--  | | dark code panel                       | |
--  | +---------------------------------------+ |
--  | (offline:obby) (✓ 3/3 checks)             |  footer chips
--  | [ action card: Apply / Discard ]          |
--  |-------------------------------------------|
--  | +---------------------------------------+ |
--  | | Ask GODMODE…                          | |  grows to ~6 lines
--  | | [Thinking: Medium ▾] [A2 ▾]    [Send] | |
--  | +---------------------------------------+ |
--  +-------------------------------------------+
--
-- The settings view (gear) and the empty state replace the message list while
-- shown. Connections made on instances inside the message list die with those
-- instances; anything else a message needs is tracked and disconnected by clear().

local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local Ui = require(script.Parent.Ui)
local Markdown = require(script.Parent.Markdown)

local ChatUI = {}
ChatUI.__index = ChatUI

export type Mode = "offline" | "online"
export type NoticeKind = "info" | "success" | "warning" | "error"
export type Status = "offline" | "online" | "checking" | "unreachable"

export type Callbacks = {
	onSend: (text: string) -> (),
	onAutonomyChanged: (level: number) -> (),
	onThinkingChanged: (id: string) -> (),
	onModeChanged: (mode: Mode) -> (),
	onSaveSettings: (url: string, token: string) -> (),
	onTestConnection: (url: string, token: string) -> (),
	onRefreshStatus: () -> (),
	onNewChat: () -> (),
}

export type Initial = {
	url: string,
	token: string,
	autonomy: number,
	thinking: string,
	mode: Mode,
}

export type ThinkingLevel = { id: string, label: string, description: string }

export type ThinkingStep = { label: string?, detail: string?, ms: number? }
export type Thinking = {
	level: string?,
	summary: string?,
	elapsed_ms: number?,
	steps: { ThinkingStep }?,
}

export type AssistantExtras = {
	thinking: any?,
	source: string?,
	verification: { any }?,
	onInsert: ((code: string, language: string?) -> ())?,
}

-- Exactly these five ids are sent as `thinking` in POST /chat.
ChatUI.THINKING_LEVELS = {
	{ id = "low", label = "Low", description = "Fastest. Asks the server for the least deliberation." },
	{ id = "medium", label = "Medium", description = "Balanced default." },
	{ id = "high", label = "High", description = "Asks the server to plan more before answering." },
	{ id = "xhigh", label = "Extra high", description = "Longer planning and self-checks; slower." },
	{ id = "max", label = "Max", description = "Slowest. The most deliberation the server allows." },
} :: { ThinkingLevel }
ChatUI.DEFAULT_THINKING = "medium"

ChatUI.AUTONOMY_LABELS = { "Assistant", "Copilot", "Engineer", "Autonomous", "Research" }
ChatUI.AUTONOMY_HINTS = {
	"Answers questions; never proposes changes to your place.",
	"Proposes changes; you approve every action.",
	"Writes and verifies code; you approve every action.",
	"Safe, verified actions can be applied together after one click; destructive ones still need confirmation.",
	"Long multi-step work; same approval rules as Autonomous.",
}

ChatUI.EXAMPLE_PROMPTS = {
	{ title = "Build an obby", hint = "Checkpoints, kill bricks and a finish line" },
	{ title = "Make a sprint animation", hint = "R15 keyframes you can preview and edit" },
	{ title = "Save player data", hint = "DataStore with retries and session safety" },
	{ title = "Make a leaderboard with coins", hint = "leaderstats plus coins to collect" },
}

local HEADER_HEIGHT = 40
local CODE_PREVIEW_LINES = 60
local MAX_INPUT_LINES = 6
local INPUT_TEXT_SIZE = 14
local USER_BUBBLE_FRACTION = 0.85
local TYPING_ORDER = 2 ^ 30

type State = {
	root: Frame,
	body: Frame,
	messages: ScrollingFrame,
	emptyState: Frame,
	settingsView: ScrollingFrame,
	composer: Frame,
	inputClip: Frame,
	input: TextBox,
	sendButton: TextButton,
	thinkingButton: TextButton,
	autonomyButton: TextButton,
	statusChip: TextButton,
	statusDot: Frame,
	statusLabel: TextLabel,
	tooltip: TextLabel,
	modeButtons: { [string]: TextButton },
	urlBox: TextBox,
	tokenBox: TextBox,
	testResult: TextLabel,
	callbacks: Callbacks,
	levels: { ThinkingLevel },
	autonomy: number,
	thinking: string,
	mode: Mode,
	order: number,
	messageCount: number,
	busy: boolean,
	settingsOpen: boolean,
	stickToBottom: boolean,
	scrollTween: Tween?,
	bubbleLimits: { UISizeConstraint },
	messageConnections: { RBXScriptConnection },
	typing: Frame?,
	typingTweens: { Tween },
	typingThread: thread?,
	closeMenu: (() -> ())?,
}

export type ChatUI = typeof(setmetatable({} :: State, ChatUI))

local function trim(text: string): string
	return text:match("^%s*(.-)%s*$") or ""
end

local function levelById(levels: { ThinkingLevel }, id: string): ThinkingLevel
	for _, level in ipairs(levels) do
		if level.id == id then
			return level
		end
	end
	return levels[2]
end

local function thinkingText(levels: { ThinkingLevel }, id: string): string
	return "Thinking: " .. levelById(levels, id).label .. "  ▾"
end

local function autonomyText(level: number): string
	return "A" .. tostring(level) .. "  ▾"
end

local function lineHeight(): number
	local ok, size = pcall(function()
		return TextService:GetTextSize("Ag", INPUT_TEXT_SIZE, Theme.FONT_REGULAR, Vector2.new(1000, 1000))
	end)
	if ok and typeof(size) == "Vector2" and size.Y > 0 then
		return size.Y
	end
	return INPUT_TEXT_SIZE + 4
end

---------------------------------------------------------------------------
-- Construction
---------------------------------------------------------------------------

function ChatUI.new(parent: Instance, callbacks: Callbacks, initial: Initial): ChatUI
	local root = Ui.create("Frame", {
		Name = "GodmodeRoot",
		Size = UDim2.fromScale(1, 1),
		BorderSizePixel = 0,
		Parent = parent,
	}) :: Frame
	Theme.paint(root, "BackgroundColor3", Theme.background)

	-- Header ------------------------------------------------------------------
	local header = Ui.create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, HEADER_HEIGHT),
		BorderSizePixel = 0,
		Parent = root,
	}, { Ui.padding(0, 6, 0, 12) }) :: Frame
	Theme.paint(header, "BackgroundColor3", Theme.background)
	local divider = Ui.create("Frame", {
		Name = "Divider",
		Position = UDim2.fromOffset(0, HEADER_HEIGHT),
		Size = UDim2.new(1, 0, 0, 1),
		BorderSizePixel = 0,
		Parent = root,
	})
	Theme.paint(divider, "BackgroundColor3", Theme.hairline)

	local left = Ui.create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -64, 1, 0),
		Parent = header,
	}, { Ui.hlist(8) })
	local title = Ui.create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = Theme.FONT_BOLD,
		TextSize = 15,
		Text = "GODMODE",
		LayoutOrder = 1,
		Parent = left,
	})
	Theme.paint(title, "TextColor3", Theme.text)

	-- Status chip: coloured dot + text; click to re-check.
	local statusChip = Ui.create("TextButton", {
		Name = "Status",
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		LayoutOrder = 2,
		Parent = left,
	}, { Ui.corner(11), Ui.padding(0, 9, 0, 8), Ui.hlist(6) }) :: TextButton
	Theme.paint(statusChip, "BackgroundColor3", Theme.subtle)
	local statusDot = Ui.create("Frame", {
		Size = UDim2.fromOffset(7, 7),
		BorderSizePixel = 0,
		LayoutOrder = 1,
		Parent = statusChip,
	}, { Ui.corner(4) }) :: Frame
	local statusLabel = Ui.create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = Theme.FONT_MEDIUM,
		TextSize = Ui.SMALL_TEXT,
		Text = "",
		LayoutOrder = 2,
		Parent = statusChip,
	}) :: TextLabel
	Theme.paint(statusLabel, "TextColor3", Theme.dimText)

	local right = Ui.create("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(60, 28),
		Parent = header,
	}, { Ui.hlist(4, Enum.HorizontalAlignment.Right) })
	local gearButton = Ui.iconButton("⚙", "Settings")
	gearButton.LayoutOrder = 1
	gearButton.Parent = right
	local newChatButton = Ui.iconButton("+", "NewChat")
	newChatButton.TextSize = 20
	newChatButton.LayoutOrder = 2
	newChatButton.Parent = right

	-- Body: messages / empty state / settings share this area ------------------
	local body = Ui.create("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, HEADER_HEIGHT + 1),
		Size = UDim2.new(1, 0, 1, -(HEADER_HEIGHT + 1 + 90)),
		ClipsDescendants = true,
		Parent = root,
	}) :: Frame

	local messages = Ui.create("ScrollingFrame", {
		Name = "Messages",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 6,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Visible = false,
		Parent = body,
	}, { Ui.padding(12, 12, 16, 12), Ui.vlist(12) }) :: ScrollingFrame
	Theme.paint(messages, "ScrollBarImageColor3", Theme.hairline)

	local emptyState = Ui.create("Frame", {
		Name = "EmptyState",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = body,
	}, { Ui.padding(16) }) :: Frame

	local settingsView = Ui.create("ScrollingFrame", {
		Name = "Settings",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 6,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		Visible = false,
		Parent = body,
	}, { Ui.padding(14), Ui.vlist(8) }) :: ScrollingFrame
	Theme.paint(settingsView, "ScrollBarImageColor3", Theme.hairline)

	-- Composer --------------------------------------------------------------
	local composer = Ui.create("Frame", {
		Name = "Composer",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = root,
	}, { Ui.padding(4, 10, 10, 10) }) :: Frame

	local card = Ui.create("Frame", {
		Name = "Card",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		Parent = composer,
	}, { Ui.corner(10), Ui.padding(8, 8, 6, 10), Ui.vlist(6) }) :: Frame
	Theme.paint(card, "BackgroundColor3", Theme.inputBackground)
	local cardStroke = Ui.stroke(Theme.hairline)
	cardStroke.Parent = card

	local oneLine = lineHeight()
	local inputClip = Ui.create("Frame", {
		Name = "InputClip",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, oneLine),
		ClipsDescendants = true,
		LayoutOrder = 1,
		Parent = card,
	}) :: Frame
	local input = Ui.create("TextBox", {
		Name = "Input",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = Theme.FONT_REGULAR,
		TextSize = INPUT_TEXT_SIZE,
		Text = "",
		PlaceholderText = "Ask GODMODE…  (Enter to send, Shift+Enter for a new line)",
		ClearTextOnFocus = false,
		MultiLine = true,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = inputClip,
	}) :: TextBox
	Theme.paint(input, "TextColor3", Theme.text)
	Theme.paint(input, "PlaceholderColor3", Theme.dimText)

	local toolbarRow = Ui.create("Frame", {
		Name = "Toolbar",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, Ui.BUTTON_HEIGHT),
		LayoutOrder = 2,
		Parent = card,
	}) :: Frame
	local pickers = Ui.create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -70, 1, 0),
		Parent = toolbarRow,
	}, { Ui.hlist(4) })

	-- Per-widget copy: /health may relabel these without touching the module constant.
	local levels: { ThinkingLevel } = {}
	for _, level in ipairs(ChatUI.THINKING_LEVELS) do
		table.insert(levels, table.clone(level))
	end
	local thinkingButton = Ui.button(thinkingText(levels, initial.thinking), "ghost")
	thinkingButton.Name = "Thinking"
	thinkingButton.TextSize = Ui.SMALL_TEXT
	thinkingButton.LayoutOrder = 1
	thinkingButton.Parent = pickers
	local autonomyButton = Ui.button(autonomyText(initial.autonomy), "ghost")
	autonomyButton.Name = "Autonomy"
	autonomyButton.TextSize = Ui.SMALL_TEXT
	autonomyButton.LayoutOrder = 2
	autonomyButton.Parent = pickers

	local sendButton = Ui.button("Send", "primary", 62)
	sendButton.Name = "Send"
	sendButton.AnchorPoint = Vector2.new(1, 0)
	sendButton.Position = UDim2.fromScale(1, 0)
	sendButton.Parent = toolbarRow

	-- One shared tooltip (thinking level descriptions, autonomy hints).
	local tooltip = Ui.label("", {
		Name = "Tooltip",
		Size = UDim2.fromOffset(240, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		TextSize = Ui.SMALL_TEXT,
		Visible = false,
		ZIndex = 40,
		Parent = root,
	})
	Ui.corner(6).Parent = tooltip
	Ui.padding(6, 8).Parent = tooltip
	Theme.paint(tooltip, "BackgroundColor3", Theme.raised)
	Ui.stroke(Theme.hairline).Parent = tooltip

	local self = setmetatable({
		root = root,
		body = body,
		messages = messages,
		emptyState = emptyState,
		settingsView = settingsView,
		composer = composer,
		inputClip = inputClip,
		input = input,
		sendButton = sendButton,
		thinkingButton = thinkingButton,
		autonomyButton = autonomyButton,
		statusChip = statusChip,
		statusDot = statusDot,
		statusLabel = statusLabel,
		tooltip = tooltip,
		modeButtons = {},
		urlBox = nil :: any,
		tokenBox = nil :: any,
		testResult = nil :: any,
		callbacks = callbacks,
		levels = levels,
		autonomy = initial.autonomy,
		thinking = levelById(levels, initial.thinking).id,
		mode = initial.mode,
		order = 0,
		messageCount = 0,
		busy = false,
		settingsOpen = false,
		stickToBottom = true,
		scrollTween = nil,
		bubbleLimits = {},
		messageConnections = {},
		typing = nil,
		typingTweens = {},
		typingThread = nil,
		closeMenu = nil,
	} :: State, ChatUI)

	self:buildEmptyState()
	self:buildSettings(initial)
	self:setStatus(if initial.mode == "online" then "checking" else "offline")

	-- Layout: the body fills whatever the (growing) composer leaves.
	local function layoutBody()
		local composerHeight = composer.AbsoluteSize.Y
		body.Size = UDim2.new(1, 0, 1, -(HEADER_HEIGHT + 1 + composerHeight))
	end
	composer:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutBody)
	layoutBody()

	-- User bubbles are capped at a fraction of the list width.
	messages:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		local limit = self:bubbleLimit()
		for _, constraint in ipairs(self.bubbleLimits) do
			constraint.MaxSize = Vector2.new(limit, math.huge)
		end
	end)

	-- Follow new content while the user is at the bottom; stop when they scroll up.
	messages:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(function()
		if self.stickToBottom then
			self:scrollToBottom(true)
		end
	end)
	messages.InputChanged:Connect(function(inputObject: InputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseWheel then
			task.defer(function()
				local maxY = math.max(0, messages.AbsoluteCanvasSize.Y - messages.AbsoluteWindowSize.Y)
				self.stickToBottom = messages.CanvasPosition.Y >= maxY - 24
			end)
		end
	end)

	-- Header buttons.
	gearButton.MouseButton1Click:Connect(function()
		self:setSettingsOpen(not self.settingsOpen)
	end)
	newChatButton.MouseButton1Click:Connect(function()
		callbacks.onNewChat()
	end)
	statusChip.MouseButton1Click:Connect(function()
		callbacks.onRefreshStatus()
	end)

	-- Pickers.
	thinkingButton.MouseButton1Click:Connect(function()
		self:hideTooltip()
		local items: { Ui.MenuItem } = {}
		for _, level in ipairs(self.levels) do
			table.insert(items, { id = level.id, label = level.label, description = level.description })
		end
		self.closeMenu = Ui.menu(root, thinkingButton, items, self.thinking, function(id: string)
			self:setThinking(id)
			callbacks.onThinkingChanged(id)
		end, 250)
	end)
	autonomyButton.MouseButton1Click:Connect(function()
		self:hideTooltip()
		local items: { Ui.MenuItem } = {}
		for level, name in ipairs(ChatUI.AUTONOMY_LABELS) do
			table.insert(items, {
				id = tostring(level),
				label = tostring(level) .. " · " .. name,
				description = ChatUI.AUTONOMY_HINTS[level],
			})
		end
		self.closeMenu = Ui.menu(root, autonomyButton, items, tostring(self.autonomy), function(id: string)
			local level = tonumber(id) :: number
			self:setAutonomy(level)
			callbacks.onAutonomyChanged(level)
		end, 270)
	end)
	thinkingButton.MouseEnter:Connect(function()
		self:showTooltip(thinkingButton, "Thinking level: " .. levelById(self.levels, self.thinking).description)
	end)
	thinkingButton.MouseLeave:Connect(function()
		self:hideTooltip()
	end)
	autonomyButton.MouseEnter:Connect(function()
		self:showTooltip(autonomyButton, "Autonomy " .. tostring(self.autonomy) .. " · "
			.. ChatUI.AUTONOMY_LABELS[self.autonomy] .. ": " .. ChatUI.AUTONOMY_HINTS[self.autonomy])
	end)
	autonomyButton.MouseLeave:Connect(function()
		self:hideTooltip()
	end)

	-- Composer: focus ring, auto-grow, Enter to send / Shift+Enter for a newline.
	input.Focused:Connect(function()
		Theme.paint(cardStroke, "Color", Theme.accent)
	end)
	input.FocusLost:Connect(function()
		Theme.paint(cardStroke, "Color", Theme.hairline)
	end)

	local function resizeInput()
		local wanted = math.max(oneLine, input.TextBounds.Y)
		local maxHeight = oneLine * MAX_INPUT_LINES
		inputClip.Size = UDim2.new(1, 0, 0, math.min(wanted, maxHeight))
		-- Past ~6 lines the box stops growing; keep the end (where you type) visible.
		input.TextYAlignment = if wanted > maxHeight then Enum.TextYAlignment.Bottom else Enum.TextYAlignment.Top
	end
	input:GetPropertyChangedSignal("TextBounds"):Connect(resizeInput)

	local shiftDown = false
	input.InputBegan:Connect(function(inputObject: InputObject)
		if inputObject.KeyCode == Enum.KeyCode.LeftShift or inputObject.KeyCode == Enum.KeyCode.RightShift then
			shiftDown = true
		end
	end)
	input.InputEnded:Connect(function(inputObject: InputObject)
		if inputObject.KeyCode == Enum.KeyCode.LeftShift or inputObject.KeyCode == Enum.KeyCode.RightShift then
			shiftDown = false
		end
	end)
	local function isShiftHeld(): boolean
		if shiftDown then
			return true
		end
		local ok, held = pcall(function()
			return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
		end)
		return ok and held == true
	end

	local function submit()
		if self.busy then
			return
		end
		local text = trim(input.Text)
		if text == "" then
			return
		end
		input.Text = ""
		callbacks.onSend(text)
	end

	local previousText = ""
	local suppress = false
	input:GetPropertyChangedSignal("Text"):Connect(function()
		if suppress then
			previousText = input.Text
			return
		end
		local current = input.Text
		-- Exactly one newline typed (not pasted): find where it went in.
		if #current == #previousText + 1 then
			local i = 1
			while i <= #previousText and current:sub(i, i) == previousText:sub(i, i) do
				i += 1
			end
			if current:sub(i, i) == "\n" and current:sub(1, i - 1) .. current:sub(i + 1) == previousText and not isShiftHeld() then
				suppress = true
				input.Text = previousText
				suppress = false
				previousText = input.Text
				submit()
				return
			end
		end
		previousText = current
	end)
	sendButton.MouseButton1Click:Connect(submit)

	return self
end

---------------------------------------------------------------------------
-- Empty state and settings view
---------------------------------------------------------------------------

function ChatUI.buildEmptyState(self: ChatUI): ()
	local column = Ui.create("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = self.emptyState,
	}, { Ui.vlist(8, Enum.HorizontalAlignment.Center) })
	Ui.label("What should we build?", {
		Font = Theme.FONT_BOLD,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 1,
		Parent = column,
	})
	local subtitle = Ui.label("GODMODE proposes changes; nothing in your place changes until you click Apply, and every applied action is one undo step.", {
		TextSize = Ui.SMALL_TEXT,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 2,
		Parent = column,
	})
	Theme.paint(subtitle, "TextColor3", Theme.dimText)
	Ui.create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(1, 4), LayoutOrder = 3, Parent = column })

	for index, prompt in ipairs(ChatUI.EXAMPLE_PROMPTS) do
		local button = Ui.create("TextButton", {
			Name = "Example" .. tostring(index),
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			Text = "",
			LayoutOrder = 10 + index,
			Parent = column,
		}, { Ui.corner(8), Ui.padding(8, 12), Ui.vlist(2) }) :: TextButton
		Theme.paint(button, "BackgroundColor3", Theme.raised)
		Ui.stroke(Theme.hairline).Parent = button
		Ui.hover(button, Theme.raised, Theme.subtle)
		Ui.label(prompt.title, { Font = Theme.FONT_MEDIUM, LayoutOrder = 1, Parent = button })
		local hint = Ui.label(prompt.hint, { TextSize = Ui.SMALL_TEXT, LayoutOrder = 2, Parent = button })
		Theme.paint(hint, "TextColor3", Theme.dimText)
		button.MouseButton1Click:Connect(function()
			if not self.busy then
				self.callbacks.onSend(string.lower(prompt.title))
			end
		end)
	end
end

local function sectionLabel(text: string, order: number, parent: Instance): TextLabel
	local label = Ui.label(text, { Font = Theme.FONT_MEDIUM, TextSize = Ui.SMALL_TEXT, LayoutOrder = order, Parent = parent })
	Theme.paint(label, "TextColor3", Theme.dimText)
	return label
end

function ChatUI.buildSettings(self: ChatUI, initial: Initial): ()
	local view = self.settingsView
	local titleRow = Ui.create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 28),
		LayoutOrder = 1,
		Parent = view,
	})
	Ui.label("Settings", {
		Font = Theme.FONT_BOLD,
		TextSize = 16,
		Size = UDim2.new(1, -70, 1, 0),
		AutomaticSize = Enum.AutomaticSize.None,
		TextYAlignment = Enum.TextYAlignment.Center,
		Parent = titleRow,
	})
	local doneButton = Ui.button("Done", "secondary")
	doneButton.AnchorPoint = Vector2.new(1, 0)
	doneButton.Position = UDim2.fromScale(1, 0)
	doneButton.Parent = titleRow
	doneButton.MouseButton1Click:Connect(function()
		self:setSettingsOpen(false)
	end)

	-- Mode: segmented Offline | Online (applies immediately).
	sectionLabel("MODE", 10, view)
	local segmented = Ui.create("Frame", {
		Name = "Mode",
		Size = UDim2.new(1, 0, 0, 30),
		BorderSizePixel = 0,
		LayoutOrder = 11,
		Parent = view,
	}, { Ui.corner(8), Ui.padding(3) }) :: Frame
	Theme.paint(segmented, "BackgroundColor3", Theme.subtle)
	for index, mode in ipairs({ "offline", "online" }) do
		local button = Ui.create("TextButton", {
			Name = mode,
			Size = UDim2.new(0.5, if index == 1 then -2 else -1, 1, 0),
			Position = UDim2.new(if index == 1 then 0 else 0.5, if index == 1 then 0 else 1, 0, 0),
			AutoButtonColor = false,
			BorderSizePixel = 0,
			Font = Theme.FONT_MEDIUM,
			TextSize = 13,
			Text = if mode == "offline" then "Offline" else "Online",
			Parent = segmented,
		}, { Ui.corner(6) }) :: TextButton
		self.modeButtons[mode] = button
		button.MouseButton1Click:Connect(function()
			local picked: Mode = if mode == "online" then "online" else "offline"
			if picked ~= self.mode then
				self:setMode(picked)
				self.callbacks.onModeChanged(picked)
			end
		end)
	end
	local modeHint = Ui.label("Offline uses the built-in, pre-verified builds and makes no HTTP requests. Online sends each "
		.. "message to the GODMODE server below and falls back to offline if it cannot be reached.", {
		TextSize = Ui.SMALL_TEXT,
		LayoutOrder = 12,
		Parent = view,
	})
	Theme.paint(modeHint, "TextColor3", Theme.dimText)

	-- Server.
	sectionLabel("SERVER URL", 20, view)
	local urlBox = Ui.textBox("http://127.0.0.1:8765")
	urlBox.Text = initial.url
	urlBox.LayoutOrder = 21
	urlBox.Parent = view
	sectionLabel("ACCESS TOKEN (OPTIONAL)", 22, view)
	local tokenBox = Ui.textBox("Sent as the X-Godmode-Token header")
	tokenBox.Text = initial.token
	tokenBox.LayoutOrder = 23
	tokenBox.Parent = view

	local buttons = Ui.create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, Ui.BUTTON_HEIGHT),
		LayoutOrder = 24,
		Parent = view,
	}, { Ui.hlist(6) })
	local testButton = Ui.button("Test connection", "secondary")
	testButton.LayoutOrder = 1
	testButton.Parent = buttons
	local saveButton = Ui.button("Save", "primary")
	saveButton.LayoutOrder = 2
	saveButton.Parent = buttons

	local testResult = Ui.label("", { TextSize = Ui.SMALL_TEXT, LayoutOrder = 25, Visible = false, Parent = view })

	local note = Ui.label("Studio asks once whether GODMODE may send HTTP requests to this host; choose Allow. "
		.. "If you dismissed the prompt, open Plugins > Manage Plugins and allow GODMODE's HTTP access. "
		.. "https:// URLs work too. A URL that is not on this computer receives your messages, the open script and the token.", {
		TextSize = Ui.SMALL_TEXT,
		LayoutOrder = 30,
		Parent = view,
	})
	Theme.paint(note, "TextColor3", Theme.dimText)

	self.urlBox = urlBox
	self.tokenBox = tokenBox
	self.testResult = testResult
	self:setMode(initial.mode)

	testButton.MouseButton1Click:Connect(function()
		self:setTestResult("info", "Testing " .. trim(urlBox.Text) .. "/health …")
		self.callbacks.onTestConnection(urlBox.Text, tokenBox.Text)
	end)
	saveButton.MouseButton1Click:Connect(function()
		self:setTestResult("success", "Saved.")
		self.callbacks.onSaveSettings(urlBox.Text, tokenBox.Text)
	end)
end

function ChatUI.setTestResult(self: ChatUI, kind: NoticeKind, text: string): ()
	local colorFn: () -> Color3 = Theme.dimText
	if kind == "error" then
		colorFn = Theme.error
	elseif kind == "warning" then
		colorFn = Theme.warning
	elseif kind == "success" then
		colorFn = Theme.success
	end
	self.testResult.Text = text
	self.testResult.Visible = true
	Theme.paint(self.testResult, "TextColor3", colorFn)
end

function ChatUI.setMode(self: ChatUI, mode: Mode): ()
	self.mode = mode
	for name, button in pairs(self.modeButtons) do
		if name == mode then
			button.BackgroundTransparency = 0
			Theme.paint(button, "BackgroundColor3", Theme.raised)
			Theme.paint(button, "TextColor3", Theme.text)
		else
			button.BackgroundTransparency = 1
			Theme.paint(button, "TextColor3", Theme.dimText)
		end
	end
end

function ChatUI.setSettingsOpen(self: ChatUI, open: boolean): ()
	self.settingsOpen = open
	if open then
		self.testResult.Visible = false
	end
	self:refreshBody()
end

function ChatUI.refreshBody(self: ChatUI): ()
	self.settingsView.Visible = self.settingsOpen
	self.emptyState.Visible = not self.settingsOpen and self.messageCount == 0
	self.messages.Visible = not self.settingsOpen and self.messageCount > 0
end

---------------------------------------------------------------------------
-- Header / composer state
---------------------------------------------------------------------------

function ChatUI.setStatus(self: ChatUI, status: Status, detail: string?): ()
	local colorFn: () -> Color3 = Theme.dimText
	local text = detail
	if status == "online" then
		colorFn = Theme.success
		text = text or "Online"
	elseif status == "checking" then
		colorFn = Theme.warning
		text = text or "Checking…"
	elseif status == "unreachable" then
		colorFn = Theme.danger
		text = text or "Unreachable"
	else
		text = text or "Offline"
	end
	Theme.paint(self.statusDot, "BackgroundColor3", colorFn)
	self.statusLabel.Text = text :: string
end

function ChatUI.setAutonomy(self: ChatUI, level: number): ()
	self.autonomy = level
	self.autonomyButton.Text = autonomyText(level)
end

function ChatUI.setThinking(self: ChatUI, id: string): ()
	self.thinking = levelById(self.levels, id).id
	self.thinkingButton.Text = thinkingText(self.levels, self.thinking)
end

-- Replace descriptions (and labels) with what /health `thinking_levels` reports.
-- Only the five known ids are accepted; anything else is ignored.
function ChatUI.setThinkingLevels(self: ChatUI, reported: any): ()
	if typeof(reported) ~= "table" then
		return
	end
	for _, entry in ipairs(reported) do
		if typeof(entry) == "table" and typeof(entry.id) == "string" then
			for _, level in ipairs(self.levels) do
				if level.id == entry.id then
					if typeof(entry.label) == "string" and entry.label ~= "" then
						level.label = entry.label
					end
					if typeof(entry.description) == "string" and entry.description ~= "" then
						level.description = entry.description
					end
				end
			end
		end
	end
	self.thinkingButton.Text = thinkingText(self.levels, self.thinking)
end

function ChatUI.thinkingLabel(self: ChatUI): string
	return levelById(self.levels, self.thinking).label
end

function ChatUI.showTooltip(self: ChatUI, anchor: GuiObject, text: string): ()
	local tooltip = self.tooltip
	tooltip.Text = text
	local relative = anchor.AbsolutePosition - self.root.AbsolutePosition
	local width = math.min(240, self.root.AbsoluteSize.X - 16)
	tooltip.Size = UDim2.fromOffset(width, 0)
	tooltip.AnchorPoint = Vector2.new(0, 1)
	tooltip.Position = UDim2.fromOffset(math.clamp(relative.X, 8, math.max(8, self.root.AbsoluteSize.X - width - 8)), relative.Y - 6)
	tooltip.Visible = true
end

function ChatUI.hideTooltip(self: ChatUI): ()
	self.tooltip.Visible = false
end

function ChatUI.setBusy(self: ChatUI, busy: boolean): ()
	self.busy = busy
	self.sendButton.Text = if busy then "…" else "Send"
	self.sendButton.Active = not busy
	self.sendButton.AutoButtonColor = not busy
	if busy then
		self:showTyping()
	else
		self:hideTyping()
	end
end

-- Animated "Thinking (Medium)… 1.4s" row: three tweened dots and a timer that
-- updates every 0.1 s. This is the only repeating loop in the UI; it stops in hideTyping.
function ChatUI.showTyping(self: ChatUI): ()
	self:hideTyping()
	local row = Ui.row(8, { Name = "Typing", LayoutOrder = TYPING_ORDER })
	local dots = Ui.create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(30, 16),
		LayoutOrder = 1,
		Parent = row,
	}, { Ui.hlist(4) })
	for i = 1, 3 do
		local dot = Ui.create("Frame", {
			Size = UDim2.fromOffset(6, 6),
			BorderSizePixel = 0,
			LayoutOrder = i,
			Parent = dots,
		}, { Ui.corner(3) }) :: Frame
		Theme.paint(dot, "BackgroundColor3", Theme.accent)
		local tween = TweenService:Create(
			dot,
			TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, (i - 1) * 0.15),
			{ BackgroundTransparency = 0.85 }
		)
		tween:Play()
		table.insert(self.typingTweens, tween)
	end
	local label = Ui.create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 16),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = Theme.FONT_MEDIUM,
		TextSize = Ui.SMALL_TEXT,
		Text = "",
		LayoutOrder = 2,
		Parent = row,
	}) :: TextLabel
	Theme.paint(label, "TextColor3", Theme.dimText)

	local prefix = "Thinking (" .. self:thinkingLabel() .. ")… "
	local started = os.clock()
	label.Text = prefix .. "0.0s"
	self.typing = row
	self.messageCount += 1
	row.Parent = self.messages
	self:refreshBody()
	self.stickToBottom = true
	self:scrollToBottom()
	self.typingThread = task.spawn(function()
		while row.Parent ~= nil do
			task.wait(0.1)
			label.Text = prefix .. string.format("%.1fs", os.clock() - started)
		end
	end)
end

function ChatUI.hideTyping(self: ChatUI): ()
	local thread = self.typingThread
	self.typingThread = nil
	if thread and coroutine.status(thread) ~= "dead" and thread ~= coroutine.running() then
		pcall(task.cancel, thread)
	end
	for _, tween in ipairs(self.typingTweens) do
		tween:Cancel()
	end
	table.clear(self.typingTweens)
	if self.typing then
		self.typing:Destroy()
		self.typing = nil
		self.messageCount = math.max(0, self.messageCount - 1)
		self:refreshBody()
	end
end

---------------------------------------------------------------------------
-- Message list
---------------------------------------------------------------------------

function ChatUI.nextOrder(self: ChatUI): number
	self.order += 1
	return self.order
end

function ChatUI.bubbleLimit(self: ChatUI): number
	local width = self.messages.AbsoluteSize.X - 24 - self.messages.ScrollBarThickness
	return math.max(120, math.floor(width * USER_BUBBLE_FRACTION))
end

-- Append any frame (e.g. an action card) to the message list.
function ChatUI.append(self: ChatUI, frame: GuiObject): ()
	frame.LayoutOrder = self:nextOrder()
	frame.Parent = self.messages
	self.messageCount += 1
	self:refreshBody()
	self.stickToBottom = true
	self:scrollToBottom()
end

-- Smoothly scroll to the bottom once layout has settled (AutomaticCanvasSize
-- updates a frame later). `instant` skips the tween (used while content grows).
function ChatUI.scrollToBottom(self: ChatUI, instant: boolean?): ()
	task.defer(function()
		local messages = self.messages
		if messages.Parent == nil then
			return
		end
		local maxY = math.max(0, messages.AbsoluteCanvasSize.Y - messages.AbsoluteWindowSize.Y)
		local target = Vector2.new(0, maxY)
		if self.scrollTween then
			self.scrollTween:Cancel()
			self.scrollTween = nil
		end
		if instant or math.abs(messages.CanvasPosition.Y - maxY) < 4 then
			messages.CanvasPosition = target
			return
		end
		local tween = TweenService:Create(messages, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CanvasPosition = target,
		})
		self.scrollTween = tween
		tween:Play()
	end)
end

function ChatUI.addUserMessage(self: ChatUI, text: string): Frame
	local row = Ui.create("Frame", {
		Name = "UserMessage",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, { Ui.hlist(0, Enum.HorizontalAlignment.Right) }) :: Frame
	local bubble = Ui.create("Frame", {
		Name = "Bubble",
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BorderSizePixel = 0,
		Parent = row,
	}, { Ui.corner(12), Ui.padding(7, 12) }) :: Frame
	Theme.paint(bubble, "BackgroundColor3", Theme.userBubble)
	local label = Ui.label(text, {
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		Parent = bubble,
	})
	local limit = Ui.create("UISizeConstraint", {
		MaxSize = Vector2.new(self:bubbleLimit() - 24, math.huge),
		Parent = label,
	}) :: UISizeConstraint
	table.insert(self.bubbleLimits, limit)
	self:append(row)
	return row
end

local function formatSeconds(ms: number): string
	return string.format("%.1fs", ms / 1000)
end

-- Collapsible "Thought for 1.2s · 6 steps" block; collapsed by default.
local function thinkingBlock(thinking: any, levels: { ThinkingLevel }): Frame?
	if typeof(thinking) ~= "table" then
		return nil
	end
	local steps = if typeof(thinking.steps) == "table" then thinking.steps else {}
	local elapsed = if typeof(thinking.elapsed_ms) == "number" then thinking.elapsed_ms else 0
	local header = "Thought for " .. formatSeconds(elapsed) .. " · " .. tostring(#steps) .. (if #steps == 1 then " step" else " steps")
	if typeof(thinking.level) == "string" then
		header ..= " · " .. levelById(levels, thinking.level).label
	end

	local frame = Ui.create("Frame", {
		Name = "Thinking",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, { Ui.vlist(4) }) :: Frame
	local toggle = Ui.create("TextButton", {
		Name = "Toggle",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		AutoButtonColor = false,
		Font = Theme.FONT_MEDIUM,
		TextSize = Ui.SMALL_TEXT,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "▸  " .. header,
		LayoutOrder = 1,
		Parent = frame,
	}) :: TextButton
	Theme.paint(toggle, "TextColor3", Theme.dimText)

	local details = Ui.create("Frame", {
		Name = "Steps",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		LayoutOrder = 2,
		Parent = frame,
	}, { Ui.padding(2, 0, 2, 12), Ui.vlist(4) }) :: Frame
	local rail = Ui.create("Frame", {
		Size = UDim2.new(0, 2, 1, 0),
		Position = UDim2.fromOffset(-10, 0),
		BorderSizePixel = 0,
		Parent = details,
	})
	Theme.paint(rail, "BackgroundColor3", Theme.hairline)
	if typeof(thinking.summary) == "string" and thinking.summary ~= "" then
		local summary = Ui.label(thinking.summary, { TextSize = Ui.SMALL_TEXT, Font = Theme.FONT_MEDIUM, LayoutOrder = 0, Parent = details })
		Theme.paint(summary, "TextColor3", Theme.dimText)
	end
	for index, step in ipairs(steps) do
		if typeof(step) == "table" then
			local text = Markdown.escape(tostring(step.label or ("Step " .. tostring(index))))
			if typeof(step.detail) == "string" and step.detail ~= "" then
				text ..= ' <font transparency="0.35">· ' .. Markdown.escape(step.detail) .. "</font>"
			end
			if typeof(step.ms) == "number" then
				text ..= ' <font transparency="0.5">(' .. tostring(math.floor(step.ms)) .. " ms)</font>"
			end
			local line = Ui.label(tostring(index) .. ".  " .. text, {
				RichText = true,
				TextSize = Ui.SMALL_TEXT,
				LayoutOrder = index,
				Parent = details,
			})
			Theme.paint(line, "TextColor3", Theme.dimText)
		end
	end
	toggle.MouseButton1Click:Connect(function()
		details.Visible = not details.Visible
		toggle.Text = (if details.Visible then "▾  " else "▸  ") .. header
	end)
	return frame
end

-- Render an assistant reply: optional thinking block, markdown (headings, prose,
-- code panels with Select / Insert), then a footer of chips (source, checks).
function ChatUI.addAssistantMessage(self: ChatUI, markdown: string, extras: AssistantExtras?): Frame
	local frame = Ui.create("Frame", {
		Name = "AssistantMessage",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, { Ui.vlist(8) }) :: Frame
	local order = 1
	local info = extras or {}

	local block = thinkingBlock(info.thinking, self.levels)
	if block then
		block.LayoutOrder = order
		block.Parent = frame
		order += 1
	end

	local codeHex = Theme.inlineCodeHex()
	for _, segment in ipairs(Markdown.parse(markdown)) do
		local element: GuiObject
		if segment.kind == "code" then
			element = Ui.codeBlock(segment.text, CODE_PREVIEW_LINES, { language = segment.language, onInsert = info.onInsert })
		elseif segment.kind == "heading" then
			local level = segment.level or 2
			element = Ui.label(Markdown.toRichText(segment.text, codeHex), {
				RichText = true,
				Font = Theme.FONT_BOLD,
				TextSize = if level == 1 then 18 elseif level == 2 then 16 else 14,
			})
		else
			element = Ui.label(Markdown.toRichText(segment.text, codeHex), { RichText = true, LineHeight = 1.1 })
		end
		element.LayoutOrder = order
		element.Parent = frame
		order += 1
	end

	-- Footer chips.
	local chips: { Frame } = {}
	if typeof(info.source) == "string" and info.source ~= "" then
		local chip = Ui.chip(info.source)
		chip.Name = "Source"
		table.insert(chips, chip)
	end
	local verification = info.verification
	if typeof(verification) == "table" and #verification > 0 then
		local passed, total = 0, 0
		for _, entry in ipairs(verification) do
			if typeof(entry) == "table" then
				total += 1
				if entry.ok == true then
					passed += 1
				end
			end
		end
		if total > 0 then
			local ok = passed == total
			local chip = Ui.chip((if ok then "✓ " else "✕ ") .. tostring(passed) .. "/" .. tostring(total) .. " checks",
				if ok then Theme.success else Theme.warning)
			chip.Name = "Checks"
			table.insert(chips, chip)
		end
	end
	if #chips > 0 then
		local footer = Ui.row(6, { Name = "Footer", LayoutOrder = order })
		for index, chip in ipairs(chips) do
			chip.LayoutOrder = index
			chip.Parent = footer
		end
		footer.Parent = frame
	end

	self:append(frame)
	return frame
end

function ChatUI.addNotice(self: ChatUI, kind: NoticeKind, text: string): Frame
	local colorFn: () -> Color3 = Theme.dimText
	local glyph = "ℹ"
	if kind == "error" then
		colorFn, glyph = Theme.error, "✕"
	elseif kind == "warning" then
		colorFn, glyph = Theme.warning, "!"
	elseif kind == "success" then
		colorFn, glyph = Theme.success, "✓"
	end
	local row = Ui.create("Frame", {
		Name = "Notice",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
	}, { Ui.corner(6), Ui.padding(6, 10) }) :: Frame
	Theme.paint(row, "BackgroundColor3", Theme.subtle)
	local label = Ui.label(glyph .. "  " .. text, { TextSize = Ui.SMALL_TEXT, TextColor3 = colorFn(), Parent = row })
	Theme.paint(label, "TextColor3", colorFn)
	self:append(row)
	return row
end

-- Remember a connection to something outside the message list so clear() can
-- disconnect it (connections on message instances die with Destroy()).
function ChatUI.track(self: ChatUI, connection: RBXScriptConnection): ()
	table.insert(self.messageConnections, connection)
end

-- New chat: drop every message, its connections and the typing indicator.
function ChatUI.clear(self: ChatUI): ()
	self:hideTyping()
	if self.closeMenu then
		self.closeMenu()
		self.closeMenu = nil
	end
	for _, connection in ipairs(self.messageConnections) do
		connection:Disconnect()
	end
	table.clear(self.messageConnections)
	table.clear(self.bubbleLimits)
	for _, child in ipairs(self.messages:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	self.order = 0
	self.messageCount = 0
	self.stickToBottom = true
	self.messages.CanvasPosition = Vector2.zero
	self:refreshBody()
end

function ChatUI.focusInput(self: ChatUI): ()
	self.input:CaptureFocus()
end

return ChatUI
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX153ABC58BAF8C96151CCCBAFBE9FFD76">
      <Properties>
        <string name="Name">Context</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Context: collects what the user is looking at, for POST /chat `context`.
--   selection  - Selection:Get() as {path, className, name}
--   openScript - StudioService.ActiveScript path + source, when a script tab is active
-- Sizes are capped so a request stays well below the server's 1 MiB limit.

local Selection = game:GetService("Selection")

local PathResolver = require(script.Parent.PathResolver)

local Context = {}

local MAX_SELECTION = 50
local MAX_SOURCE_CHARS = 200000

export type SelectionItem = { path: string, className: string, name: string }
export type OpenScript = { path: string, source: string }
export type Payload = { selection: { SelectionItem }, openScript: OpenScript? }

function Context.selection(): { SelectionItem }
	local items: { SelectionItem } = {}
	for _, instance in ipairs(Selection:Get()) do
		if #items >= MAX_SELECTION then
			break
		end
		local path = PathResolver.pathOf(instance)
		if path then
			table.insert(items, { path = path, className = instance.ClassName, name = instance.Name })
		end
	end
	return items
end

function Context.openScript(): OpenScript?
	local ok, active = pcall(function()
		return (game:GetService("StudioService") :: any).ActiveScript
	end)
	if not ok or typeof(active) ~= "Instance" or not active:IsA("LuaSourceContainer") then
		return nil
	end
	local path = PathResolver.pathOf(active)
	if path == nil then
		return nil
	end
	local sourceOk, source = pcall(function()
		return game:GetService("ScriptEditorService"):GetEditorSource(active)
	end)
	if not sourceOk or typeof(source) ~= "string" then
		local propertyOk, propertySource = pcall(function()
			return (active :: any).Source
		end)
		if not propertyOk or typeof(propertySource) ~= "string" then
			return nil
		end
		source = propertySource
	end
	if #source > MAX_SOURCE_CHARS then
		source = source:sub(1, MAX_SOURCE_CHARS) .. "\n-- [GODMODE: source truncated by the plugin]"
	end
	return { path = path, source = source }
end

function Context.collect(): Payload
	return { selection = Context.selection(), openScript = Context.openScript() }
end

return Context
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX2D05A3DA7754F5BD304DD6D9807141E5">
      <Properties>
        <string name="Name">HttpClient</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- HttpClient: JSON-over-HTTP calls to the local GODMODE server.
-- All network access goes through HttpService:RequestAsync inside pcall, with a
-- client-side timeout, and every failure is turned into a human-readable message.

local HttpService = game:GetService("HttpService")

local HttpClient = {}
HttpClient.__index = HttpClient

export type Response = {
	ok: boolean,
	status: number,
	body: any,
	error: string?,
}

export type Client = typeof(setmetatable(
	{} :: { baseUrl: string, token: string?, timeout: number },
	HttpClient
))

local DEFAULT_TIMEOUT = 120

local PERMISSION_HELP = "Studio blocked the HTTP request. (1) When Studio asks whether GODMODE may "
	.. "send HTTP requests to 127.0.0.1, choose Allow; if you dismissed that prompt, open "
	.. "Plugins > Manage Plugins, find GODMODE and allow its HTTP access. (2) Make sure "
	.. "Game Settings > Security > Allow HTTP Requests is on for this place."

function HttpClient.new(baseUrl: string, token: string?, timeout: number?): Client
	local self = setmetatable({
		baseUrl = HttpClient.normaliseUrl(baseUrl),
		token = if token ~= nil and token ~= "" then token else nil,
		timeout = timeout or DEFAULT_TIMEOUT,
	}, HttpClient)
	return self
end

-- Strip whitespace and trailing slashes; default to http:// when no scheme is given.
function HttpClient.normaliseUrl(url: string): string
	local trimmed = url:match("^%s*(.-)%s*$") or url
	trimmed = trimmed:gsub("/+$", "")
	if not trimmed:match("^https?://") then
		trimmed = "http://" .. trimmed
	end
	return trimmed
end

-- Translate a raw RequestAsync error into a helpful message.
function HttpClient.explainError(message: string): string
	local lower = message:lower()
	if lower:find("not enabled", 1, true)
		or lower:find("permission", 1, true)
		or lower:find("not allowed", 1, true)
		or lower:find("denied", 1, true)
	then
		return PERMISSION_HELP .. " (Studio said: " .. message .. ")"
	end
	if lower:find("connectfail", 1, true)
		or lower:find("couldn't connect", 1, true)
		or lower:find("connection refused", 1, true)
		or lower:find("httperror", 1, true)
	then
		return "Could not reach the GODMODE server. Is it running? Start it with "
			.. "`python -m godmode.server` and check the server URL in settings. (" .. message .. ")"
	end
	return message
end

-- Run RequestAsync on its own thread and race it against a timeout.
local function requestWithTimeout(options: { [string]: any }, timeout: number): (boolean, any)
	local finished = false
	local success = false
	local payload: any = nil
	local signal = Instance.new("BindableEvent")

	task.spawn(function()
		local ok, result = pcall(function()
			return HttpService:RequestAsync(options :: any)
		end)
		if not finished then
			finished = true
			success = ok
			payload = result
			signal:Fire()
		end
	end)

	task.delay(timeout, function()
		if not finished then
			finished = true
			success = false
			payload = "request timed out after " .. tostring(timeout) .. " seconds"
			signal:Fire()
		end
	end)

	if not finished then
		signal.Event:Wait()
	end
	signal:Destroy()
	return success, payload
end

function HttpClient.request(self: Client, method: string, path: string, body: any?): Response
	local headers: { [string]: string } = {
		["Accept"] = "application/json",
	}
	if self.token then
		-- docs/PLUGIN_PROTOCOL.md: optional shared secret header.
		headers["X-Godmode-Token"] = self.token
	end

	local options: { [string]: any } = {
		Url = self.baseUrl .. path,
		Method = method,
		Headers = headers,
	}

	if body ~= nil then
		local encodedOk, encoded = pcall(function()
			return HttpService:JSONEncode(body)
		end)
		if not encodedOk then
			return { ok = false, status = 0, body = nil, error = "could not encode request: " .. tostring(encoded) }
		end
		headers["Content-Type"] = "application/json"
		options.Body = encoded
	end

	local ok, result = requestWithTimeout(options, self.timeout)
	if not ok then
		return { ok = false, status = 0, body = nil, error = HttpClient.explainError(tostring(result)) }
	end

	local decoded: any = nil
	local rawBody = result.Body
	if typeof(rawBody) == "string" and rawBody ~= "" then
		local decodeOk, value = pcall(function()
			return HttpService:JSONDecode(rawBody)
		end)
		if decodeOk then
			decoded = value
		end
	end

	if not result.Success then
		local detail = ""
		-- Protocol error shape: {"ok": false, "error": {"code": "...", "message": "..."}}
		if typeof(decoded) == "table" and typeof(decoded.error) == "table" then
			local code = decoded.error.code
			local text = decoded.error.message
			detail = ": " .. (if typeof(code) == "string" then code .. " - " else "")
				.. (if typeof(text) == "string" then text else "")
		elseif typeof(decoded) == "table" and typeof(decoded.error) == "string" then
			detail = ": " .. decoded.error
		elseif typeof(rawBody) == "string" then
			detail = ": " .. rawBody:sub(1, 300)
		end
		local message = "server returned HTTP " .. tostring(result.StatusCode) .. detail
		if result.StatusCode == 401 or result.StatusCode == 403 then
			message ..= " (check the access token in GODMODE Settings; it must match the server's --token)"
		end
		return { ok = false, status = result.StatusCode, body = decoded, error = message }
	end

	if typeof(decoded) ~= "table" then
		return { ok = false, status = result.StatusCode, body = nil, error = "server response was not a JSON object" }
	end

	if typeof(decoded) == "table" and decoded.ok == false then
		local message = "server reported an error"
		if typeof(decoded.error) == "table" and typeof(decoded.error.message) == "string" then
			message ..= ": " .. decoded.error.message
		end
		return { ok = false, status = result.StatusCode, body = decoded, error = message }
	end

	return { ok = true, status = result.StatusCode, body = decoded, error = nil }
end

function HttpClient.get(self: Client, path: string): Response
	return self:request("GET", path, nil)
end

function HttpClient.post(self: Client, path: string, body: any): Response
	return self:request("POST", path, body)
end

return HttpClient
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX8D8B82D87C76B410A12F39B67264F4F8">
      <Properties>
        <string name="Name">Markdown</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- Markdown: a deliberately small markdown subset for chat replies.
--   * fenced code blocks (```lang ... ```) become separate "code" segments
--   * "# heading" lines become separate "heading" segments (level 1-3)
--   * inside prose: **bold**, *italic*, _italic line_, `inline code`,
--     "- " / "* " bullets and "1. " numbered lists
-- Everything else is shown as plain text. Prose is escaped before rich-text tags
-- are added, so server text can never inject arbitrary rich-text markup.

local Markdown = {}

export type Segment = {
	kind: "text" | "code" | "heading",
	text: string,
	language: string?,
	level: number?,
}

-- Escape the five characters that RichText treats as markup.
function Markdown.escape(text: string): string
	local escaped = text:gsub("&", "&amp;")
	escaped = escaped:gsub("<", "&lt;")
	escaped = escaped:gsub(">", "&gt;")
	escaped = escaped:gsub('"', "&quot;")
	escaped = escaped:gsub("'", "&apos;")
	return escaped
end

-- Split markdown into prose, heading and fenced-code segments, preserving order.
function Markdown.parse(source: string): { Segment }
	local segments: { Segment } = {}
	local prose: { string } = {}
	local code: { string } = {}
	local inCode = false
	local language: string? = nil

	local function flushProse()
		if #prose > 0 then
			local text = table.concat(prose, "\n")
			-- Trim blank lines at the ends; keep inner blank lines as paragraph breaks.
			text = text:gsub("^%s*\n", ""):gsub("\n%s*$", "")
			if text:match("%S") then
				table.insert(segments, { kind = "text", text = text })
			end
			table.clear(prose)
		end
	end

	-- Normalise line endings, then walk line by line.
	local normalised = source:gsub("\r\n", "\n")
	for line in (normalised .. "\n"):gmatch("([^\n]*)\n") do
		local fence = line:match("^%s*```%s*([%w_%+%-]*)%s*$")
		if fence ~= nil then
			if inCode then
				table.insert(segments, { kind = "code", text = table.concat(code, "\n"), language = language })
				table.clear(code)
				inCode = false
				language = nil
			else
				flushProse()
				inCode = true
				language = if fence ~= "" then string.lower(fence) else nil
			end
		elseif inCode then
			table.insert(code, line)
		else
			local hashes, heading = line:match("^%s*(#+)%s+(.-)%s*#*%s*$")
			if hashes and heading and heading ~= "" then
				flushProse()
				table.insert(segments, { kind = "heading", text = heading, level = math.min(#hashes, 3) })
			else
				table.insert(prose, line)
			end
		end
	end

	if inCode then
		-- Unterminated fence: still show the code rather than dropping it.
		table.insert(segments, { kind = "code", text = table.concat(code, "\n"), language = language })
	end
	flushProse()
	return segments
end

local PLACEHOLDER_OPEN = "\1"
local PLACEHOLDER_CLOSE = "\2"

-- Inline formatting of one already-split line. `codeHex` colours inline code.
local function inline(line: string, codeHex: string): string
	-- 1. Pull inline code out first so its contents are never formatted.
	local spans: { string } = {}
	local protected = line:gsub("`([^`]+)`", function(inner: string)
		table.insert(spans, inner)
		return PLACEHOLDER_OPEN .. tostring(#spans) .. PLACEHOLDER_CLOSE
	end)
	-- 2. Escape, then add tags.
	local escaped = Markdown.escape(protected)
	escaped = escaped:gsub("%*%*(.-)%*%*", "<b>%1</b>")
	escaped = escaped:gsub("__(.-)__", "<b>%1</b>")
	escaped = escaped:gsub("%*([^%*%s][^%*]-)%*", "<i>%1</i>")
	escaped = escaped:gsub("^_([^_].-)_$", "<i>%1</i>")
	-- 3. Put inline code back, escaped, in the monospace face.
	escaped = escaped:gsub(PLACEHOLDER_OPEN .. "(%d+)" .. PLACEHOLDER_CLOSE, function(index: string)
		local span = spans[tonumber(index) :: number] or ""
		return '<font face="RobotoMono" color="' .. codeHex .. '">' .. Markdown.escape(span) .. "</font>"
	end)
	return escaped
end

-- Convert a prose segment into RichText markup (escaped first, then tags added).
function Markdown.toRichText(text: string, codeHex: string?): string
	local hex = codeHex or "#C8783C"
	local lines: { string } = {}
	for line in (text .. "\n"):gmatch("([^\n]*)\n") do
		-- Strip the two control characters used as placeholders, should they appear.
		local clean = line:gsub("[\1\2]", "")
		local indent, bullet, rest = clean:match("^(%s*)([%-%*%+])%s+(.*)$")
		local numIndent, number, numRest = clean:match("^(%s*)(%d+)[%.%)]%s+(.*)$")
		local heading = clean:match("^%s*#+%s+(.*)$")
		local rendered: string
		if bullet and rest then
			rendered = string.rep("  ", math.floor(#(indent :: string) / 2)) .. "  •  " .. inline(rest, hex)
		elseif number and numRest then
			rendered = string.rep("  ", math.floor(#(numIndent :: string) / 2)) .. "  " .. number .. ".  " .. inline(numRest, hex)
		elseif heading then
			rendered = "<b>" .. inline(heading, hex) .. "</b>"
		else
			rendered = inline(clean, hex)
		end
		table.insert(lines, rendered)
	end
	return table.concat(lines, "\n")
end

return Markdown
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX617378932791973EA76392E29D97B5AB">
      <Properties>
        <string name="Name">OfflineData</string>
        <ProtectedString name="Source"><![CDATA[--!strict
-- GENERATED by `python -m godmode.export_offline` -- do not edit by hand.
-- Each entry is a real, verified response of the GODMODE tool server, embedded as JSON
-- so the plugin works with no server. Decoded with HttpService:JSONDecode.

export type Entry = { key: string, keywords: { string }, animation: boolean, json: string }

local entries: { Entry } = {
	{
		key = "obby",
		keywords = { "obby", "parkour", "obstacle", "platform", "kill brick", "parcours", "obst\u00e1culo" },
		animation = false,
		json = [[{"ok":true,"reply_markdown":"**Source:** `tool:obby` - a deterministic template generator chosen by the keyword router (confidence 1.00); this is not neural-model output. Verification: 3/3 checks passed.\n\nAn obby with a spawn, **10 platforms** (6-stud, 12 studs apart, gently rising), 4 neon kill bricks tagged `GodmodeKillBrick`, and a finish pad. Kills are handled **on the server** by a CollectionService script (players only, per-character debounce, connections cleaned up when a brick is removed).\n\n**Proposed only - nothing has been changed in Studio.** 2 action(s) await your approval in the plugin:\n- `a1` create_instances: Build obby\n- `a2` create_script: Kill brick handler","source":"offline:tool:obby","intent":{"name":"build_obby","confidence":1.0,"router":"keyword-regex","params":{"count":10,"count_noun":"platforms"}},"actions":[{"type":"create_instances","description":"Build obby","parent_path":"Workspace","tree":{"className":"Model","name":"GodmodeObby","properties":{},"children":[{"className":"SpawnLocation","name":"Start","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[12.0,1.0,12.0]},"CFrame":{"$type":"CFrame","position":[0,0.5,0],"rotation":[0,0,0]},"Neutral":true,"Duration":0,"Color":{"$type":"Color3","rgb":[75,151,75]},"Material":{"$enum":"Material.SmoothPlastic"}},"children":[]},{"className":"Part","name":"Platform001","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[6.0,1.0,6.0]},"CFrame":{"$type":"CFrame","position":[12.0,1.5,-0.704],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[13,105,172]},"Material":{"$enum":"Material.SmoothPlastic"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]},{"className":"Part","name":"Platform002","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[6.0,1.0,6.0]},"CFrame":{"$type":"CFrame","position":[24.0,1.5,1.774],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[13,105,172]},"Material":{"$enum":"Material.SmoothPlastic"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]},{"className":"Part","name":"KillBrick001","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[2.0,1.0,6.0]},"CFrame":{"$type":"CFrame","position":[30.0,-1.5,1.774],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[255,0,0]},"Material":{"$enum":"Material.Neon"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[],"tags":["GodmodeKillBrick"]},{"className":"Part","name":"Platform003","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[6.0,1.0,6.0]},"CFrame":{"$type":"CFrame","position":[36.0,3.5,2.434],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[13,105,172]},"Material":{"$enum":"Material.SmoothPlastic"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]},{"className":"Part","name":"Platform004","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[6.0,1.0,6.0]},"CFrame":{"$type":"CFrame","position":[48.0,3.5,-0.958],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[13,105,172]},"Material":{"$enum":"Material.SmoothPlastic"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]},{"className":"Part","name":"KillBrick002","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[2.0,1.0,6.0]},"CFrame":{"$type":"CFrame","position":[54.0,0.5,-0.958],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[255,0,0]},"Material":{"$enum":"Material.Neon"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[],"tags":["GodmodeKillBrick"]},{"className":"Part","name":"Platform005","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[6.0,1.0,6.0]},"CFrame":{"$type":"CFrame","position":[60.0,3.5,-1.092],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[13,105,172]},"Material":{"$enum":"Material.SmoothPlastic"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]},{"className":"Part","name":"Platform006","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[6.0,1.0,6.0]},"CFrame":{"$type":"CFrame","position":[72.0,4.5,-0.69],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[13,105,172]},"Material":{"$enum":"Material.SmoothPlastic"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]},{"className":"Part","name":"KillBrick003","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[2.0,1.0,6.0]},"CFrame":{"$type":"CFrame","position":[78.0,1.5,-0.69],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[255,0,0]},"Material":{"$enum":"Material.Neon"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[],"tags":["GodmodeKillBrick"]},{"className":"Part","name":"Platform007","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[6.0,1.0,6.0]},"CFrame":{"$type":"CFrame","position":[84.0,4.5,-1.911],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[13,105,172]},"Material":{"$enum":"Material.SmoothPlastic"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]},{"className":"Part","name":"Platform008","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[6.0,1.0,6.0]},"CFrame":{"$type":"CFrame","position":[96.0,4.5,1.738],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[13,105,172]},"Material":{"$enum":"Material.SmoothPlastic"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]},{"className":"Part","name":"KillBrick004","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[2.0,1.0,6.0]},"CFrame":{"$type":"CFrame","position":[102.0,1.5,1.738],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[255,0,0]},"Material":{"$enum":"Material.Neon"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[],"tags":["GodmodeKillBrick"]},{"className":"Part","name":"Platform009","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[6.0,1.0,6.0]},"CFrame":{"$type":"CFrame","position":[108.0,5.5,-0.325],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[13,105,172]},"Material":{"$enum":"Material.SmoothPlastic"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]},{"className":"Part","name":"Platform010","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[6.0,1.0,6.0]},"CFrame":{"$type":"CFrame","position":[120.0,6.5,-0.158],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[13,105,172]},"Material":{"$enum":"Material.SmoothPlastic"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]},{"className":"Part","name":"Finish","properties":{"Anchored":true,"Size":{"$type":"Vector3","value":[12.0,1.0,12.0]},"CFrame":{"$type":"CFrame","position":[132.0,6.5,0.0],"rotation":[0.0,0.0,0.0]},"Color":{"$type":"Color3","rgb":[245,205,48]},"Material":{"$enum":"Material.Neon"},"TopSurface":{"$enum":"SurfaceType.Smooth"},"BottomSurface":{"$enum":"SurfaceType.Smooth"}},"children":[]}]},"destructive":false,"id":"a1","requires_approval":true},{"type":"create_script","description":"Kill brick handler","parent_path":"ServerScriptService","name":"GodmodeKillBricks","class":"Script","source":"-- Generated by GODMODE tool:obby (deterministic template, verified by godmode.luau; not neural-model output)\n-- Server-side kill bricks: any part tagged \"GodmodeKillBrick\" resets the character that touches it.\nlocal CollectionService = game:GetService(\"CollectionService\")\nlocal Players = game:GetService(\"Players\")\n\nlocal TAG = \"GodmodeKillBrick\"\nlocal connections = {}\nlocal recentlyKilled = {}\n\nlocal function onTouched(hit: BasePart)\n\tlocal character = hit.Parent\n\tif character == nil or recentlyKilled[character] then\n\t\treturn\n\tend\n\tlocal humanoid = character:FindFirstChildOfClass(\"Humanoid\")\n\tif humanoid == nil or humanoid.Health <= 0 then\n\t\treturn\n\tend\n\tif Players:GetPlayerFromCharacter(character) == nil then\n\t\treturn\n\tend\n\trecentlyKilled[character] = true\n\thumanoid.Health = 0\n\ttask.delay(1, function()\n\t\trecentlyKilled[character] = nil\n\tend)\nend\n\nlocal function register(instance: Instance)\n\tif not instance:IsA(\"BasePart\") or connections[instance] then\n\t\treturn\n\tend\n\tconnections[instance] = instance.Touched:Connect(onTouched)\nend\n\nlocal function unregister(instance: Instance)\n\tlocal connection = connections[instance]\n\tif connection then\n\t\tconnection:Disconnect()\n\t\tconnections[instance] = nil\n\tend\nend\n\nCollectionService:GetInstanceAddedSignal(TAG):Connect(register)\nCollectionService:GetInstanceRemovedSignal(TAG):Connect(unregister)\nfor _, instance in ipairs(CollectionService:GetTagged(TAG)) do\n\tregister(instance)\nend\n","destructive":false,"id":"a2","requires_approval":true}],"verification":[{"check":"tree:Workspace.GodmodeObby","ok":true,"detail":"17 instance(s), property encoding valid"},{"check":"structure:ServerScriptService.GodmodeKillBricks","ok":true,"detail":"balanced blocks/brackets, lexically valid"},{"check":"lint:ServerScriptService.GodmodeKillBricks","ok":true,"detail":"no findings"}],"warnings":["Offline mode: this is the default version of this build/script. Edit it after applying, or enable the optional GODMODE server (/server on) for custom sizes, counts and colors."],"autonomy":3,"applied":false}]],
