	{
		key = "remote_event",
		keywords = { "remote", "remoteevent", "fireserver", "client to server", "network", "remoto", "\u00e9v\u00e9nement distant", "evento remoto" },
		animation = false,
		json = [[{"ok":true,"reply_markdown":"**Source:** `tool:remote_event` - a deterministic template generator chosen by the keyword router (confidence 1.00); this is not neural-model output. Verification: 4/4 checks passed.\n\nA validated RemoteEvent system named `GodmodeAction`:\n\n- **Server** (`ServerScriptService`): creates `ReplicatedStorage.Remotes.GodmodeAction`, type-checks every argument (`typeof`, NaN and range checks), allow-lists actions, rate limits per player (8 calls/s) and clears state on `PlayerRemoving`.\n- **Client** (`StarterPlayerScripts`): fires the remote on **E** with a client-side cooldown (cosmetic only; the server limit is the real one).\n\nPut your game logic in `handleAction`.\n\n**Proposed only - nothing has been changed in Studio.** 2 action(s) await your approval in the plugin:\n- `a1` create_script: Server handler for GodmodeAction\n- `a2` create_script: Client caller for GodmodeAction","source":"offline:tool:remote_event","intent":{"name":"remote_event","confidence":1.0,"router":"keyword-regex","params":{}},"actions":[{"type":"create_script","description":"Server handler for GodmodeAction","parent_path":"ServerScriptService","name":"GodmodeActionServer","class":"Script","source":"-- Generated by GODMODE tool:remote_event (deterministic template, verified by godmode.luau; not neural-model output)\n-- Server side of the GodmodeAction RemoteEvent. The client only REQUESTS an action;\n-- every argument is type-checked, range-checked and rate limited here.\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal REMOTE_NAME = \"GodmodeAction\"\nlocal MAX_CALLS_PER_WINDOW = 8\nlocal WINDOW_SECONDS = 1\nlocal MAX_AMOUNT = 100\nlocal ALLOWED_ACTIONS = {\n\tUse = true,\n\tInteract = true,\n\tEmote = true,\n}\n\nlocal remotesFolder = ReplicatedStorage:FindFirstChild(\"Remotes\")\nif not remotesFolder then\n\tremotesFolder = Instance.new(\"Folder\")\n\tremotesFolder.Name = \"Remotes\"\n\tremotesFolder.Parent = ReplicatedStorage\nend\n\nlocal remote = remotesFolder:FindFirstChild(REMOTE_NAME)\nif not remote then\n\tremote = Instance.new(\"RemoteEvent\")\n\tremote.Name = REMOTE_NAME\n\tremote.Parent = remotesFolder\nend\n\nlocal callLog = {}\n\nlocal function isRateLimited(player: Player): boolean\n\tlocal now = os.clock()\n\tlocal entry = callLog[player]\n\tif entry == nil or now - entry.windowStart >= WINDOW_SECONDS then\n\t\tcallLog[player] = { count = 1, windowStart = now }\n\t\treturn false\n\tend\n\tentry.count += 1\n\treturn entry.count > MAX_CALLS_PER_WINDOW\nend\n\nlocal function handleAction(player: Player, action: string, amount: number)\n\t-- Server-authoritative game logic goes here. Never trust the client for\n\t-- damage, currency or positions: recompute them from server state.\n\tprint((\"%s requested %s x%d\"):format(player.Name, action, amount))\nend\n\nremote.OnServerEvent:Connect(function(player: Player, action: unknown, amount: unknown)\n\tif isRateLimited(player) then\n\t\treturn\n\tend\n\tif typeof(action) ~= \"string\" or #action > 32 or ALLOWED_ACTIONS[action] ~= true then\n\t\treturn\n\tend\n\tif typeof(amount) ~= \"number\" or amount ~= amount or amount < 1 or amount > MAX_AMOUNT then\n\t\treturn\n\tend\n\tlocal character = player.Character\n\tlocal humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n\tif humanoid == nil or humanoid.Health <= 0 then\n\t\treturn\n\tend\n\thandleAction(player, action, math.floor(amount))\nend)\n\nPlayers.PlayerRemoving:Connect(function(player: Player)\n\tcallLog[player] = nil\nend)\n","destructive":false,"id":"a1","requires_approval":true},{"type":"create_script","description":"Client caller for GodmodeAction","parent_path":"StarterPlayer.StarterPlayerScripts","name":"GodmodeActionClient","class":"LocalScript","source":"-- Generated by GODMODE tool:remote_event (deterministic template, verified by godmode.luau; not neural-model output)\n-- Client side of the GodmodeAction RemoteEvent: sends a request, the server decides.\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal ContextActionService = game:GetService(\"ContextActionService\")\n\nlocal remote = ReplicatedStorage:WaitForChild(\"Remotes\"):WaitForChild(\"GodmodeAction\")\nlocal CLIENT_COOLDOWN = 0.25\nlocal lastFire = 0\n\nlocal function request(action: string, amount: number)\n\tlocal now = os.clock()\n\tif now - lastFire < CLIENT_COOLDOWN then\n\t\treturn\n\tend\n\tlastFire = now\n\tremote:FireServer(action, amount)\nend\n\nContextActionService:BindAction(\"GodmodeGodmodeActionUse\", function(_, inputState)\n\tif inputState == Enum.UserInputState.Begin then\n\t\trequest(\"Use\", 1)\n\tend\n\treturn Enum.ContextActionResult.Pass\nend, false, Enum.KeyCode.E)\n","destructive":false,"id":"a2","requires_approval":true}],"verification":[{"check":"structure:ServerScriptService.GodmodeActionServer","ok":true,"detail":"balanced blocks/brackets, lexically valid"},{"check":"lint:ServerScriptService.GodmodeActionServer","ok":true,"detail":"no findings"},{"check":"structure:StarterPlayer.StarterPlayerScripts.GodmodeActionClient","ok":true,"detail":"balanced blocks/brackets, lexically valid"},{"check":"lint:StarterPlayer.StarterPlayerScripts.GodmodeActionClient","ok":true,"detail":"no findings"}],"warnings":["Offline mode: this is the default version of this build/script. Edit it after applying, or enable the optional GODMODE server (/server on) for custom sizes, counts and colors."],"autonomy":3,"applied":false}]],
	},
	{
		key = "leaderstats",
		keywords = { "leaderstats", "leaderboard", "coins", "cash", "stats", "classement", "pi\u00e8ces", "monedas", "argent", "dinero" },
		animation = false,
		json = [[{"ok":true,"reply_markdown":"**Source:** `tool:leaderstats` - a deterministic template generator chosen by the keyword router (confidence 1.00); this is not neural-model output. Verification: 2/2 checks passed.\n\nLeaderstats with `Coins` (IntValues) created on the server for every player, including players who joined before the script ran.\n\n**Proposed only - nothing has been changed in Studio.** 1 action(s) await your approval in the plugin:\n- `a1` create_script: Leaderstats setup","source":"offline:tool:leaderstats","intent":{"name":"leaderstats","confidence":1.0,"router":"keyword-regex","params":{}},"actions":[{"type":"create_script","description":"Leaderstats setup","parent_path":"ServerScriptService","name":"Leaderstats","class":"Script","source":"-- Generated by GODMODE tool:leaderstats (deterministic template, verified by godmode.luau; not neural-model output)\n-- Creates leaderstats for every player. Only server scripts may change these values.\nlocal Players = game:GetService(\"Players\")\n\nlocal STATS = {\n\t{ name = \"Coins\", default = 0 },\n}\n\nlocal function setupLeaderstats(player: Player)\n\tif player:FindFirstChild(\"leaderstats\") then\n\t\treturn\n\tend\n\tlocal folder = Instance.new(\"Folder\")\n\tfolder.Name = \"leaderstats\"\n\tfor _, stat in ipairs(STATS) do\n\t\tlocal value = Instance.new(\"IntValue\")\n\t\tvalue.Name = stat.name\n\t\tvalue.Value = stat.default\n\t\tvalue.Parent = folder\n\tend\n\tfolder.Parent = player\nend\n\nPlayers.PlayerAdded:Connect(setupLeaderstats)\nfor _, player in ipairs(Players:GetPlayers()) do\n\ttask.spawn(setupLeaderstats, player)\nend\n","destructive":false,"id":"a1","requires_approval":true}],"verification":[{"check":"structure:ServerScriptService.Leaderstats","ok":true,"detail":"balanced blocks/brackets, lexically valid"},{"check":"lint:ServerScriptService.Leaderstats","ok":true,"detail":"no findings"}],"warnings":["Offline mode: this is the default version of this build/script. Edit it after applying, or enable the optional GODMODE server (/server on) for custom sizes, counts and colors."],"autonomy":3,"applied":false}]],
	},
	{
