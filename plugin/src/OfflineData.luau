end\n\ttable.sort(points, function(a, b)\n\t\treturn a.Name < b.Name\n\tend)\n\treturn points\nend\n\nlocal function moveTo(humanoid: Humanoid, position: Vector3): boolean\n\tlocal finished = false\n\tlocal reached = false\n\tlocal connection = humanoid.MoveToFinished:Connect(function(success)\n\t\treached = success\n\t\tfinished = true\n\tend)\n\thumanoid:MoveTo(position)\n\tlocal started = os.clock()\n\twhile not finished and os.clock() - started < MOVE_TIMEOUT do\n\t\ttask.wait(0.1)\n\tend\n\tconnection:Disconnect()\n\treturn reached\nend\n\nlocal function followPath(npc: Model, humanoid: Humanoid, root: BasePart, target: Vector3)\n\tlocal path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })\n\tlocal ok = pcall(function()\n\t\tpath:ComputeAsync(root.Position, target)\n\tend)\n\tif not ok or path.Status ~= Enum.PathStatus.Success then\n\t\tmoveTo(humanoid, target)\n\t\treturn\n\tend\n\tfor _, waypoint in ipairs(path:GetWaypoints()) do\n\t\tif active[npc] ~= true or humanoid.Health <= 0 then\n\t\t\treturn\n\t\tend\n\t\tif waypoint.Action == Enum.PathWaypointAction.Jump then\n\t\t\thumanoid.Jump = true\n\t\tend\n\t\tif not moveTo(humanoid, waypoint.Position) then\n\t\t\treturn\n\t\tend\n\tend\nend\n\nlocal function patrol(npc: Instance)\n\tif not npc:IsA(\"Model\") or active[npc] then\n\t\treturn\n\tend\n\tlocal humanoid = npc:FindFirstChildOfClass(\"Humanoid\")\n\tlocal root = npc:FindFirstChild(\"HumanoidRootPart\")\n\tif humanoid == nil or root == nil or not root:IsA(\"BasePart\") then\n\t\twarn(\"GodmodePatrolNPC needs a Humanoid and HumanoidRootPart: \" .. npc:GetFullName())\n\t\treturn\n\tend\n\tactive[npc] = true\n\tpcall(function()\n\t\troot:SetNetworkOwner(nil)\n\tend)\n\tlocal diedConnection = humanoid.Died:Connect(function()\n\t\tactive[npc] = nil\n\tend)\n\ttask.spawn(function()\n\t\twhile active[npc] == true and npc.Parent ~= nil do\n\t\t\tlocal points = sortedPoints()\n\t\t\tif #points == 0 then\n\t\t\t\ttask.wait(1)\n\t\t\tend\n\t\t\tfor _, point in ipairs(points) do\n\t\t\t\tif active[npc] ~= true then\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\t\tfollowPath(npc, humanoid, root, point.Position)\n\t\t\t\ttask.wait(PAUSE_AT_POINT)\n\t\t\tend\n\t\tend\n\t\tdiedConnection:Disconnect()\n\t\tactive[npc] = nil\n\tend)\nend\n\nCollectionService:GetInstanceAddedSignal(TAG):Connect(patrol)\nCollectionService:GetInstanceRemovedSignal(TAG):Connect(function(npc)\n\tactive[npc] = nil\nend)\nfor _, npc in ipairs(CollectionService:GetTagged(TAG)) do\n\tpatrol(npc)\nend\n","destructive":false,"id":"a2","requires_approval":true}],"verification":[{"check":"tree:Workspace.GodmodePatrolPoints","ok":true,"detail":"5 instance(s), property encoding valid"},{"check":"structure:ServerScriptService.GodmodeNPCPatrol","ok":true,"detail":"balanced blocks/brackets, lexically valid"},{"check":"lint:ServerScriptService.GodmodeNPCPatrol","ok":true,"detail":"no findings"}],"warnings":["Offline mode: this is the default version of this build/script. Edit it after applying, or enable the optional GODMODE server (/server on) for custom sizes, counts and colors."],"autonomy":3,"applied":false}]],
