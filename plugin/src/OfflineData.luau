esolveAnimationId()\nif animationId == nil then\n\twarn(\"[GODMODE] No animation id for \" .. SEQUENCE_NAME .. \": publish it and set ANIMATION_ID.\")\nelse\n\tanimation = Instance.new(\"Animation\")\n\tanimation.AnimationId = animationId\n\ttrack = animator:LoadAnimation(animation)\n\ttrack.Priority = Enum.AnimationPriority.Idle\n\ttrack.Looped = LOOPED\n\n\tContextActionService:BindAction(ACTION_NAME, function(_, inputState)\n\t\tif inputState ~= Enum.UserInputState.Begin or track == nil then\n\t\t\treturn Enum.ContextActionResult.Pass\n\t\tend\n\t\tif track.IsPlaying then\n\t\t\ttrack:Stop(FADE_TIME)\n\t\telse\n\t\t\ttrack:Play(FADE_TIME)\n\t\tend\n\t\treturn Enum.ContextActionResult.Sink\n\tend, true, TOGGLE_KEY)\n\n\ttable.insert(connections, humanoid.Died:Connect(cleanup))\n\ttable.insert(connections, script.Destroying:Connect(cleanup))\nend\n","destructive":false,"id":"a2","requires_approval":true}],"verification":[{"check":"animation:GodmodeIdle","ok":true,"detail":"3 keyframes, joint limits respected, hierarchy consistent, loop closed"},{"check":"structure:StarterPlayer.StarterCharacterScripts.PlayGodmodeIdle","ok":true,"detail":"balanced blocks/brackets, lexically valid"},{"check":"lint:StarterPlayer.StarterCharacterScripts.PlayGodmodeIdle","ok":true,"detail":"no findings"}],"warnings":["Offline mode: this is the default version of this build/script. Edit it after applying, or enable the optional GODMODE server (/server on) for custom sizes, counts and colors."],"autonomy":3,"applied":false}]],
