		json = [[{"ok":true,"reply_markdown":"**Source:** `tool:datastore` - a deterministic template generator chosen by the keyword router (confidence 1.00); this is not neural-model output. Verification: 2/2 checks passed.\n\nA DataStore save system for `Coins`:\n\n- `UpdateAsync` only (no blind `SetAsync`), with a **session lock** (JobId + timestamp, expires after 30 min) so two servers never overwrite each other.\n- Every call is wrapped in `pcall` with exponential-backoff retries.\n- Autosave every 120 s, save + unlock on `PlayerRemoving`, and `BindToClose` waits (max 25 s) for all saves.\n- Values are mirrored into `leaderstats` IntValues; schema-versioned and sanitized on load.\n\n**Proposed only - nothing has been changed in Studio.** 1 action(s) await your approval in the plugin:\n- `a1` create_script: DataStore save system","source":"offline:tool:datastore","intent":{"name":"datastore","confidence":1.0,"router":"keyword-regex","params":{}},"actions":[{"type":"create_script","description":"DataStore save system","parent_path":"ServerScriptService","name":"PlayerData","class":"Script","source":"-- Generated by GODMODE tool:datastore (deterministic template, verified by godmode.luau; not neural-model output)\n-- Session-locked player data with retries, UpdateAsync and BindToClose.\n-- Requires Game Settings > Security > Enable Studio Access to API Services (for Studio testing).\nlocal Players = game:GetService(\"Players\")\nlocal DataStoreService = game:GetService(\"DataStoreService\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal STORE_NAME = \"PlayerData_v1\"\nlocal KEY_PREFIX = \"player_\"\nlocal SCHEMA_VERSION = 1\nlocal MAX_RETRIES = 5\nlocal LOCK_EXPIRE_SECONDS = 1800\nlocal AUTOSAVE_INTERVAL = 120\nlocal DEFAULTS = {\n\tCoins = 0,\n}\n\nlocal store = DataStoreService:GetDataStore(STORE_NAME)\nlocal profiles = {}\nlocal saving = {}\n\nlocal function newProfile()\n\tlocal data = { version = SCHEMA_VERSION, stats = {} }\n\tfor name, value in pairs(DEFAULTS) do\n\t\tdata.stats[name] = value\n\tend\n\treturn data\nend\n\nlocal function retry(label: string, callback: () -> any): (boolean, any)\n\tlocal lastError = nil\n\tfor attempt = 1, MAX_RETRIES do\n\t\tlocal ok, result = pcall(callback)\n\t\tif ok then\n\t\t\treturn true, result\n\t\tend\n\t\tlastError = result\n\t\twarn((\"[Data] %s failed (attempt %d/%d): %s\"):format(label, attempt, MAX_RETRIES, tostring(result)))\n\t\ttask.wait(math.min(2 ^ attempt, 16))\n\tend\n\treturn false, lastError\nend\n\nlocal function sanitize(data: any)\n\tif typeof(data) ~= \"table\" then\n\t\treturn newProfile()\n\tend\n\tif typeof(data.stats) ~= \"table\" then\n\t\tdata.stats = {}\n\tend\n\tfor name, value in pairs(DEFAULTS) do\n\t\tif typeof(data.stats[name]) ~= \"number\" then\n\t\t\tdata.stats[name] = value\n\t\tend\n\tend\n\tdata.version = SCHEMA_VERSION\n\treturn data\nend\n\nlocal function loadProfile(player: Player)\n\tlocal key = KEY_PREFIX .. player.UserId\n\tfor _ = 1, 3 do\n\t\tlocal lockedElsewhere = false\n\t\tlocal ok, result = retry(\"load \" .. key, function()\n\t\t\treturn store:UpdateAsync(key, function(old)\n\t\t\t\tlocal data = sanitize(old)\n\t\t\t\tlocal lock = data.lock\n\t\t\t\tif typeof(lock) == \"table\" and lock.jobId ~= game.JobId and os.time() - (lock.time or 0) < LOCK_EXPIRE_SECONDS then\n\t\t\t\t\tlockedElsewhere = true\n\t\t\t\t\treturn nil\n\t\t\t\tend\n\t\t\t\tlockedElsewhere = false\n\t\t\t\tdata.lock = { jobId = game.JobId, time = os.time() }\n\t\t\t\treturn data\n\t\t\tend)\n\t\tend)\n\t\tif ok and not lockedElsewhere and result ~= nil then\n\t\t\treturn sanitize(result)\n\t\tend\n\t\ttask.wait(5)\n\tend\n\treturn nil\nend\n\nlocal function writeStatsToProfile(player: Player, profile)\n\tlocal leaderstats = player:FindFirstChild(\"leaderstats\")\n\tif leaderstats == nil then\n\t\treturn\n\tend\n\tfor name in pairs(DEFAULTS) do\n\t\tlocal valueObject = leaderstats:FindFirstChild(name)\n\t\tif valueObject and valueObject:IsA(\"IntValue\") then\n\t\t\tprofile.stats[name] = valueObject.Value\n\t\tend\n\tend\nend\n\nlocal function saveProfile(player: Player, release: boolean)\n\tlocal profile = profiles[player]\n\tif profile == nil or saving[player] then\n\t\treturn\n\tend\n\tsaving[player] = true\n\twriteStatsToProfile(player, profile)\n\tlocal key = KEY_PREFIX .. player.UserId\n\tretry(\"save \" .. key, function()\n\t\treturn store:UpdateAsync(key, function(old)\n\t\t\tlocal current = sanitize(old)\n\t\t\tlocal lock = current.lock\n\t\t\tif typeof(lock) == \"table\" and lock.jobId ~= game.JobId then\n\t\t\t\treturn nil\n\t\t\tend\n\t\t\tcurrent.stats = profile.stats\n\t\t\tif release then\n\t\t\t\tcurrent.lock = nil\n\t\t\telse\n\t\t\t\tcurrent.lock = { jobId = game.JobId, time = os.time() }\n\t\t\tend\n\t\t\treturn current\n\t\tend)\n\tend)\n\tsaving[player] = nil\nend\n\nlocal function onPlayerAdded(player: Player)\n\tlocal profile = loadProfile(player)\n\tif profile == nil then\n\t\tplayer:Kick(\"Your data could not be loaded safely. Please rejoin.\")\n\t\treturn\n\tend\n\tif not player:IsDescendantOf(Players) then\n\t\tprofiles[player] = profile\n\t\tsaveProfile(player, true)\n\t\tprofiles[player] = nil\n\t\treturn\n\tend\n\tprofiles[player] = profile\n\tlocal folder = player:FindFirstChild(\"leaderstats\")\n\tif folder == nil then\n\t\tfolder = Instance.new(\"Folder\")\n\t\tfolder.Name = \"leaderstats\"\n\t\tfolder.Parent = player\n\tend\n\tfor name, value in pairs(profile.stats) do\n\t\tlocal valueObject = folder:FindFirstChild(name)\n\t\tif valueObject == nil then\n\t\t\tvalueObject = Instance.new(\"IntValue\")\n\t\t\tvalueObject.Name = name\n\t\t\tvalueObject.Parent = folder\n\t\tend\n\t\tvalueObject.Value = value\n\tend\nend\n\nlocal function onPlayerRemoving(player: Player)\n\tsaveProfile(player, true)\n\tprofiles[player] = nil\nend\n\nPlayers.PlayerAdded:Connect(onPlayerAdded)\nPlayers.PlayerRemoving:Connect(onPlayerRemoving)\nfor _, player in ipairs(Players:GetPlayers()) do\n\ttask.spawn(onPlayerAdded, player)\nend\n\ntask.spawn(function()\n\twhile true do\n\t\ttask.wait(AUTOSAVE_INTERVAL)\n\t\tfor player in pairs(profiles) do\n\t\t\ttask.spawn(saveProfile, player, false)\n\t\tend\n\tend\nend)\n\ngame:BindToClose(function()\n\tlocal pending = 0\n\tfor player in pairs(profiles) do\n\t\tpending += 1\n\t\ttask.spawn(function()\n\t\t\tsaveProfile(player, true)\n\t\t\tpending -= 1\n\t\tend)\n\tend\n\tlocal started = os.clock()\n\twhile pending > 0 and os.clock() - started < 25 do\n\t\ttask.wait(0.1)\n\tend\n\tif RunService:IsStudio() then\n\t\ttask.wait(1)\n\tend\nend)\n","destructive":false,"id":"a1","requires_approval":true}],"verification":[{"check":"structure:ServerScriptService.PlayerData","ok":true,"detail":"balanced blocks/brackets, lexically valid"},{"check":"lint:ServerScriptService.PlayerData","ok":true,"detail":"no findings"}],"warnings":["To test in Studio enable Game Settings > Security > 'Enable Studio Access to API Services'.","Offline mode: this is the default version of this build/script. Edit it after applying, or enable the optional GODMODE server (/server on) for custom sizes, counts and colors."],"autonomy":3,"applied":false}]],
